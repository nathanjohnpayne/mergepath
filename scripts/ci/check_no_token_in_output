#!/usr/bin/env bash
# check_no_token_in_output
#
# Part A of #996 — the policy and the mechanism behind #951 / #993.
#
# PART A ONLY. The RECOGNIZER that decides "is this line an output command,
# and does this reference reach it" is an enumeration of shell spellings,
# and five direct-form spellings are known to escape it — enumerated with
# reproductions under "What this check does NOT catch" below. Rebuilding it
# against an execution oracle instead of an enumeration is #1015. Read that
# section before relying on this check for anything.
#
# #951 found a live PAT printed in cleartext by a checker's own failure
# message. #993 fixed the three sites it could find by grepping `scripts/`
# for five variable names and executing every checker that matched under a
# sentinel environment. That is a point-in-time measurement: nothing
# mechanically stops the next checker from reintroducing the shape. This
# check is the mechanism.
#
# THE RULE
#
#   Under scripts/** and tests/**, a shell source line may not interpolate
#   the VALUE of a known credential variable into an output command.
#
# ── What "known credential variable" means (design question 1) ───────────
#
# A CLOSED, EXPLICIT NAME LIST (TOKEN_NAMES below) — not a heuristic over
# names matching TOKEN / PAT / SECRET / KEY.
#
# The list loses recall: a credential reached under some other name is
# invisible to it. That is the deliberate trade. This check runs inside
# repo_lint, which publishes the REQUIRED `lint` context, and repo_lint is
# propagated to every consumer repo — so one false positive reds a required
# check across the fleet with no break-glass. A gate that is right about a
# smaller set beats one that is broadly right and occasionally wrong.
#
# The heuristic is also wrong on this tree, not just in principle. A
# `*TOKEN*` name match fires on `SUMMARY_ACK_TOKEN` / `ACK_TOKEN` (the
# mergepath-summary-ack marker), `MERGEPATH_EXPECT_READ_GH_TOKEN` and
# `STEP_NO_TOKEN` (flags), and `BOOTSTRAP_SKIP_AUTHOR_TOKEN` (a switch) —
# none of which hold credential material. Every one would need an
# allow-list entry, and the allow-list is then the thing reviewers have to
# get right, one repo at a time.
#
# Extending the list is a one-line edit here, in mergepath, which
# propagates to every consumer with the rest of the scripts/ci kit.
#
# ── How legitimate emitters are exempted (design question 2) ─────────────
#
# An INLINE PRAGMA, visible at the site, never a path allow-list:
#
#   printf 'export OP_PREFLIGHT_REVIEWER_PAT=%q\n' "$OP_PREFLIGHT_REVIEWER_PAT"  # TOKEN_OUTPUT_EXEMPT: <reason>
#
# The reason is mandatory — a bare `TOKEN_OUTPUT_EXEMPT:` with nothing
# after it still fails, the same hardening `NO_BARE_GH_WRITE_EXEMPT` got in
# #466. `scripts/op-preflight.sh` is the canonical legitimate emitter:
# writing those values to its cache IS its contract.
#
# The marker counts only inside a real, UNQUOTED shell COMMENT. A command
# that carries the same text as quoted DATA still runs and still writes the
# value, so a fixture that merely mentions the marker cannot silence the
# gate on a live emitter.
#
# The pragma is a REVIEW MARKER, not a security boundary. Anyone editing
# the file can silence this check — by adding the pragma, by renaming the
# variable, by any of the indirections listed below. What the marker buys
# is that every deliberate emission is greppable and carries a written
# reason, so the decision shows up in review instead of nowhere.
#
# Two forms are legal without any pragma because they emit a description
# rather than the value — they are the #993 remediation, and the check is
# built so that adopting it never trips the gate:
#
#   ${VAR}   flagged        ${#VAR}     length only, legal
#   ${VAR:-} flagged        ${VAR:+set} constant alternate, legal
#
# So is passing a token through a REDACTOR: a function is treated as an
# output command only when its body writes one of its own positional
# parameters VERBATIM through echo/printf (`fail() { echo "FAIL: $*"; }`).
# A redactor derives a length or a class and prints that, so by
# construction it is not such a function and `$(describe_secret "$PAT")`
# stays legal. "Verbatim" reads the two carve-outs above at the positional
# too, since a helper is entitled to use the forms the check documents:
# `${1:+set}` is a constant alternate and `${#1}` a length, so
# `key_state() { printf %s "${1:+set}"; }` is a redactor, while
# `${1:+$1}` carries its own expansion and is not.
#
# ── What this check does NOT catch (design question 3) ───────────────────
#
# INDIRECTION IS NOT COVERED. This is a single-hop source-text scanner over
# one line at a time. It has no dataflow, no cross-file analysis, and no
# knowledge of what a variable holds at runtime. It does not catch:
#
#   * A token copied into a differently-named variable and then printed
#     (`pat=$OP_PREFLIGHT_AUTHOR_PAT; echo "$pat"`), or reached through a
#     function return, a file read, or `$(op read ...)`.
#   * A token written to a log or temp file that some later line prints
#     (`cat "$LOG"`) — the exact shape of the check_resolve_pr_threads and
#     check_phase_4b_classifier leaks that #993 fixed. It DOES catch the
#     line that puts the value into the log, when that line names the
#     variable; it cannot connect that line to the `cat` that prints it.
#   * `set -x` traces, `env` dumps, core dumps, or anything the shell emits
#     on its own.
#   * A command that prints something the token names but does not
#     interpolate: `cat "$LOGFILE"`, `grep "$PAT" file`, an editor, a
#     pager. Only the commands listed under "What counts as output" above
#     are output commands.
#   * Any file this check does not scan: non-shell files, and everything
#     outside scripts/** and tests/**.
#
# DIRECT FORMS THAT ALSO ESCAPE — five of them, and they are NOT the
# indirection limit above. No rename, no capture into another name, no
# file, no `set -x`: each is a direct interpolation of a listed credential
# name into an output command by this header's own definition, and the
# check reports the line as clean. Measured, not inferred — a probe fixture
# carrying all five plus a plain `echo "$GH_TOKEN"` returns exactly ONE
# finding, the plain `echo`. The probe used an unassigned variable and no
# credential material of any kind.
#
#   * A nested word inside a parameter-expansion OPERATOR, when the outer
#     name is not itself credential-bearing. `${VAR:-$FALLBACK}` is
#     ordinary shell, and the fallback word is never inspected:
#         echo "${UNSET_VALUE:-$GH_TOKEN}"
#   * An emitter inside a command substitution whose stream is redirected
#     away from the capture. `emitted()` treats any enclosing `$(...)` as a
#     store, but `>&2` means the capture never takes the value and it
#     reaches the terminal:
#         _v=$(printf '%s' "$GH_TOKEN" >&2)
#   * A wrapper carrying options or assignments ahead of the command word.
#     PASSTHRU lists bare `env`, so the option consumes the command
#     position and the emitter behind it is never seen:
#         env -i echo "$GH_TOKEN"
#   * A LEADING redirection ahead of the command word, which the walk reads
#     as the command itself:
#         2>/dev/null echo "$GH_TOKEN"
#   * The second and later bodies of a multi-here-doc command: only the
#     FIRST `<<` opener on a line is tracked (#1014):
#         cat <<FIRST <<SECOND
#     No occurrence exists in this tree or in any of the nine consumers.
#     Not fixed here: `hd_term` is a single scalar shared by note_heredoc
#     and scan_lines, and the join_continuations pre-pass keeps its own copy
#     of the same state, so the fix is a pending-QUEUE rewrite across two
#     passes rather than a local patch.
#
# All five are tracked on #1015, which replaces the enumeration with a
# differential harness whose oracle is `bash` execution plus sentinel
# detection on both stdout and stderr. They are its first failing cases.
#
# One limit inside the LOGICAL-line reconstruction, since the unit of
# analysis is a logical line rather than a physical one (see below): quote
# state is not carried from one logical line to the next. A backslash at
# the end of a line inside a single-quoted span that OPENED on an earlier
# logical line reads as a continuation, so those two lines are joined when
# the shell would not join them. It is the same one-line-at-a-time model
# the rest of the scan works under, and it can only mis-join adjacent
# lines, never reach across a file.
#
# Stated plainly because #993's lesson was that an unstated limit reads as
# a guarantee: NONE of the three leaks #993 fixed would have been caught by
# this gate at their original sites, because all three reached the token
# under another name or through a file.
#
# And stated just as plainly, because landing an overstated guarantee is
# the failure this check exists to prevent: "the direct form cannot come
# back silently" is NOT a property of this code. Five direct spellings
# escape it, listed and reproduced above. What holds is bounded by the
# enumeration — the spellings this check DOES model cannot come back
# silently, each pinned by a self-test case in both directions: a plain
# `echo`/`printf`, a message helper in either definition form, a backslash
# continuation between the emitter and its argument, a path-qualified
# emitter (`/bin/echo`), a reserved word in front of the emitter, an
# interpolating here-doc body, a `tee` here-doc, and a here-string
# (`cat <<< "$PAT"`). Closing the general claim needs an oracle rather than
# a longer list, which is #1015.
#
# ── Known defect, tracked on #1015 ───────────────────────────────────────
#
# `scan_root` installs two `trap ... RETURN` handlers and the second
# REPLACES the first, so the file-list temp file is never removed: one
# `token-output-list.*` survives every `--scan`. A single quote in `TMPDIR`
# would also inject into the trap string. Recorded as an acceptance
# criterion on #1015 — one fixed cleanup action per function plus a `--`
# guard, with a case pinning that a single `--scan` leaves nothing behind —
# rather than patched here, because it sits in the same bookkeeping that
# produced this scanner's last three regressions.
#
# ── What counts as "output" ──────────────────────────────────────────────
#
#   * `echo` / `printf` at a command position. Command words are matched by
#     BASENAME, so `/bin/echo` is the same emitter — the rule
#     scripts/hooks/gh-pr-guard.sh adopted in #611 r10.
#     A shell reserved word is not the command — the command follows it —
#     so `if echo "$PAT"; then`, `while printf ...` and `! echo ...` are the
#     same emitter. `printf -v NAME` is NOT output: bash assigns to a
#     variable instead of writing to a stream.
#   * An in-file message helper: a function whose body writes one of its
#     own positional parameters verbatim through echo/printf. Both
#     definition forms count — `name () { ...; }` and `function name
#     { ...; }`.
#   * The body of an INTERPOLATING here-doc (unquoted delimiter) opened by
#     `cat`, `tee` or an emitter — the shell expands those lines at write
#     time, and `tee` puts them on stdout as well as in the file.
#   * The word of a here-STRING given to one of those same commands:
#     `cat <<< "$GH_TOKEN"` reaches a stream exactly as `echo` does. The
#     command is the one heading the here-string's OWN segment, so
#     `true; cat <<< "$PAT"` counts. A here-string handed to anything else
#     (`grep -q x <<< "$V"`) is not output and is not flagged, and a
#     captured one (`v=$(cat <<< "$PAT")`) stores rather than emits.
#
# A value captured by a command substitution is NOT output: in
# `_v=$(printf '%s' "$GH_TOKEN")` the value goes into a variable, not onto
# a stream. A reference counts only when the segment at EVERY enclosing
# level is an output command, so `echo "$(printf '%s' "$GH_TOKEN")"` is
# flagged while `echo "$(GH_TOKEN="$PAT" gh api user)"` — the documented
# read-path idiom, where gh's output is echoed and the token is not — is
# not.
#
# Whole-line comments are skipped: they do not execute, and documentation
# and remediation prose is full of deliberate examples. A trailing
# backslash inside a comment does NOT continue it, so a commented-out
# example cannot swallow the live line beneath it.
#
# ── The unit of analysis is a LOGICAL line ───────────────────────────────
#
# Physical lines are joined across backslash continuations before anything
# else runs, because otherwise the emitter and its argument sit on
# different records and a `printf ... \` + newline + `"$PAT"` re-wrap
# silently leaves the check's own covered class. A run of backslashes only
# continues when it is odd and live — an even run escapes itself, a
# backslash inside a single-quoted span is literal, and one inside a
# comment is dropped with the comment. An exemption pragma anywhere on the
# logical line exempts the whole command, and a finding is reported at the
# FIRST physical line of the logical line.
#
# Usage:
#   check_no_token_in_output              # self-test, then scan this repo
#   check_no_token_in_output --self-test  # fixture suite only
#   check_no_token_in_output --scan [DIR] # scan only (default: this repo)

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# ── The closed credential-variable list ──────────────────────────────────
# Every name here DENOTES credential material that this fleet either handles
# at runtime or asserts about in its own secret-hygiene fixtures. Names that
# merely *mention* a credential (an Actions secret name in a string, a
# "which token should I use" flag) are deliberately absent — see the header.
#
# The invariant reads "denotes credential material", not "is live here",
# because the first is a property of the NAME and the second is a property
# of today's integrations. An earlier round of #1012 declined
# AZURE_CLIENT_SECRET on the "not live here" reading and was wrong on its
# own terms: tests/test_phase_4b_automation.sh drives the reviewer-adapter
# env allow-list with AZURE_CLIENT_SECRET set, so the fleet does assert
# about it, and a script printing it would have walked past this gate.
#
# Four names from that same fixture are still absent, and for a reason that
# is not "we forgot": GOOGLE_APPLICATION_CREDENTIALS, OP_PREFLIGHT_ADC_TMPFILE
# and OP_PREFLIGHT_FIREBASE_SA_TMPFILE are FILE PATHS and SSH_AUTH_SOCK is a
# socket path — printing one leaks no secret, and op-preflight.sh prints
# GOOGLE_APPLICATION_CREDENTIALS deliberately and without a pragma, so
# admitting it would red a required check over a legitimate line.
# AWS_ACCESS_KEY_ID is a public identifier; the paired secret
# (AWS_SECRET_ACCESS_KEY) appears nowhere in this fleet, in a fixture or
# otherwise, so adding it would break the invariant above in the other
# direction.
TOKEN_NAMES="
GH_TOKEN
GITHUB_TOKEN
GH_ENTERPRISE_TOKEN
GITHUB_ENTERPRISE_TOKEN
GH_RESOLVED_TOKEN
OP_PREFLIGHT_AUTHOR_PAT
OP_PREFLIGHT_REVIEWER_PAT
OP_SERVICE_ACCOUNT_TOKEN
AUTHOR_MERGE_TOKEN
REVIEWER_ASSIGNMENT_TOKEN
BRANCH_PROTECTION_AUDIT_TOKEN
LABEL_REMOVAL_TOKEN
CF_API_TOKEN
CLOUDFLARE_API_TOKEN
FIREBASE_TOKEN
AZURE_CLIENT_SECRET
ANTHROPIC_AUTH_TOKEN
CLAUDE_CODE_OAUTH_TOKEN
OPENAI_API_KEY
CODEX_API_KEY
ANTHROPIC_API_KEY
"

# Base output commands. In-file message helpers are discovered per file.
EMITTER_COMMANDS="echo printf"

# ─────────────────────────────────────────────────────────────────────────
# The scanner.
#
# Pure awk so this runs before any tool install, on bash 3.2, with no
# single-quote characters in the program (SQ is built with sprintf) so the
# whole thing can live inside a single-quoted shell string.
# ─────────────────────────────────────────────────────────────────────────
read -r -d '' SCANNER <<'AWK_PROGRAM' || true
BEGIN {
  n = split(TOKENS, t, " ")
  for (i = 1; i <= n; i++) if (t[i] != "") TOK[t[i]] = 1
  n = split(EMITTERS, e, " ")
  for (i = 1; i <= n; i++) if (e[i] != "") EMITBASE[e[i]] = 1
  # Words that keep the NEXT word in command position.
  n = split("env command builtin exec sudo time nohup stdbuf", p, " ")
  for (i = 1; i <= n; i++) PASSTHRU[p[i]] = 1
  # Shell RESERVED WORDS are not the command — the command follows them.
  # `if echo "$GH_TOKEN"; then` runs the same emitter as `echo "$GH_TOKEN"`,
  # so a reserved word must neither consume the command position nor be
  # mistaken for the command itself.
  n = split("if then elif else while until do done ! case esac in select coproc function", p, " ")
  for (i = 1; i <= n; i++) RESERVED[p[i]] = 1
  SQ = sprintf("%c", 39)
  found = 0
}

FNR == 1 {
  if (NR > 1) process()
  split("", LINES); split("", LNO); NLINES = 0; split("", EMITFN)
  CURFILE = FILENAME
}
{ LINES[++NLINES] = $0; LNO[NLINES] = FNR }
END { if (NR > 0) process(); exit found ? 1 : 0 }

function process() {
  join_continuations()
  discover_helpers()
  scan_lines()
}

# ── Pass 0: physical lines → LOGICAL lines ───────────────────────────────
# `printf %s \` + newline + `"$GH_TOKEN"` is ONE command to the shell but
# two records to awk, so the emitter and the reference land on different
# records and the reference is invisible. That is not the indirection limit
# below — no rename, no function return, no file — it is the covered direct
# form, lost to a purely cosmetic re-wrap. Splitting a long argument list
# across a continuation is this tree's dominant house style, so the failure
# mode is a contributor formatting a long line, not an attacker.
#
# Every finding is attributed to the FIRST physical line of its logical
# line (LNO), so a reported line number still points at the emitter.
function join_continuations(   i, cur, lno, term, quoted, trimmed, J, JL, jn) {
  jn = 0; cur = ""; lno = 0; term = ""; quoted = 0
  for (i = 1; i <= NLINES; i++) {
    trimmed = LINES[i]
    sub(/^[[:space:]]+/, "", trimmed); sub(/[[:space:]]+$/, "", trimmed)

    # A QUOTED here-doc delimiter is matched by the outer shell against a
    # PHYSICAL line, so a continuation inside such a body must never
    # swallow it. Measured on bash 5 and bash 3.2: with `cat <<"EOF"` a
    # body line ending in a backslash still lets the next `EOF` terminate,
    # while with `cat <<EOF` it does not (the backslash-newline is removed
    # first and the delimiter is never seen).
    if (term != "" && quoted && trimmed == term) {
      if (cur != "") { J[++jn] = cur; JL[jn] = lno; cur = "" }
      J[++jn] = LINES[i]; JL[jn] = LNO[i]
      term = ""; quoted = 0
      continue
    }

    # The shell removes the backslash and the newline, joining with NO
    # separator — `ec\` + `ho x` really is `echo x`.
    if (cur == "") { cur = LINES[i]; lno = LNO[i] } else { cur = cur LINES[i] }
    if (i < NLINES && continues(cur, term, quoted)) { sub(/\\$/, "", cur); continue }

    J[++jn] = cur; JL[jn] = lno
    if (term != "") {
      trimmed = cur
      sub(/^[[:space:]]+/, "", trimmed); sub(/[[:space:]]+$/, "", trimmed)
      if (trimmed == term) { term = ""; quoted = 0 }
    } else if (heredoc_open(cur)) {
      term = HD_NEW_TERM; quoted = HD_NEW_QUOTED
    }
    cur = ""
  }
  split("", LINES); split("", LNO)
  for (i = 1; i <= jn; i++) { LINES[i] = J[i]; LNO[i] = JL[i] }
  NLINES = jn
}

# Is the pending text still open on a live line continuation?
#
# Inside an UNQUOTED here-doc body the shell has already removed quoting
# and comments, so only the backslash count decides. Everywhere else —
# ordinary source, and a quoted here-doc body, which is source for the stub
# it writes — quoting and comments decide too.
function continues(s, term, quoted) {
  if (term != "" && !quoted) return ends_odd_backslash(s)
  return ends_continuation(s)
}

function ends_odd_backslash(s,   n) {
  n = 0
  while (s ~ /\\$/) { sub(/\\$/, "", s); n++ }
  return n % 2
}

# A trailing backslash continues the line only where it is LIVE: an even
# run escapes itself (`echo x \\` prints a backslash and ends the command),
# a backslash inside a single-quoted span is literal, and one after an
# unquoted `#` is inside a comment, which the shell drops at the newline.
function ends_continuation(s,   i, n, c, q, esc, prev) {
  n = length(s); q = ""; esc = 0
  for (i = 1; i <= n; i++) {
    c = substr(s, i, 1)
    if (q == SQ) { if (c == SQ) q = ""; continue }
    if (esc) { esc = 0; continue }
    if (c == "\\") { if (i == n) return 1; esc = 1; continue }
    if (q == "\"") { if (c == "\"") q = ""; continue }
    if (c == SQ)   { q = SQ; continue }
    if (c == "\"") { q = "\""; continue }
    if (c == "#") {
      prev = (i == 1) ? " " : substr(s, i - 1, 1)
      if (prev ~ /[[:space:];&|(]/) return 0
    }
  }
  return 0
}

# ── Pass 1: in-file message helpers ──────────────────────────────────────
# A function is an output command when its body writes one of its own
# positional parameters VERBATIM through echo/printf. A redactor prints a
# derived value (a length, a class) and so is deliberately NOT matched.
function discover_helpers(   i, fn, name, trimmed) {
  fn = ""
  for (i = 1; i <= NLINES; i++) {
    # Both definition forms bash documents: `name () { ...; }` and the
    # parenthesis-free `function name { ...; }` (bash `help function`).
    if (LINES[i] ~ /^[[:space:]]*(function[[:space:]]+)?[A-Za-z_][A-Za-z0-9_:.-]*[[:space:]]*\(\)/ ||
        LINES[i] ~ /^[[:space:]]*function[[:space:]]+[A-Za-z_][A-Za-z0-9_:.-]*[[:space:]]*(\{|$)/) {
      name = LINES[i]
      sub(/^[[:space:]]*(function[[:space:]]+)?/, "", name)
      sub(/[[:space:]]*(\(\)|\{).*$/, "", name)
      sub(/[[:space:]]+$/, "", name)
      if (writes_own_args(LINES[i])) EMITFN[name] = 1
      # A one-line definition (`fail() { echo "FAIL: $*" >&2; }` — the
      # dominant shape in this tree) closes on its own line, so the body
      # scope must end here and not swallow following top-level code.
      trimmed = LINES[i]
      sub(/[[:space:]]+$/, "", trimmed)
      fn = (trimmed ~ /\}$/) ? "" : name
      continue
    }
    if (LINES[i] ~ /^[[:space:]]*\}/) { fn = ""; continue }
    if (fn == "") continue
    if (writes_own_args(LINES[i])) EMITFN[fn] = 1
  }
}

# Does this line write one of the enclosing function own positional
# parameters VERBATIM through echo/printf? A redactor prints a DERIVED
# value (${#1}, a fixed classification) and so does not match — which is
# what keeps `$(describe_secret "$PAT")` legal.
#
# The positional reference must sit in the emitter own ARGUMENTS, not
# merely somewhere on the same line: `key_state() { [ -n "$1" ] && printf
# SET || printf unset; }` tests $1 and prints a constant, and reading the
# whole line would misclassify that redactor as an emitter.
function writes_own_args(line,   s, seg) {
  s = line
  while (match(s, /(^|[;&|({]|&&|\|\|)[[:space:]]*(echo|printf)[[:space:]]/)) {
    s = substr(s, RSTART + RLENGTH)
    seg = s
    sub(/[;|&].*$/, "", seg)
    if (positional_verbatim(seg)) return 1
  }
  return 0
}

# Does this emitter argument list carry a positional parameter as its VALUE?
#
# `${1:+set}` and `${1+set}` expand to the CONSTANT alternate — presence, not
# the value — which is the very form this check documents as the legal way to
# report a credential (`${VAR:+set}`). A helper built from it is therefore a
# REDACTOR, and reading `$1` out of it classified `key_state() { printf %s
# "${1:+set}"; }` as an emitter, so every `key_state "$GH_TOKEN"` call site
# false-positived. Reported by Codex on #1012 and reproduced on a fixture.
# `${#1}` is a length and was already out, since `#` is not a positional.
# An alternate carrying its own expansion (`${1:+$1}`) is not constant, the
# same qualification expansion() applies to a named credential.
function positional_verbatim(seg,   i, n, c, nxt, inner, braces, j, name, rest) {
  n = length(seg)
  for (i = 1; i <= n; i++) {
    c = substr(seg, i, 1)
    if (c != "$") continue
    nxt = substr(seg, i + 1, 1)
    if (nxt == "{") {
      braces = 1; inner = ""
      for (j = i + 2; j <= n; j++) {
        c = substr(seg, j, 1)
        if (c == "{") braces++
        else if (c == "}") { braces--; if (braces == 0) break }
        inner = inner c
      }
      # Unterminated: fall back to the pre-#1012 verdict rather than
      # inventing one, so malformed text cannot quietly widen what passes.
      if (braces != 0) return (substr(seg, i + 2, 1) ~ /[0-9@*]/)
      name = inner
      sub(/[^0-9@*].*$/, "", name)
      if (name == "") { i = j; continue }        # not a positional at all
      rest = substr(inner, length(name) + 1)
      if (rest ~ /^:?\+/ && rest !~ /\$/) { i = j; continue }   # constant
      return 1
    }
    if (nxt ~ /[@*1-9]/) return 1
  }
  return 0
}

function is_emitter(w) { return (w in EMITBASE) || (w in EMITFN) }

# Command words are matched by BASENAME, the same rule scripts/hooks/
# gh-pr-guard.sh adopted in #611 r10: `/bin/echo "$GH_TOKEN"` runs the same
# emitter as `echo "$GH_TOKEN"`, and a path prefix is not indirection — no
# rename, no capture, no file.
function basename(w) { sub(/^.*\//, "", w); return w }

# ── Pass 2: the scan ─────────────────────────────────────────────────────
function scan_lines(   i, line, hit, trimmed, href) {
  hd_term = ""; hd_scan = 0
  for (i = 1; i <= NLINES; i++) {
    line = LINES[i]

    if (hd_term != "") {
      trimmed = line
      sub(/^[[:space:]]+/, "", trimmed); sub(/[[:space:]]+$/, "", trimmed)
      if (trimmed == hd_term) { hd_term = ""; hd_scan = 0; continue }
      href = hd_scan ? heredoc_ref(line) : ""
      if (!exempt(line) && href != "")
        report(i, href, line, "here-doc body")
      # A here-doc body is also shell SOURCE when it is written out as a
      # script (the check_resolve_pr_threads stub shape, #993), so it gets
      # the ordinary line scan too, quoted delimiter or not.
      else if (!exempt(line) && !comment(line) && (hit = walk(line)) != "")
        report(i, hit, line, "output command")
      note_heredoc(line)
      continue
    }

    if (!comment(line) && !exempt(line) && (hit = walk(line)) != "")
      report(i, hit, line, "output command")
    note_heredoc(line)
  }
}

function comment(line) { return line ~ /^[[:space:]]*#/ }

# The pragma exempts only when it sits in a real, UNQUOTED shell COMMENT.
# A command carrying the marker as quoted DATA still executes and still
# emits — `printf "%s %s\n" "$GH_TOKEN" SQ-TOKEN_OUTPUT_EXEMPT: text-SQ`
# prints the value — so matching the marker anywhere on the line let a
# fixture that merely mentions it silence the gate on a live emitter.
# Reported by Codex on #1012 and reproduced before this rule was written.
function exempt(line,   c) {
  c = comment_at(line)
  if (c == 0) return 0
  return substr(line, c) ~ /TOKEN_OUTPUT_EXEMPT:[[:space:]]*[^[:space:]]/
}

# Index of the character that opens an unquoted `#` comment, or 0 when the
# line has none. Same rule ends_continuation() applies mid-walk: a `#` opens
# a comment only where it is unquoted, unescaped, and starts a word. The two
# walks are kept separate because they answer different questions — this one
# reports WHERE the comment begins, that one only needs to stop when it
# meets one.
function comment_at(s,   i, n, c, q, esc, prev) {
  n = length(s); q = ""; esc = 0
  for (i = 1; i <= n; i++) {
    c = substr(s, i, 1)
    if (q == SQ) { if (c == SQ) q = ""; continue }
    if (esc) { esc = 0; continue }
    if (c == "\\") { esc = 1; continue }
    if (q == "\"") { if (c == "\"") q = ""; continue }
    if (c == SQ)   { q = SQ; continue }
    if (c == "\"") { q = "\""; continue }
    if (c == "#") {
      prev = (i == 1) ? " " : substr(s, i - 1, 1)
      if (prev ~ /[[:space:];&|(]/) return i
    }
  }
  return 0
}

# `idx` indexes the LOGICAL line; the number printed is the first PHYSICAL
# line it was built from, so it points at the emitter and not at whichever
# continuation line the reference happened to be wrapped onto.
function report(idx, name, line, kind) {
  printf "%s:%d: %s interpolated into %s\n", CURFILE, LNO[idx], name, kind
  printf "      %s\n", line
  found = 1
}

# ── Here-doc bookkeeping ─────────────────────────────────────────────────
# Track EVERY here-doc so the body is not mistaken for ordinary source when
# deciding where the next one starts; scan the body as output only when the
# delimiter is UNQUOTED (the shell expands it) and the opener is cat or an
# emitter (the expansion goes to a stream or a file).
function note_heredoc(line,   w) {
  if (hd_term != "") return
  if (!heredoc_open(line)) return
  hd_term = HD_NEW_TERM
  w = first_command_word(line)
  hd_scan = (!HD_NEW_QUOTED && (w == "cat" || w == "tee" || is_emitter(w))) ? 1 : 0
}

# Parse a here-doc opener: sets HD_NEW_TERM / HD_NEW_QUOTED and returns 1
# when the line opens one. Shared by the continuation pre-pass and
# note_heredoc so both agree on exactly where a body begins and ends.
function heredoc_open(line,   rest, ch, term, p) {
  HD_NEW_TERM = ""; HD_NEW_QUOTED = 0
  if (line !~ "<<-?[[:space:]]*[" SQ "\\\\\"A-Za-z_]") return 0
  # A here-STRING is not a here-doc. Skipping the whole line when one is
  # present is conservative in the safe direction: it can only make the
  # check miss a body, never invent one.
  if (line ~ /<<</) return 0
  # Parse from the FIRST `<<` on the line — a greedy strip would take the
  # last, and `cmd <<A <<B` opens A first.
  p = index(line, "<<")
  rest = substr(line, p + 2)
  sub(/^-/, "", rest)
  sub(/^[[:space:]]+/, "", rest)
  ch = substr(rest, 1, 1)
  if (ch == SQ || ch == "\"" || ch == "\\") { HD_NEW_QUOTED = 1; sub(/^[\\"]|^./, "", rest) }
  term = rest
  sub(/[^A-Za-z0-9_].*$/, "", term)
  if (term == "") return 0
  HD_NEW_TERM = term
  return 1
}

# First command word of a line: leading assignments and pass-through
# wrappers are stepped over. Returns "" when the line does not start with a
# plain command (e.g. `x=$(cat <<EOF` — a CAPTURED here-doc, not output).
function first_command_word(line,   s, w) {
  s = line
  sub(/^[[:space:]]+/, "", s)
  while (s != "") {
    w = s
    sub(/[[:space:]].*$/, "", w)
    if (w == "") return ""
    if (w ~ /^[A-Za-z_][A-Za-z0-9_]*=/ || (w in PASSTHRU)) {
      sub(/^[^[:space:]]+[[:space:]]*/, "", s)
      continue
    }
    if (w !~ /^[.\/]*[A-Za-z_][A-Za-z0-9_.\/-]*$/) return ""
    return basename(w)
  }
  return ""
}

# An unprotected reference inside a here-doc body. Quotes are not special
# there; only a backslash escape protects a dollar sign.
function heredoc_ref(line,   i, c, n2, esc, j) {
  n2 = length(line); esc = 0
  for (i = 1; i <= n2; i++) {
    c = substr(line, i, 1)
    if (esc) { esc = 0; continue }
    if (c == "\\") { esc = 1; continue }
    if (c != "$") continue
    j = expansion(line, i)
    if (EXP_UNSAFE) return EXP_NAME
    i = j
  }
  return ""
}

# ── Here-strings ─────────────────────────────────────────────────────────
# `cat <<< "$GH_TOKEN"` puts the word on a stream exactly as
# `echo "$GH_TOKEN"` does, but the word sits after a redirection operator,
# so the ordinary walk reads it at argument position under a command it
# does not classify as an emitter. The here-doc parser deliberately skips
# any line carrying `<<<` (a here-string is not a here-doc), so the word is
# checked here instead — only when the command word is itself an output
# command, and by re-reading the word through the ordinary walk so the
# quoting, `${#VAR}` and `${VAR:+set}` rules stay identical.
#
# A CAPTURED here-string (`v=$(cat <<< "$PAT")`) has no command word at the
# top level, so first_command_word returns "" and it stays legal — the same
# capture-versus-emit rule the walk applies.
# ── The line walk ────────────────────────────────────────────────────────
# Tracks quote state, command-substitution depth, and whether the current
# segment at each depth is an output command.
function walk(line,   i, c, n2, depth, esc, w, hit, nxt, j) {
  n2 = length(line); depth = 0; esc = 0; w = ""; hit = ""
  q[0] = ""; emit[0] = 0; cmdpos[0] = 1; bt[0] = 0; pendv[0] = 0; cmdname[0] = ""
  for (i = 1; i <= n2; i++) {
    c = substr(line, i, 1)

    if (q[depth] == SQ) { if (c == SQ) q[depth] = ""; continue }
    if (esc) { esc = 0; continue }
    if (c == "\\") { esc = 1; continue }

    if (q[depth] == "\"") {
      if (c == "\"") { q[depth] = ""; continue }
      if (c == "$") {
        nxt = substr(line, i + 1, 1)
        if (nxt == "(") { push(++depth, 0); i++; continue }
        j = expansion(line, i)
        if (EXP_UNSAFE && emitted(depth)) hit = EXP_NAME
        i = j; continue
      }
      if (c == "`") { push(++depth, 1); continue }
      continue
    }

    if (c == SQ)   { flush_word(w, depth); w = ""; q[depth] = SQ; continue }
    if (c == "\"") { flush_word(w, depth); w = ""; q[depth] = "\""; continue }
    if (c == "$") {
      nxt = substr(line, i + 1, 1)
      if (nxt == "(") { flush_word(w, depth); w = ""; push(++depth, 0); i++; continue }
      j = expansion(line, i)
      if (EXP_UNSAFE && emitted(depth)) hit = EXP_NAME
      w = w "X"
      i = j; continue
    }
    if (c == "`") {
      flush_word(w, depth); w = ""
      if (bt[depth] && depth > 0) { depth--; continue }
      push(++depth, 1); continue
    }
    if (c == ")") { flush_word(w, depth); w = ""; if (depth > 0) depth--; continue }
    if (c == ";" || c == "|" || c == "&") { flush_word(w, depth); w = ""; cmdpos[depth] = 1; emit[depth] = 0; pendv[depth] = 0; cmdname[depth] = ""; continue }
    if (c == "(" || c == "{") { flush_word(w, depth); w = ""; cmdpos[depth] = 1; emit[depth] = 0; pendv[depth] = 0; cmdname[depth] = ""; continue }
    if (c == "}") { flush_word(w, depth); w = ""; continue }
    if (c == "#" && w == "") break
    if (c == " " || c == "\t") { flush_word(w, depth); w = ""; continue }
    # A here-STRING feeds its word to the segment command exactly as an
    # argument would, so `cat <<< "$PAT"` reaches a stream. Handled inside
    # the walk rather than by re-reading the tail of the line, so the
    # enclosing quote state still applies: a here-string written inside a
    # single-quoted fixture string is text, not a command.
    if (c == "<" && substr(line, i, 3) == "<<<") {
      flush_word(w, depth); w = ""
      if (cmdname[depth] == "cat" || cmdname[depth] == "tee") emit[depth] = 1
      i += 2; continue
    }
    if (c == "<" || c == ">") { flush_word(w, depth); w = ""; continue }
    w = w c
  }
  return hit
}

function push(d, backtick) { q[d] = ""; emit[d] = 0; cmdpos[d] = 1; bt[d] = backtick; pendv[d] = 0; cmdname[d] = "" }

# A reference at depth d reaches an uncaptured stream only when the segment
# at every enclosing level is an output command. `_v=$(printf "$T")` stores
# the value; `echo "$(printf "$T")"` re-emits it.
function emitted(d,   k) {
  for (k = 0; k <= d; k++) if (!emit[k]) return 0
  return 1
}

function flush_word(w, depth,   b) {
  if (w == "") return
  if (!cmdpos[depth]) {
    # `printf -v NAME ...` ASSIGNS to a shell variable instead of writing to
    # a stream (bash `help printf`), so the emitter classification made one
    # word ago is withdrawn. Only the first argument is inspected, which is
    # the only place the option is valid.
    if (pendv[depth]) { if (w == "-v") emit[depth] = 0; pendv[depth] = 0 }
    return
  }
  if (w ~ /^[A-Za-z_][A-Za-z0-9_]*=/) return   # assignment prefix
  if (w in PASSTHRU) return
  if (w in RESERVED) return                    # the command follows it
  b = basename(w)
  cmdname[depth] = b
  if (is_emitter(b)) { emit[depth] = 1; pendv[depth] = (b == "printf") ? 1 : 0 }
  cmdpos[depth] = 0
}

# Classify the expansion whose dollar sign is at position i. Sets
# EXP_UNSAFE / EXP_NAME; returns the index of the expansion last character.
function expansion(line, i,   nxt, j, braces, inner, name, rest, c, after) {
  EXP_UNSAFE = 0; EXP_NAME = ""
  nxt = substr(line, i + 1, 1)
  if (nxt == "{") {
    braces = 1; inner = ""
    for (j = i + 2; j <= length(line); j++) {
      c = substr(line, j, 1)
      if (c == "{") braces++
      else if (c == "}") { braces--; if (braces == 0) break }
      inner = inner c
    }
    if (braces != 0) return i                  # unterminated; leave it alone
    if (substr(inner, 1, 1) == "#") return j   # ${#VAR} — length only
    name = inner
    sub(/[^A-Za-z0-9_].*$/, "", name)
    if (!(name in TOK)) return j
    rest = substr(inner, length(name) + 1)
    # ${VAR:+word} / ${VAR+word} expand to a CONSTANT alternate — presence,
    # not value. An alternate carrying its own expansion is not constant.
    if (rest ~ /^:?\+/ && rest !~ /\$/) return j
    EXP_UNSAFE = 1; EXP_NAME = name
    return j
  }
  if (nxt ~ /[A-Za-z_]/) {
    name = substr(line, i + 1)
    sub(/[^A-Za-z0-9_].*$/, "", name)
    if (name in TOK) {
      after = substr(line, i + 1 + length(name), 1)
      if (after !~ /[A-Za-z0-9_]/) { EXP_UNSAFE = 1; EXP_NAME = name }
    }
    return i + length(name)
  }
  return i
}
AWK_PROGRAM

# ─────────────────────────────────────────────────────────────────────────
# File selection and scan driver.
# ─────────────────────────────────────────────────────────────────────────
# Emits a NUL-separated list of shell files. Returns 3 when file discovery
# itself fails: a `find` or `sort` that errors used to reach the caller as an
# EMPTY tree, and an empty tree reads as a clean scan — the classic vacuous
# gate. The pipeline status is read explicitly because a process
# substitution discards it.
collect_shell_files() {
  local root="$1" dir first interp raw
  local -a st
  raw="$(mktemp "${TMPDIR:-/tmp}/token-output-files.XXXXXX")"
  # shellcheck disable=SC2064  # expand $raw now, not when the trap fires
  trap "rm -f '$raw'" RETURN
  for dir in scripts tests; do
    [ -d "$root/$dir" ] || continue
    find "$root/$dir" -type f -print0 2>/dev/null | LC_ALL=C sort -z >"$raw"
    # One assignment: any command in between, including another
    # `${PIPESTATUS[...]}` read, replaces the array.
    st=("${PIPESTATUS[@]}")
    if [ "${st[0]}" -ne 0 ] || [ "${st[1]}" -ne 0 ]; then
      echo "check_no_token_in_output: file discovery failed under $root/$dir (find=${st[0]} sort=${st[1]})" >&2
      return 3
    fi
    while IFS= read -r -d '' file; do
      case "$file" in
        */node_modules/*|*/.git/*) continue ;;
        *.sh|*.bash) printf '%s\0' "$file"; continue ;;
        *.md|*.json|*.yml|*.yaml|*.js|*.cjs|*.mjs|*.ts|*.py|*.txt) continue ;;
      esac
      # Extensionless files (every scripts/ci/check_* is one) are selected
      # by parsing the shebang's interpreter rather than glob-matching the
      # whole line: `#!/usr/bin/env bash -e` and `#!/bin/sh` both resolve to
      # a name, and a `#!/usr/bin/env node` cannot slip in on a substring.
      first=""
      IFS= read -r first < "$file" 2>/dev/null || true
      case "$first" in
        '#!'*) : ;;
        *) continue ;;
      esac
      interp="${first#\#!}"
      interp="${interp#"${interp%%[! ]*}"}"      # drop leading spaces
      case "$interp" in
        */env\ *|env\ *) interp="${interp#*env }" ;;
      esac
      interp="${interp%% *}"
      case "$interp" in
        bash|*/bash|sh|*/sh|dash|*/dash|ksh|*/ksh|zsh|*/zsh) printf '%s\0' "$file" ;;
      esac
    done <"$raw"
  done
}

# Scan one repo root. Echoes findings; returns 1 when any were found.
scan_root() {
  local root="$1"
  local files=() list drc=0
  list="$(mktemp "${TMPDIR:-/tmp}/token-output-list.XXXXXX")"
  # shellcheck disable=SC2064  # expand $list now, not when the trap fires
  trap "rm -f '$list'" RETURN
  # Not a process substitution: its exit status is unobservable, so a failed
  # discovery would arrive as an empty file list and pass.
  collect_shell_files "$root" >"$list" || drc=$?
  if [ "$drc" -ne 0 ]; then
    echo "check_no_token_in_output: cannot enumerate shell files under $root" >&2
    return "$drc"
  fi
  while IFS= read -r -d '' file; do
    files+=("$file")
  done <"$list"

  if [ "${#files[@]}" -eq 0 ]; then
    echo "  (no shell files under scripts/ or tests/)"
    return 0
  fi

  # No pipeline: awk's own exit status is the finding signal (0 clean,
  # 1 findings, anything else a scanner error), and a pipe would put it
  # behind PIPESTATUS, which any intervening assignment clobbers.
  #
  # TOKEN_NAMES is flattened to one line first: a literal newline inside an
  # awk `-v` assignment is a fatal "newline in string" on BSD awk.
  local out rc=0 tokens line
  tokens="$(printf '%s' "$TOKEN_NAMES" | tr '\n' ' ')"
  out="$(mktemp "${TMPDIR:-/tmp}/token-output-scan.XXXXXX")"
  # shellcheck disable=SC2064  # expand $out now, not when the trap fires
  trap "rm -f '$out'" RETURN
  awk -v TOKENS="$tokens" -v EMITTERS="$EMITTER_COMMANDS" \
      "$SCANNER" "${files[@]}" >"$out" || rc=$?
  # Strip the scan root with a QUOTED parameter expansion, not a sed
  # expression: `root` is an operator-supplied `--scan` argument, so
  # interpolating it into `s|^$root/||` lets a `|` break the delimiter and a
  # `.` or `[` over-match the prefix. Quoting inside `${line#...}` makes the
  # prefix literal, and dropping sed also removes the `set -e` exit that
  # would otherwise skip the cleanup below.
  while IFS= read -r line; do
    printf '%s\n' "${line#"$root"/}"
  done < "$out"
  rm -f "$out"
  return "$rc"
}

# How many files scan_root would read. Reported on the PASS line so a
# silently-empty scan (the classic vacuous-gate failure) is visible.
count_shell_files() {
  collect_shell_files "$1" | tr '\0' '\n' | grep -c . || true
}

# ─────────────────────────────────────────────────────────────────────────
# Self-test: both directions, over fixtures written to a temp tree.
#
# The fixtures are generated at run time rather than committed, so no file
# on disk carries a leaking pattern that the tree scan would then have to
# be taught to ignore — a path exclusion is exactly what design question 2
# rules out.
#
# Every token-shaped literal below is an obviously fake sentinel.
# ─────────────────────────────────────────────────────────────────────────
ST_PASS=0
ST_FAIL=0

# Write $1 as scripts/fixture.sh under a fresh temp root and scan it.
# Sets FIXTURE_RC and FIXTURE_OUT (the findings, root prefix stripped).
FIXTURE_RC=0
FIXTURE_OUT=""
run_fixture_capture() {
  local content="$1" tmp
  FIXTURE_RC=0
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/token-output-fixture.XXXXXX")"
  mkdir -p "$tmp/scripts"
  printf '%s\n' "$content" > "$tmp/scripts/fixture.sh"
  FIXTURE_OUT="$(scan_root "$tmp" 2>&1)" || FIXTURE_RC=$?
  rm -rf "$tmp"
}

# Echoes the scan exit code.
run_fixture() {
  run_fixture_capture "$1"
  printf '%s' "$FIXTURE_RC"
}

assert_flagged() {
  local label="$1" content="$2" rc
  rc="$(run_fixture "$content")"
  if [ "$rc" -eq 1 ]; then
    ST_PASS=$((ST_PASS + 1)); echo "  PASS: flagged — $label"
  else
    ST_FAIL=$((ST_FAIL + 1)); echo "  FAIL: expected a finding (rc 1), got rc=$rc — $label" >&2
  fi
}

assert_clean() {
  local label="$1" content="$2" rc
  rc="$(run_fixture "$content")"
  if [ "$rc" -eq 0 ]; then
    ST_PASS=$((ST_PASS + 1)); echo "  PASS: clean — $label"
  else
    ST_FAIL=$((ST_FAIL + 1)); echo "  FAIL: expected no finding (rc 0), got rc=$rc — $label" >&2
  fi
}

# A finding must be reported at the FIRST physical line of its logical
# line — the emitter — not at whichever continuation line the reference
# was wrapped onto.
assert_reported_at() {
  local want="$1" label="$2" content="$3"
  run_fixture_capture "$content"
  if printf '%s\n' "$FIXTURE_OUT" | grep -q "^scripts/fixture.sh:$want:"; then
    ST_PASS=$((ST_PASS + 1)); echo "  PASS: reported at line $want — $label"
  else
    ST_FAIL=$((ST_FAIL + 1))
    echo "  FAIL: expected a finding at line $want — $label" >&2
    printf '%s\n' "$FIXTURE_OUT" >&2
  fi
}

# `find | sort` failing must fail the CHECK, not empty the tree: an empty
# file list is indistinguishable from a clean scan, which is how a required
# gate goes vacuous without anyone noticing.
assert_discovery_failure_is_fatal() {
  local tmp shim rc=0
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/token-output-fixture.XXXXXX")"
  shim="$(mktemp -d "${TMPDIR:-/tmp}/token-output-shim.XXXXXX")"
  mkdir -p "$tmp/scripts"
  printf 'echo "$GH_TOKEN"\n' > "$tmp/scripts/fixture.sh"
  printf '#!/bin/sh\nexit 2\n' > "$shim/sort"
  chmod +x "$shim/sort"
  PATH="$shim:$PATH" scan_root "$tmp" >/dev/null 2>&1 || rc=$?
  rm -rf "$tmp" "$shim"
  if [ "$rc" -gt 1 ]; then
    ST_PASS=$((ST_PASS + 1)); echo "  PASS: fail-closed — a failed file discovery is a scanner error, not a clean tree"
  else
    ST_FAIL=$((ST_FAIL + 1))
    echo "  FAIL: expected a scanner error (rc > 1), got rc=$rc — failed file discovery" >&2
  fi
}

self_test() {
  echo "check_no_token_in_output: self-test"
  # Two indirections, for the fixtures whose text has to be LIVE on disk
  # and DEAD in this file — this file is itself scanned, so a fixture line
  # sitting at column 0 is read as source. `$DS` keeps a token reference
  # from being one; `$HD` keeps a here-doc opener out of command position,
  # which would otherwise open a scanning here-doc in THIS file and make
  # every clean fixture below it read as a here-doc body.
  local DS='$' HD='cat' SQ="'"

  # This file is itself under scripts/, so the tree scan reads these
  # fixtures as source. A SINGLE-LINE fixture is safe as written: the
  # surrounding single quotes protect its dollar signs on that same line.
  # A MULTI-LINE fixture is not — the scanner works one line at a time, so
  # its inner lines are read bare — hence the multi-line fixtures below are
  # double-quoted with `\$`, which reaches the fixture file as a live `$`
  # while leaving this file with no leaking line of its own.

  # ── Direction 1: a violating fixture must FAIL ─────────────────────────
  assert_flagged "bare echo of a token" \
    'echo "$GH_TOKEN"'
  assert_flagged "printf of a braced token" \
    'printf %s "${OP_PREFLIGHT_REVIEWER_PAT}"'
  assert_flagged "the may-be-unset read still carries the value" \
    'printf "pat=%s" "${OP_PREFLIGHT_AUTHOR_PAT:-}"'
  assert_flagged "token in a failure message helper" \
    "fail() { echo \"FAIL: \$*\" >&2; }
fail \"merge token was \$AUTHOR_MERGE_TOKEN\""
  assert_flagged "emitter nested in a command substitution" \
    'echo "$(printf %s "$GH_TOKEN")"'
  assert_flagged "interpolating here-doc body" \
    "cat <<EOF
authorization: \$GH_TOKEN
EOF"
  assert_flagged "echo inside a quoted here-doc is still stub SOURCE" \
    "cat > \"\$dir/gh\" <<GH_STUB
echo \"ENV_GH_TOKEN_VALUE=\${GH_TOKEN:-}\" >> \"\$LOG\"
GH_STUB"
  assert_flagged "an exemption pragma with no reason does not exempt" \
    'echo "$GH_TOKEN"  # TOKEN_OUTPUT_EXEMPT:'
  # The pragma is only a pragma in a COMMENT. Carried as quoted DATA the
  # command still runs and still prints the value, so matching the marker
  # anywhere on the line let a fixture mentioning it silence a live emitter.
  assert_flagged "the marker as quoted data is not an exemption" \
    "printf ${SQ}%s %s\\n${SQ} \"\$GH_TOKEN\" ${SQ}TOKEN_OUTPUT_EXEMPT: fixture text${SQ}"
  # ...and a `#` inside a quoted argument does not open the comment the
  # pragma has to live in, so quote state is load-bearing in exempt() too.
  assert_flagged "a hash inside a quoted argument does not open an exemption comment" \
    'echo "# TOKEN_OUTPUT_EXEMPT: not a comment" "$GH_TOKEN"'
  # A presence-only helper whose alternate carries its OWN expansion emits
  # the value, so it is an emitter — this pins the constant half of the
  # redactor rule below and stops it widening into any `${1:+...}` at all.
  assert_flagged "an alternate carrying its own expansion is not constant" \
    "note() { printf %s \"\${1:+\$1}\"; }
note \"\$GH_TOKEN\""
  # ── Backslash continuations: the emitter and its argument are ONE
  # command. Re-wrapping a covered direct emitter across a continuation is
  # a cosmetic edit; it must not move the site out of coverage.
  assert_flagged "a continuation carries the emitter to its argument" \
    "printf 'export TOKEN=%q\\n' \\
\"\$OP_PREFLIGHT_REVIEWER_PAT\""
  assert_flagged "a message helper called across a continuation" \
    "fail() { echo \"FAIL: \$*\" >&2; }
fail \"merge token was\" \\
\"\$AUTHOR_MERGE_TOKEN\""
  # A backslash inside a comment goes with the comment, so a commented-out
  # example cannot take the live line under it out of coverage.
  assert_flagged "a trailing backslash in a comment does not swallow the next line" \
    "fail() { echo \"FAIL: \$*\" >&2; }
# never do this, not even once: \\
fail \"\$GH_TOKEN\""
  # The stub a quoted here-doc writes is SOURCE for the shell that later
  # runs it, so a continuation inside the body joins there too.
  assert_flagged "a continuation inside a quoted here-doc stub body" \
    "cat > \"\$dir/gh\" <<\"GH_STUB\"
echo \"recording\" \\
\"\$GH_TOKEN\"
GH_STUB"
  # ...but a QUOTED delimiter is matched by the outer shell against a
  # PHYSICAL line, so that same continuation must not absorb the
  # terminator. If it did, this here-doc would never close and the
  # interpolating one under it would never be recognised. `$DS` keeps the
  # reference dead in THIS file's source while the fixture on disk gets a
  # live one, so the case does not depend on where the tree scan happens
  # to think this file's own here-docs begin.
  # Quote state is what keeps the comment rule honest in the other
  # direction too: a `#` inside a quoted span is not a comment, so the
  # backslash after it is still a live continuation.
  assert_flagged "a hash inside a quoted span does not end the line" \
    "printf '%s # not a comment\\n' \\
\"\$GH_TOKEN\""
  # Inside an UNQUOTED body the shell has already stripped quoting, so the
  # backslash run alone decides — and an odd one continues the body PAST
  # the delimiter, which is why the token below stays inside the here-doc.
  assert_flagged "an odd backslash run carries an unquoted here-doc past its delimiter" \
    "cat <<EOF
prefix \\
EOF
authorization: ${DS}GH_TOKEN
EOF"
  # ── Emitters reached without an `echo`/`printf` word at the head of the
  # line. None of these is indirection — no rename, no capture, no file —
  # so each is a spelling of the direct form, and each is one this
  # recognizer does model. The five it does NOT are in the header's
  # escape list and belong to #1015, deliberately without cases here:
  # a case asserting the current (wrong) verdict would have to be
  # deleted by the fix instead of flipped by it.
  assert_flagged "a here-string writes its word to a stream" \
    'cat <<< "$GH_TOKEN"'
  assert_flagged "a path-qualified emitter is the same emitter" \
    '/bin/echo "$GH_TOKEN"'
  assert_flagged "a path-qualified here-doc opener is the same opener" \
    "/bin/cat <<EOF
authorization: \$GH_TOKEN
EOF"
  # A shell RESERVED WORD is not the command — the command follows it, so
  # conditional and negated logging is the same direct emission.
  assert_flagged "an emitter under a reserved word is still the emitter" \
    'if echo "$GH_TOKEN"; then :; fi'
  assert_flagged "a negated emitter is still the emitter" \
    "! printf %s \"\$OP_PREFLIGHT_AUTHOR_PAT\""
  # bash documents two definition forms; the helper discovery must read both.
  assert_flagged "a parenthesis-free function definition is still a helper" \
    "function die { echo \"fatal: \$1\" >&2; }
die \"\$GH_TOKEN\""
  # The here-string belongs to the command heading ITS segment, not to the
  # first command on the line.
  assert_flagged "a here-string in a later command segment" \
    'true; cat <<< "$GITHUB_TOKEN"'
  # The closed list carries the fleet API keys too, not only the git forge
  # tokens: the phase-4b enablement evidence treats these as credentials.
  assert_flagged "an API-key name on the closed list" \
    'echo "$OPENAI_API_KEY"'
  assert_flagged "a relative path-qualified here-doc opener is the same opener" \
    "./cat <<EOF
authorization: \$GH_TOKEN
EOF"
  assert_flagged "tee writes an interpolating here-doc body to stdout" \
    "tee /dev/null <<EOF
authorization: \$GH_TOKEN
EOF"
  assert_flagged "a quoted here-doc still closes after a continued body line" \
    "cat > \"\$dir/gh\" <<\"GH_STUB\"
printf stub \\
GH_STUB
${HD} <<EOF
authorization: ${DS}GH_TOKEN
EOF"

  # ── Direction 2: a legitimate fixture must PASS ────────────────────────
  assert_clean "the documented read-path idiom passes the token to gh" \
    'GH_TOKEN="$OP_PREFLIGHT_REVIEWER_PAT" gh api user --jq .login'
  assert_clean "gh output echoed, token only passed in" \
    'echo "$(GH_TOKEN="$OP_PREFLIGHT_REVIEWER_PAT" gh api user --jq .login)"'
  assert_clean "the #993 redacted form: length only" \
    'echo "reviewer PAT len=${#OP_PREFLIGHT_REVIEWER_PAT}"'
  assert_clean "presence via a constant alternate" \
    'echo "reviewer PAT ${OP_PREFLIGHT_REVIEWER_PAT:+set}"'
  assert_clean "a redactor derives, so it is not an output command" \
    "describe_secret() { printf \"len=%d\" \"\${#1}\"; }
echo \"saw \$(describe_secret \"\$OP_PREFLIGHT_AUTHOR_PAT\")\""
  assert_clean "a set/unset redactor tests a positional but emits a constant" \
    "key_state() { [ -n \"\$1\" ] && printf SET || printf unset; }
echo \"- token: \$(key_state \"\${ANTHROPIC_AUTH_TOKEN:-}\")\""
  # The SAME redactor written with the constant alternate this check
  # documents as the legal presence form. Reading `$1` out of `${1:+set}`
  # classified the helper as an emitter and false-positived every call site.
  assert_clean "a constant-alternate presence helper is a redactor, not an emitter" \
    "key_state() { printf %s \"\${1:+set}\"; }
echo \"- token: \$(key_state \"\$GH_TOKEN\")\""
  assert_clean "captured into a variable, not emitted" \
    '_v=$(printf %s "$GH_TOKEN")'
  assert_clean "backslash-escaped literal in remediation text" \
    'echo "run: GH_TOKEN=\$OP_PREFLIGHT_REVIEWER_PAT gh api user"'
  assert_clean "single-quoted literal in remediation text" \
    'echo '"'"'export GH_TOKEN=$OP_PREFLIGHT_REVIEWER_PAT'"'"''
  assert_clean "whole-line comment" \
    '# echo "$GH_TOKEN"  <- never do this'
  assert_clean "exemption pragma carrying a reason" \
    'printf "export OP_PREFLIGHT_REVIEWER_PAT=%q\n" "$OP_PREFLIGHT_REVIEWER_PAT"  # TOKEN_OUTPUT_EXEMPT: cache contract'
  assert_clean "captured here-doc is not output" \
    "_v=\$(cat <<EOF
\$GH_TOKEN
EOF
)"
  # `printf -v NAME` assigns to a shell variable instead of writing to a
  # stream (bash `help printf`), so flagging it would be a false positive on
  # a required fleet-wide check.
  # The segment command must be re-read at every boundary: an indirect
  # command word sets no name, so a `cat` earlier on the line must not lend
  # its classification to a later segment's here-string.
  assert_clean "a here-string on an indirect command word is not the earlier cat" \
    'cat /etc/hosts; "$cmd" <<< "$GH_TOKEN"'
  assert_clean "printf -v assigns, it does not emit" \
    "printf -v encoded %q \"\$GH_TOKEN\""
  # ...and a reserved word must not invent an emitter where there is none.
  assert_clean "a reserved word alone is not an output command" \
    'if [ -n "${GH_TOKEN:-}" ]; then :; fi'
  assert_clean "a captured here-string stores the value, it does not emit it" \
    '_v=$(cat <<< "$GH_TOKEN")'
  assert_clean "a here-string consumed by a non-output command is out of scope" \
    'grep -Fq needle <<< "$GH_TOKEN"'
  assert_clean "a here-string carrying only a length" \
    'cat <<< "len=${#GH_TOKEN}"'
  # A SINGLE-quoted delimiter opens a here-doc just as a double-quoted one
  # does. If the parser does not recognise it, the body is read as ordinary
  # source and the `<<INNER` line inside it opens a here-doc that never
  # existed — which makes the line after the terminator read as an
  # interpolating body and reports a finding that is not there.
  assert_clean "a single-quoted here-doc body does not open a here-doc of its own" \
    "${HD} <<${SQ}EOF${SQ}
${HD} <<INNER
EOF
authorization: ${DS}GH_TOKEN"
  assert_clean "quoted here-doc body that is not shell output" \
    "cat <<\"EOF\"
Set GH_TOKEN=\$OP_PREFLIGHT_REVIEWER_PAT before running.
EOF"
  # ── Backslash continuations, clean direction ──────────────────────────
  # An EVEN run escapes itself: `echo ok \\` prints a backslash and ends
  # the command, so the next line is a separate one and no emitter reaches
  # the reference. Joining on any trailing backslash would flag this.
  assert_clean "an escaped backslash does not continue the line" \
    "echo ok \\\\
\"\$GH_TOKEN\""
  # ...and the same parity inside a here-doc body: an EVEN run is a
  # literal backslash, so the delimiter on the next line still closes the
  # body and the reference below it is ordinary source, not output.
  assert_clean "an even backslash run leaves a here-doc delimiter intact" \
    "cat <<EOF
prefix \\\\
EOF
authorization: ${DS}GH_TOKEN
EOF"
  assert_clean "a pragma on the last physical line exempts the whole command" \
    "printf 'export TOKEN=%q\\n' \\
\"\$OP_PREFLIGHT_REVIEWER_PAT\"  # TOKEN_OUTPUT_EXEMPT: cache contract"
  # Line 3, not 4 (where the reference was wrapped to) and not 2 (which is
  # what a logical-line INDEX would read after the join above it).
  assert_reported_at 3 "a continued emitter is reported at its own physical line" \
    "printf 'a %s\\n' \\
\"literal\"
printf 'export TOKEN=%q\\n' \\
\"\$OP_PREFLIGHT_REVIEWER_PAT\""
  # The closed-list decision, pinned in both directions: these names would
  # all match a TOKEN/PAT/SECRET heuristic and none holds a credential.
  assert_clean "ack-marker and flag names are not credential names" \
    'echo "$SUMMARY_ACK_TOKEN $ACK_TOKEN $MERGEPATH_EXPECT_READ_GH_TOKEN $REQUIRED_HEAD_CHECK_NAME $CACHE_KEY"'
  # The list covers the cloud secret the phase-4b env allow-list fixture
  # asserts about, not only the git-forge tokens.
  assert_flagged "the cloud client secret the 4b fixture asserts about is on the list" \
    'echo "$AZURE_CLIENT_SECRET"'
  # ...and the PATH-valued names from that same fixture stay off it: a path
  # is not a secret, and op-preflight prints one deliberately.
  assert_clean "credential FILE PATHS are not credential values" \
    'echo "$GOOGLE_APPLICATION_CREDENTIALS $OP_PREFLIGHT_ADC_TMPFILE $SSH_AUTH_SOCK $AWS_ACCESS_KEY_ID"'

  # An empty file list reads exactly like a clean tree, so a discovery
  # failure must not be silent. Codex measured this on #1012 by shadowing
  # `sort`; the case pins the fix.
  assert_discovery_failure_is_fatal

  if [ "$ST_FAIL" -ne 0 ]; then
    echo "check_no_token_in_output: FAIL (self-test: $ST_PASS passed, $ST_FAIL failed)" >&2
    return 1
  fi
  echo "  self-test: $ST_PASS passed, 0 failed"
  return 0
}

# ─────────────────────────────────────────────────────────────────────────
main() {
  local mode="all" root="$REPO_ROOT"

  case "${1:-}" in
    "")           : ;;
    --self-test)  mode="self-test"; shift ;;
    --scan)       mode="scan"; shift; if [ "$#" -gt 0 ]; then root="$1"; shift; fi ;;
    -h|--help)    sed -n '/^# Usage:/,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)            echo "check_no_token_in_output: unknown argument: $1" >&2
                  echo "usage: check_no_token_in_output [--self-test | --scan [DIR]]" >&2
                  exit 2 ;;
  esac
  if [ "$#" -gt 0 ]; then
    echo "check_no_token_in_output: unexpected extra argument: $1" >&2
    echo "usage: check_no_token_in_output [--self-test | --scan [DIR]]" >&2
    exit 2
  fi

  if [ "$mode" = "self-test" ] || [ "$mode" = "all" ]; then
    self_test || exit 1
  fi

  if [ "$mode" = "scan" ] || [ "$mode" = "all" ]; then
    if [ ! -d "$root" ]; then
      echo "check_no_token_in_output: not a directory: $root" >&2
      exit 2
    fi
    local rc=0
    local out
    out="$(scan_root "$root")" || rc=$?
    # Fail closed on a scanner error (awk fatal, unreadable file): a gate
    # that cannot read the tree has not cleared it.
    if [ "$rc" -gt 1 ]; then
      echo "check_no_token_in_output: ERROR (scanner exited $rc; no verdict)" >&2
      printf '%s\n' "$out" >&2
      exit "$rc"
    fi
    if [ "$rc" -ne 0 ]; then
      echo "check_no_token_in_output: FAIL" >&2
      echo "A credential variable value reaches an output stream. Emit a" >&2
      echo "description instead of the value (\${#VAR} for length," >&2
      echo "\${VAR:+set} for presence), or, if the site is a legitimate" >&2
      echo "emitter, mark it in place:" >&2
      echo "  <the line>  # TOKEN_OUTPUT_EXEMPT: <why this value may be emitted>" >&2
      echo "" >&2
      printf '%s\n' "$out" >&2
      exit 1
    fi
    printf '%s\n' "$out"
    echo "  scanned $(count_shell_files "$root") shell files under scripts/ and tests/"
  fi

  echo "check_no_token_in_output: PASS"
}

main "$@"
