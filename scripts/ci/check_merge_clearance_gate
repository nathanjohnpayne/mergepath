#!/usr/bin/env bash
# check_merge_clearance_gate
#
# CI wrapper for scripts/merge-clearance-gate.sh — the HEAD-pinned
# merge-clearance gate (nathanjohnpayne/mergepath#427 + #428).
#
# Two concerns:
#   1. The script and its workflow must exist on disk and be executable
#      (consistent with check_codex_p1_gate for the P1 gate).
#   2. The script's class-dispatch + clearance logic must work against
#      fixture payloads. Delegated to tests/test_merge_clearance_gate.sh,
#      which PATH-shims `gh` and stubs the codex-review-check.sh delegate.
#
# Invoked by .github/workflows/repo_lint.yml alongside the other
# scripts/ci/check_* scripts.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$REPO_ROOT"

SCRIPT="scripts/merge-clearance-gate.sh"
# WORKFLOW path is overridable so the test suite can point the workflow-shape
# assertions (in particular the job-name contract below) at a fixture without
# touching the canonical workflow on disk. Defaults to the real workflow.
WORKFLOW="${MERGE_CLEARANCE_WORKFLOW:-.github/workflows/merge-clearance-gate.yml}"
TEST="tests/test_merge_clearance_gate.sh"

FAILED=0

# Existence + executability checks.
for rel in "$SCRIPT" "$TEST"; do
  if [ ! -f "$rel" ]; then
    echo "FAIL: Missing required file: $rel"
    FAILED=1
    continue
  fi
  if [ ! -x "$rel" ]; then
    echo "FAIL: File is not executable: $rel"
    echo "      Fix with: chmod +x $rel"
    FAILED=1
  fi
done

# Workflow file exists (not executable; YAML is not a shell script).
if [ ! -f "$WORKFLOW" ]; then
  echo "FAIL: Missing required workflow: $WORKFLOW"
  FAILED=1
fi

# Workflow trigger shape — same posture as check_codex_p1_gate. GitHub
# Actions does NOT document pull_request_review_thread as a workflow
# trigger, so the gate combines event-driven triggers with a scheduled
# sweep that re-posts a check_run per open PR head SHA (the only backstop
# for the no-event transitions that produced #428: 👍 reaction, UI label
# resolve, GITHUB_TOKEN-authored relabel).
if [ -f "$WORKFLOW" ]; then
  for trigger in pull_request pull_request_review pull_request_review_comment schedule; do
    if ! grep -qE "^[[:space:]]*${trigger}:" "$WORKFLOW"; then
      echo "FAIL: $WORKFLOW missing required trigger: $trigger"
      echo "      The gate must fire on push, review submission, inline-comment, AND on a periodic schedule (no-event safety net)."
      FAILED=1
    fi
  done

  # Forbid the misleading pull_request_review_thread trigger.
  if grep -qE "^[[:space:]]*pull_request_review_thread:" "$WORKFLOW"; then
    echo "FAIL: $WORKFLOW lists pull_request_review_thread as a workflow trigger."
    echo "      That event is a webhook payload for GitHub Apps, NOT a documented Actions workflow trigger."
    echo "      Use schedule (cron) for the no-event safety net instead. See codex-p1-gate.yml / PR #257."
    FAILED=1
  fi

  # Schedule cron must be present in the on: block.
  if ! awk '
    /^on:/ {in_on=1; next}
    in_on && /^[^[:space:]#]/ {in_on=0}
    in_on && /^[[:space:]]+schedule:/ {in_sched=1; next}
    in_sched && /^[[:space:]]+- cron:/ {found=1; exit}
    in_sched && /^[[:space:]]+[a-z]/ {in_sched=0}
    END {exit (found ? 0 : 1)}
  ' "$WORKFLOW"; then
    echo "FAIL: $WORKFLOW schedule: block missing a 'cron:' entry."
    echo "      The schedule trigger needs a cron expression (e.g. '*/15 * * * *')."
    FAILED=1
  fi

  # #658: the propagation lane's head-pinned verified-head marker is posted as
  # a GITHUB_TOKEN github-actions[bot] ISSUE comment, and GITHUB_TOKEN-authored
  # events create no workflow runs — so an issue_comment trigger could never
  # re-run the gate for it. Instead pr-review-policy.yml's lane sends a
  # `merge-clearance-recheck` repository_dispatch right after posting the
  # marker. Require that trigger AND the dispatch-recheck wiring (the dispatch
  # type + resolving the PR from github.event.client_payload.pr), so a verified
  # sync PR clears promptly instead of riding a fail-closed spurious-red until
  # the */15 sweep. No payload trust is added: the dispatch only schedules a
  # re-run; the gate re-derives clearance from the head-pinned
  # github-actions[bot] marker in scripts/merge-clearance-gate.sh
  # lane_verified(). Keep the `merge-clearance-recheck` type in sync with the
  # lane. Label events are never a trigger here (#429 round-3 P1).
  if ! grep -qE "^[[:space:]]*repository_dispatch:" "$WORKFLOW"; then
    echo "FAIL: $WORKFLOW missing the repository_dispatch trigger."
    echo "      The propagation-lane verified-head marker is a GITHUB_TOKEN issue comment (creates no workflow run); without the merge-clearance-recheck repository_dispatch a verified sync PR rides a fail-closed spurious-red gate until the scheduled sweep (#658)."
    FAILED=1
  fi
  dispatch_wiring_missing=0
  grep -qF "merge-clearance-recheck" "$WORKFLOW" || dispatch_wiring_missing=1
  grep -qF "github.event.client_payload.pr" "$WORKFLOW" || dispatch_wiring_missing=1
  if [ "$dispatch_wiring_missing" -ne 0 ]; then
    echo "FAIL: $WORKFLOW repository_dispatch path is not wired for the marker re-trigger."
    echo "      It must accept the 'merge-clearance-recheck' dispatch type AND resolve the PR from github.event.client_payload.pr in a check_run-posting job (#658)."
    FAILED=1
  fi

  # The required-check display name (job name) must match the name the
  # scheduled-sweep posts AND the entry in audit-branch-protection.sh's
  # CANONICAL_REQUIRED_CHECKS. Branch protection keys on the job name, so
  # a drift here would silently de-wire the gate.
  #
  # Scope the assertion to the jobs: block and require the match to be a
  # JOB name (a `name:` key at the job-content indent, directly under a job
  # key) — NOT just any indented `name:`. A plain grep for an indented
  # `name:` also matched a step-level `name: Merge clearance gate` (a
  # non-first step key, deeper-indented, no leading dash). That let a
  # coincidentally-named *step* satisfy the required-check contract even if
  # the *job* name had drifted. The awk state machine below tracks the
  # jobs: block, records each job key's content indent, and only matches a
  # `name: Merge clearance gate` at that exact indent.
  if ! awk '
    /^jobs:[[:space:]]*$/ { in_jobs=1; next }
    in_jobs && /^[^[:space:]#]/ { in_jobs=0 }
    !in_jobs { next }
    {
      n=0
      while (substr($0, n+1, 1) == " ") n++
    }
    # A job key is indented exactly two spaces under jobs: and is a bare
    # "<name>:" block opener (nothing after the colon). Record the indent
    # of its content (job-name / runs-on / steps live one level deeper).
    in_jobs && n==2 && $0 ~ /^  [A-Za-z0-9_-]+:[[:space:]]*$/ {
      job_content_indent = n + 2
      next
    }
    # A job name sits at the job-content indent. Only this counts.
    in_jobs && job_content_indent>0 && n==job_content_indent &&
      $0 ~ /name:[[:space:]]*Merge clearance gate[[:space:]]*$/ {
      found=1; exit
    }
    END { exit (found ? 0 : 1) }
  ' "$WORKFLOW"; then
    echo "FAIL: $WORKFLOW must define a JOB named exactly 'Merge clearance gate'"
    echo "      (the required-check context; must match the sweep CHECK_NAME and audit-branch-protection.sh)."
    echo "      A step-level name: does NOT satisfy this — branch protection keys on the job name."
    FAILED=1
  fi

  # --- #845: the two-phase Checks-API publish must not regress -------------
  #
  # #843 made the event-driven job publish its verdict into the SAME
  # Checks-API slot the sweep and dispatch write, because supersession is
  # reliable only within that slot: a job-native completion can never retire a
  # Checks-API entry. Nothing asserted that shape, so an edit could delete the
  # scope, drop the PATCH, or move the POST back to the sweep alone and every
  # check would stay green — #841 walks straight back in.
  #
  # Two properties make these assertions worth anything, and both are
  # load-bearing rather than stylistic:
  #
  #   BLOCK SCOPING. Without it the sweep's own POST satisfies an assertion
  #   about the event job, so the guard degrades into a whole-file grep that
  #   passes on exactly the pre-#843 workflow it exists to reject.
  #
  #   COMMENT STRIPPING. #843 deliberately documents this design in prose at
  #   the call sites, so an unstripped `grep -qF` matches the explanation
  #   after the code implementing it is gone. That is the #689 lesson, already
  #   encoded as grep_nocomment_q in tests/test_465_fail_closed.sh.
  #
  # Assertion H above is deliberately untouched: keeping the job NAME is what
  # lets this check pass against #843 unchanged, and it is why the workflow
  # and this check did not have to ship atomically.

  # Print the lines of one job's block: from `  <key>:` to the next job key.
  mcg_job_block() {  # <workflow> <job-key>
    awk -v key="$2" '
      $0 ~ "^  " key ":[[:space:]]*$" { inblk=1; next }
      inblk && /^  [A-Za-z0-9_-]+:[[:space:]]*$/ { exit }
      inblk { print }
    ' "$1"
  }

  # Fixed-string match against a block with comments removed — full-line AND
  # inline. Stripping only full lines is not enough (Codex P2 on #849): the
  # valid YAML `checks: read # checks: write` disables the permission while
  # still satisfying a full-line-only strip, and the same trick hides a
  # deleted POST or PATCH behind the code it replaced. Every string these
  # assertions match is free of `#`, so removing from the first whitespace-`#`
  # cannot swallow a legitimate target.
  mcg_strip() {  # <block>
    printf '%s\n' "$1" | grep -v '^[[:space:]]*#' | sed 's/[[:space:]]#.*$//'
  }
  # A here-string, NOT a pipe into grep (Codex P2 on #849). This script runs
  # under `set -o pipefail`, and `grep -qF` exits the instant it matches — so
  # with a block near the pipe-buffer size the writer can take SIGPIPE and the
  # pipeline reports failure for a string that IS present. The event job block
  # is already 14 KB against a 16 KB buffer on macOS, which makes this a
  # scheduling-dependent false FAIL on the unmodified workflow: a CI check that
  # flaps red is worse than one that is merely incomplete. Callers pass an
  # ALREADY-stripped block so the strip runs once rather than per assertion.
  mcg_has() {  # <stripped-block> <fixed-string>
    grep -qF -- "$2" <<<"$1"
  }

  # Print the body of a nested mapping (e.g. `permissions:`) from a job block,
  # stopping at the first line indented no deeper than the key itself. Needed
  # because an anchored key match still ignores nesting (Codex P2 on #849): a
  # `checks: write` under `env:` satisfied it while the real permission was
  # `checks: read`, and the POST then 403s.
  mcg_submap() {  # <block> <key>
    awk -v key="$2" '
      {
        n = 0
        while (substr($0, n+1, 1) == " ") n++
      }
      inmap && n <= keyindent && $0 !~ /^[[:space:]]*$/ { exit }
      inmap { print; next }
      $0 ~ "^[[:space:]]*" key ":[[:space:]]*$" { inmap = 1; keyindent = n }
    ' <<<"$1"
  }

  # Print one step block from a job, from its `- name: <label>` to the next
  # step at the same indent. Per-step scope matters: an assertion over the
  # whole job passes when phase 2 supplies a value phase 1 has lost.
  mcg_step() {  # <block> <step-name-substring>
    awk -v want="$2" '
      index($0, "- name: " want) { inblk = 1; print; next }
      inblk && /^[[:space:]]*- name:/ { exit }
      inblk { print }
    ' <<<"$1"
  }

  mcg_evt_block="$(mcg_job_block "$WORKFLOW" merge-clearance-gate)"
  mcg_evt="$(mcg_strip "$mcg_evt_block")"

  if [ -z "$mcg_evt_block" ]; then
    # Guards every assertion below against silently passing on an empty block.
    echo "FAIL: $WORKFLOW has no 'merge-clearance-gate:' job key — the #845"
    echo "      publish assertions cannot be scoped, so they would degrade to a"
    echo "      whole-file grep that the pre-#843 workflow satisfies."
    FAILED=1
  else
    if ! grep -qE '^[[:space:]]+checks:[[:space:]]*write[[:space:]]*$' \
         <<<"$(mcg_submap "$mcg_evt" permissions)"; then
      echo "FAIL: the merge-clearance-gate job must grant job-scoped 'checks: write' (#843)."
      echo "      Without it the phase-1 POST 403s on every same-repo PR and the event"
      echo "      path stops publishing into the Checks-API slot entirely."
      FAILED=1
    fi
    if ! mcg_has "$mcg_evt" '-f status="in_progress"' \
       || ! mcg_has "$mcg_evt" 'gh api -X POST "repos/$REPO/check-runs"'; then
      echo "FAIL: the merge-clearance-gate job must open the required check_run with"
      echo "      status=in_progress BEFORE evaluating (#843 phase 1). That pending entry"
      echo "      is what makes every later failure — checkout, gate crash, runner death,"
      echo "      a failed PATCH — fail CLOSED instead of leaving a stale verdict standing."
      FAILED=1
    fi
    # The PATCH must target the run phase 1 opened (Codex P2 on #849).
    # Binding CHECK_ID to something else — github.run_id, say — satisfies an
    # endpoint-prefix check while the PATCH 404s through its retries and the
    # required context stays pending until a later sweep supersedes it.
    if ! mcg_has "$mcg_evt" 'CHECK_ID: ${{ steps.open.outputs.id }}'; then
      echo "FAIL: the phase-2 step must bind CHECK_ID to \${{ steps.open.outputs.id }},"
      echo "      the run phase 1 opened. Any other identifier makes the PATCH miss and"
      echo "      leaves the required context pending (#843)."
      FAILED=1
    fi
    if ! mcg_has "$mcg_evt" 'gh api -X PATCH "repos/$REPO/check-runs/'; then
      echo "FAIL: the merge-clearance-gate job must close the check_run it opened (#843"
      echo "      phase 2). Without the PATCH the required context stays PENDING forever."
      FAILED=1
    fi
    if ! mcg_has "$mcg_evt" 'CHECK_NAME: "Merge clearance gate"' \
       || ! mcg_has "$mcg_evt" '-f name="$CHECK_NAME"'; then
      echo "FAIL: the merge-clearance-gate job must publish under CHECK_NAME"
      echo "      \"Merge clearance gate\" — the required-check context string."
      FAILED=1
    fi
    # Three producers: event, sweep, dispatch — each verified IN ITS OWN JOB
    # SCOPE, and each required to both POST and publish under CHECK_NAME.
    #
    # Two weaker versions of this were caught in review and are worth naming,
    # because they fail in opposite directions. Counting CHECK_NAME
    # declarations measures naming without publishing: delete a POST, keep the
    # env: block, still three (Codex P2). Counting POST sites measures
    # publishing without naming: any unrelated check-run POST preserves the
    # count after a real producer stops emitting "Merge clearance gate"
    # (CodeRabbit Major). Only the conjunction, per scope, says what is meant —
    # that each of the three trigger paths still writes THIS slot.
    #
    # Why it matters that all three survive: the sweep and dispatch are the
    # only refreshers for the no-event transitions (a 👍 reaction, a UI thread
    # resolve, a GITHUB_TOKEN relabel), and the event job is the only one bound
    # to the PR head as it moves. Lose any one and a stale verdict persists on
    # some path.
    for mcg_producer in merge-clearance-gate scheduled-sweep dispatch-recheck; do
      mcg_pblock_raw="$(mcg_job_block "$WORKFLOW" "$mcg_producer")"
      mcg_pblock="$(mcg_strip "$mcg_pblock_raw")"
      if [ -z "$mcg_pblock_raw" ]; then
        echo "FAIL: $WORKFLOW is missing the '$mcg_producer' job — all three trigger"
        echo "      paths (event, scheduled sweep, dispatch-recheck) must publish the"
        echo "      required check_run (#843)."
        FAILED=1
        continue
      fi
      if ! mcg_has "$mcg_pblock" 'gh api -X POST "repos/$REPO/check-runs"' \
         || ! mcg_has "$mcg_pblock" '-f name="$CHECK_NAME"'; then
        echo "FAIL: the '$mcg_producer' job must POST a check_run under CHECK_NAME."
        echo "      A POST without the name flag, or a CHECK_NAME declaration without"
        echo "      a POST, leaves that trigger path no longer refreshing the required"
        echo "      context — and a stale verdict then persists on it (#843)."
        FAILED=1
      fi
      # Every producer needs the scope, not just the event job (Codex P2 on
      # #849). A sweep or dispatch job whose job-level permission drops to
      # checks: read still passes every string assertion while GitHub 403s the
      # POST — so that trigger path silently stops refreshing the context.
      # An anchored KEY match, not containment (Codex P2 on #849): a value such
      # as DUMMY: "checks: write" satisfies a substring search while the real
      # permission is checks: read, and the POST then 403s.
      if ! grep -qE '^[[:space:]]+checks:[[:space:]]*write[[:space:]]*$' \
           <<<"$(mcg_submap "$mcg_pblock" permissions)"; then
        echo "FAIL: the '$mcg_producer' job must grant 'checks: write' in its"
        echo "      job-level permissions map; without it its POST 403s and that"
        echo "      trigger path stops publishing."
        FAILED=1
      fi
      # A check_run POST without head_sha is rejected by GitHub outright, so a
      # producer missing it publishes nothing at all (Codex P2 on #849).
      # The VALUE, not just the flag (Codex P2 on #849). -f head_sha="${{
      # github.sha }}" satisfies a presence check while posting against the
      # workflow commit rather than the PR head, so the no-event transitions
      # stop refreshing the context on the commit protection evaluates.
      # The value must be a RESOLVED shell variable — the event job carries it
      # as $HEAD_SHA, the sweep and dispatch resolve $head_sha per PR — and
      # must not be a workflow-level expression. Matching the exact variable
      # name would be wrong here: the three jobs legitimately differ, and the
      # property is "a per-PR head", not "this spelling".
      # An allowlist of the two legitimate spellings, not "any shell variable"
      # (Codex P2 on #849). Widening it to accept either name also accepted
      # -f head_sha="$REPO", which posts the repository slug as a commit SHA.
      # The three jobs genuinely differ — $HEAD_SHA in the event job, the
      # per-PR $head_sha the sweep and dispatch resolve — so the allowlist has
      # exactly two members rather than a pattern.
      # Provenance, not just the name at the POST (Codex P2 on #849). The
      # auxiliary producers must derive head_sha from PR metadata — the sweep
      # reads it per-PR from a gh tab-separated stream, the dispatch resolves
      # it with gh pr list — so reassigning head_sha="$REPO" upstream cannot
      # satisfy this while the POST still spells $head_sha.
      if [ "$mcg_producer" != merge-clearance-gate ] \
         && ! grep -qE 'read -r PR head_sha|head_sha=\$\(gh ' <<<"$mcg_pblock"; then
        echo "FAIL: the '$mcg_producer' job must derive head_sha from PR metadata"
        echo "      (a gh read loop or gh pr list), not from an arbitrary assignment."
        FAILED=1
      fi
      if ! grep -qE -- '-f head_sha="\$(HEAD_SHA|head_sha)"' <<<"$mcg_pblock"; then
        echo "FAIL: the '$mcg_producer' job must POST head_sha as the per-PR head it"
        echo "      resolved (a shell variable), not a workflow expression. The Checks"
        echo "      API rejects a create-check-run without head_sha at all, and a"
        echo "      workflow-level SHA publishes to a commit protection never consults."
        FAILED=1
      fi
      # And the conclusion has to come from the gate, not a constant. Without
      # this a producer can keep its POST, its name and its head_sha while
      # publishing a verdict it never computed (Codex P2 on #849).
      if ! mcg_has "$mcg_pblock" 'scripts/merge-clearance-gate.sh'; then
        echo "FAIL: the '$mcg_producer' job must invoke scripts/merge-clearance-gate.sh"
        echo "      and derive its published conclusion from the result — otherwise it"
        echo "      publishes a verdict it never evaluated."
        FAILED=1
      fi
      # Invoking the gate is not the same as HEEDING it (Codex P2 on #849).
      # Replacing rc=$? with rc=0 leaves the invocation in place while the
      # conclusion becomes a constant, so a blocked PR publishes success.
      if ! mcg_has "$mcg_pblock" 'rc=$?'; then
        echo "FAIL: the '$mcg_producer' job must capture the gate's exit status"
        echo "      (rc=\$?) and derive its conclusion from it. Calling the gate and"
        echo "      then publishing a constant is worse than not calling it, because"
        echo "      the verdict looks evaluated."
        FAILED=1
      fi
      # Capturing rc is not the same as mapping it correctly (Codex P2 on
      # #849). Swapping the arms — 0) failure, 1) success — kept the capture
      # and inverted the verdict, so a blocked gate publishes success and
      # supersedes the honest one. Pin both arms.
      # The POST must publish the MAPPED value (Codex P2 on #849). Pinning the
      # case arms proves the mapping exists; it says nothing about what the
      # POST actually sends, and -f conclusion="success" satisfied both.
      if ! mcg_has "$mcg_pblock" '-f conclusion="$conclusion"'; then
        echo "FAIL: the '$mcg_producer' job must POST -f conclusion=\"\$conclusion\" —"
        echo "      the value it mapped from the gate. A literal publishes a verdict"
        echo "      the mapping never produced."
        FAILED=1
      fi
      # And its CHECK_NAME must be the required context (Codex P2 on #849).
      # Verifying the POST passes $CHECK_NAME says nothing about what
      # CHECK_NAME is bound to in that job.
      if ! grep -qE '^[[:space:]]*CHECK_NAME:[[:space:]]*"Merge clearance gate"[[:space:]]*$' \
           <<<"$mcg_pblock"; then
        echo "FAIL: the '$mcg_producer' job must bind CHECK_NAME to the exact required"
        echo "      context \"Merge clearance gate\"; another value publishes to a"
        echo "      different slot and this trigger path stops refreshing it."
        FAILED=1
      fi
      # And it must evaluate the PR it is iterating, not a constant (Codex P2
      # on #849). `merge-clearance-gate.sh 1 "$REPO"` satisfies a script-name
      # check while every PR receives PR 1's verdict.
      # A variable first argument, not a specific name: the event job resolves
      # $PR_NUMBER while the sweep iterates $PR, and the property is "the PR
      # being published for", not a spelling. A literal is what this rejects.
      # The variable each job actually DEFINES (Codex P2 on #849). Accepting
      # any variable let the sweep pass "$PR_NUMBER", which is unset there —
      # under set -u the sweep then dies before publishing anything.
      case "$mcg_producer" in
        merge-clearance-gate) mcg_pr_var='"$PR_NUMBER"' ;;
        *)                    mcg_pr_var='"$PR"' ;;
      esac
      if ! mcg_has "$mcg_pblock" "merge-clearance-gate.sh $mcg_pr_var"; then
        echo "FAIL: the '$mcg_producer' job must evaluate the PR it is publishing for,"
        echo "      passing $mcg_pr_var — the variable that job defines. A constant"
        echo "      publishes one PR's verdict onto every other PR's head, and a"
        echo "      variable the job never sets kills it under set -u."
        FAILED=1
      fi
      # The TRUSTED checkout (Codex P2 on #849, but the property is the
      # trusted-path rule from #628). Every producer runs
      # scripts/merge-clearance-gate.sh, and asserting the invocation says
      # nothing about which revision supplied that script. On a pull_request
      # event a checkout without an explicit default-branch ref takes the PR's
      # own copy — so a PR could rewrite the gate to exit 0 and clear itself.
      # That is forgeability, not merely incorrectness, which is why it is
      # pinned here rather than deferred with the rest of the round.
      if ! mcg_has "$mcg_pblock" 'ref: ${{ github.event.repository.default_branch }}'; then
        echo "FAIL: the '$mcg_producer' job must check out the DEFAULT BRANCH"
        echo "      (ref: \${{ github.event.repository.default_branch }}) before running"
        echo "      the gate. Without it a pull_request run evaluates the PR's own copy"
        echo "      of scripts/merge-clearance-gate.sh, and a PR can clear itself (#628)."
        FAILED=1
      fi
      # Auxiliary producers only. The event job maps through the sentinel-
      # guarded form (rc 0 AND verdict=pass), which is asserted separately
      # above; requiring the one-line case arms there would reject the real
      # workflow for having the STRONGER mapping.
      if [ "$mcg_producer" != merge-clearance-gate ] \
         && { ! grep -qE '^[[:space:]]*0\)[[:space:]]*conclusion="success"' <<<"$mcg_pblock" \
              || ! grep -qE '^[[:space:]]*1\)[[:space:]]*conclusion="failure"' <<<"$mcg_pblock"; }; then
        echo "FAIL: the '$mcg_producer' job must map gate rc 0 to conclusion=success"
        echo "      and rc 1 to conclusion=failure. An inverted or missing mapping lets"
        echo "      a blocked PR publish a green required check over the honest verdict."
        FAILED=1
      fi
    done
    if ! mcg_has "$mcg_evt" 'github.event.pull_request.head.sha'; then
      echo "FAIL: the merge-clearance-gate job must bind its check_run to"
      echo "      github.event.pull_request.head.sha (#843)."
      FAILED=1
    fi
    # EVERY HEAD_SHA assignment must bind to the PR head — an allowlist, not a
    # denylist. This assertion is on its third shape and the first two failed
    # the same way: rejecting `head_sha="${{ github.sha }}"` missed
    # `HEAD_SHA: ${{ github.sha }}` (Codex), and rejecting `github.sha` missed
    # `github.event.pull_request.base.sha` (Codex again). Both slipped through
    # because phase 2's unchanged line kept satisfying the positive search.
    # Enumerating wrong spellings cannot terminate; requiring every binding to
    # be the right one does.
    # Anchored to a YAML key at line start: an unanchored 'HEAD_SHA:' also
    # matches the shell parameter expansion ${HEAD_SHA:0:7} inside a message
    # string, which is not a binding and made this reject the real workflow.
    # Exact expression, not containment (Codex P2 on #849). A line reading
    # HEAD_SHA: literal-github.event.pull_request.head.sha contains the wanted
    # text and no github.sha, so a containment allowlist accepted it while the
    # publisher submitted an invalid head_sha and its POST failed. Anchoring
    # both ends is what makes an allowlist actually exclusive.
    # Phase 1 must bind HEAD_SHA itself. Asserting over the whole job passes
    # when only phase 2 still has one (Codex P2 on #849) — and phase 1 then
    # expands an unset HEAD_SHA under set -u and exits BEFORE opening the
    # in-progress run, which is precisely the fail-closed property this fence
    # exists to protect.
    if ! grep -qE '^[[:space:]]*HEAD_SHA:' \
         <<<"$(mcg_step "$mcg_evt" 'Open the required check_run')"; then
      echo "FAIL: the phase-1 step must bind HEAD_SHA itself (#843). With only"
      echo "      phase 2 binding it, phase 1 expands an unset variable under set -u"
      echo "      and exits before opening the in-progress run — so nothing retires"
      echo "      the previous verdict and the publish stops failing closed."
      FAILED=1
    fi
    mcg_bad_headsha="$(grep -E '^[[:space:]]*HEAD_SHA:' <<<"$mcg_evt" \
      | grep -vE '^[[:space:]]*HEAD_SHA:[[:space:]]*\$\{\{[[:space:]]*github\.event\.pull_request\.head\.sha[[:space:]]*\}\}[[:space:]]*$' || true)"
    if [ -n "$mcg_bad_headsha" ]; then
      echo "FAIL: every HEAD_SHA assignment in the merge-clearance-gate job must bind"
      echo "      to github.event.pull_request.head.sha. Offending line(s):"
      printf '%s\n' "$mcg_bad_headsha" | sed 's/^/        /'
      echo "      A check_run bound to the merge commit (github.sha) or the base"
      echo "      (base.sha) is absent from the commit branch protection evaluates."
      FAILED=1
    fi
    if mcg_has "$mcg_evt" 'github.sha'; then
      echo "FAIL: the merge-clearance-gate job must NOT bind to github.sha. On a"
      echo "      pull_request event that is the refs/pull/N/merge commit, which branch"
      echo "      protection never consults — the required context would be ABSENT on"
      echo "      every head: a permanent block, fleet-wide, with no partial degradation."
      FAILED=1
    fi
    if ! mcg_has "$mcg_evt" 'Merge clearance: PASS'; then
      echo "FAIL: the merge-clearance-gate job must require the 'Merge clearance: PASS'"
      echo "      verdict sentinel before publishing success (#843). Without it a call"
      echo "      site that lands in a query mode publishes an unearned green: those"
      echo "      modes also exit 0 but print only true/false."
      FAILED=1
    fi
    # The condition's SENSE, not just its presence (Codex P2 on #849).
    # Inverting it to == '' skips phase 2 exactly when a run was opened,
    # leaving the required context pending on every successful evaluation.
    if ! mcg_has "$mcg_evt" "steps.open.outputs.id != ''"; then
      echo "FAIL: the phase-2 step must run when phase 1 DID open a run"
      echo "      (steps.open.outputs.id != ''). Inverting that condition leaves the"
      echo "      required context pending on every evaluation that succeeded."
      FAILED=1
    fi
    if ! mcg_has "$mcg_evt" '!cancelled()'; then
      echo "FAIL: the merge-clearance-gate phase-2 step must be guarded by !cancelled()"
      echo "      (#843) so a cancelled run leaves the required context PENDING (blocking)"
      echo "      rather than publishing a verdict it never computed."
      FAILED=1
    fi
    if mcg_has "$mcg_evt" 'if: always()'; then
      echo "FAIL: the merge-clearance-gate job must not use if: always() for the phase-2"
      echo "      publish — on cancellation it would publish a conclusion from an"
      echo "      evaluation that did not finish. Use !cancelled() (#843)."
      FAILED=1
    fi
    # Phase 2 must consume the GATE STEP's outputs (Codex P2 on #849).
    # Asserting `case "$RC" in` proves a mapping exists over whatever RC holds;
    # rebinding the step env to RC: 0 / VERDICT: pass satisfies it while the
    # conclusion stops depending on the evaluation entirely.
    # Scoped to the phase-2 STEP, not the job. The event job binds RC and
    # VERDICT twice — once here and once in "Report gate verdict" — so a
    # job-scoped assertion is satisfied by the other one while this step's
    # binding is replaced by a constant. Same per-step lesson as HEAD_SHA.
    mcg_p2="$(mcg_step "$mcg_evt" 'Close the required check_run')"
    if ! mcg_has "$mcg_p2" 'RC: ${{ steps.gate.outputs.rc }}' \
       || ! mcg_has "$mcg_p2" 'VERDICT: ${{ steps.gate.outputs.verdict }}'; then
      echo "FAIL: the phase-2 step must take RC and VERDICT from steps.gate.outputs."
      echo "      Any other binding decouples the published conclusion from the gate"
      echo "      evaluation while leaving the mapping visibly intact (#843)."
      FAILED=1
    fi
    if ! mcg_has "$mcg_evt" 'case "$RC" in'; then
      echo "FAIL: the merge-clearance-gate job must map the gate exit code to a"
      echo "      conclusion through an explicit case (#843), so rc 0-without-PASS and"
      echo "      rc 2 cannot collapse into success."
      FAILED=1
    fi
    # Conspicuousness fence: exactly one place may set a success conclusion, so
    # adding a second green path stays a visible diff on a protected file
    # rather than a one-token edit. This does not make tampering impossible —
    # the workflow is PR-authored, which is #845's open restructure — it keeps
    # it loud.
    mcg_success_assigns="$(grep -cF 'conclusion="success"' <<<"$mcg_evt" || true)"
    if [ "$mcg_success_assigns" -ne 1 ]; then
      echo "FAIL: the merge-clearance-gate job assigns conclusion=\"success\""
      echo "      $mcg_success_assigns times; expected exactly 1 (#845). More than one"
      echo "      green path makes an added bypass indistinguishable from a refactor;"
      echo "      zero means a passing evaluation can never close the check as success,"
      echo "      leaving it pending or red until a later sweep supersedes it."
      FAILED=1
    fi
  fi

  # --- #850: structural assertions over the PARSED document ----------------
  #
  # ADDITIVE. Everything above stays: the exact `-f` flags inside a `run:` body
  # are shell, not YAML, so a parse cannot see them. What a parse can see, and
  # text matching cannot express at all, is POSITION and REACHABILITY:
  #
  #   PHASE-1 POSITION. The assertions above prove the POST and
  #   status=in_progress occur SOMEWHERE in the job block. Moving that step
  #   below the checkout, or giving it a step-level `if:`, satisfies every one
  #   of them — and any earlier failure then happens BEFORE the pending entry
  #   retires the previous synthetic verdict, which is the only reason phase 1
  #   exists.
  #
  #   PRODUCER ELIGIBILITY. `if: false` on scheduled-sweep leaves the
  #   top-level `schedule:` trigger and every matched string intact, so the
  #   producer loop above passes while the no-event transitions (a 👍 reaction,
  #   a UI thread resolve, a GITHUB_TOKEN relabel) stop refreshing the required
  #   context.
  #
  # The other two properties are #849 holes that a parse closes cheaply: the
  # phase-2 step's own HEAD_SHA binding (a job-scoped grep is satisfied by
  # phase 1's), and GH_TOKEN on every gh-invoking step (an unbound token makes
  # the call fall back to no credentials and the publish 401s).
  #
  # Parser posture, and the two cases are NOT the same:
  #   - PyYAML ABSENT is an environment gap → loud SKIP, exit 0. Same idiom as
  #     scripts/ci/check_workflow_parsers (its agent-review.yml parse tier) and
  #     scripts/ci/check_auto_clear_workflow: a YAML parser is never a hard
  #     dependency of scripts/ci/check_*. GitHub-hosted runners ship PyYAML, so
  #     enforcement is real in CI.
  #   - The DOCUMENT failing to parse is a defect → hard FAIL naming the parse
  #     error. Silently matching nothing would let a broken edit land green and
  #     surface only when Actions rejects the workflow at schedule time.
  # The yq tier those precedents try first is deliberately not used here: they
  # probe validity (one expression), these are assertions over the document,
  # and a yq spelling would be a second implementation to keep in sync.
  if ! python3 -c "import yaml" >/dev/null 2>&1; then
    echo "  SKIP: PyYAML unavailable — the #850 structural assertions did NOT run."
    echo "        Install PyYAML to enforce phase-1 position + producer eligibility."
  elif ! python3 - "$WORKFLOW" <<'PY'
import re
import sys

import yaml

WORKFLOW = sys.argv[1]
# The three jobs that publish the required context, same set as the text loop.
PRODUCERS = ("merge-clearance-gate", "scheduled-sweep", "dispatch-recheck")
# Exact-match allowlists, never containment (the #849 lesson, third shape): a
# value that CONTAINS the wanted expression — `literal-${{ ... }}` — satisfies
# a substring test while the publisher submits something GitHub rejects.
GH_TOKEN_OK = ("${{ secrets.GITHUB_TOKEN }}",)
HEAD_SHA_OK = ("${{ github.event.pull_request.head.sha }}",)
# Conservative falsy set. The real jobs carry legitimate truthy expressions
# (github.event_name == 'schedule'), which MUST pass; this rejects only
# literals GitHub can never evaluate true. `if: false` parses to Python False,
# whose str() is "false", so the bare bool is covered by the same set.
FALSY = ("false", "0", "null", "")


def is_falsy_if(value):
    """True when a job-level if: is a literal GitHub can never evaluate true.

    An expression wrapper around a bare literal — `${{ false }}`, `${{ 0 }}`,
    `${{ null }}` — is unwrapped first: GitHub treats those exactly as the
    bare literal, so leaving them outside the set would let a producer be
    disabled while every assertion here passes. Anything non-literal inside
    the wrapper is left alone; evaluating expressions is review's job.
    """
    # A bare `if:` / `if: null` / `if: ~` parses to Python None, whose str()
    # is "None" — outside the tuple, so the native-null path would bypass the
    # wrapper normalization entirely. GitHub's handling of a null condition
    # is not documented; a condition the check cannot prove eligible fails
    # closed, forcing an explicit expression or removal of the key.
    if value is None:
        return True
    text = str(value).strip()
    wrapped = re.fullmatch(r"\$\{\{\s*(.*?)\s*\}\}", text)
    if wrapped:
        text = wrapped.group(1)
    # GitHub's falsy LITERALS are a closed set: false, null, the empty
    # string, and numeric zero in any spelling (-0, 0.0, 0e0). Normalising
    # numeric value terminates the set — this is not an enumeration that can
    # drift. Applied to bare values too, not only wrapped ones: YAML hands a
    # bare `if: 0.0` over as the float whose str() is "0.0", which no literal
    # tuple can enumerate.
    #
    # A QUOTED expression literal is its own arm: only the EMPTY quoted
    # string is falsy — GitHub treats every non-empty string literal,
    # including '0', as truthy, so stripping the quotes and falling into the
    # numeric check would falsely reject an eligible producer.
    if len(text) >= 2 and text[0] == text[-1] and text[0] in "'\"":
        return text[1:-1] == ""
    try:
        if float(text) == 0:
            return True
    except ValueError:
        pass
    return text.lower() in FALSY

failures = []


def bad(*lines):
    failures.extend(lines)


def strip_comments(text):
    """Full-line AND inline `#` comments removed, same as mcg_strip above.

    #843 documents its design in prose at the call sites, so an unstripped
    body matches the explanation after the code implementing it is gone.
    """
    text = re.sub(r"(?m)^[ \t]*#.*$", "", text)
    return re.sub(r"(?m)[ \t]#.*$", "", text)


def step_named(job, want):
    for step in job.get("steps") or []:
        # A steps entry can parse to a bare string; .get on it would raise
        # and surface as a traceback instead of a named failure.
        if isinstance(step, dict) and want in (step.get("name") or ""):
            return step
    return None


# Duplicate mapping keys are a parse error here, as they are for Actions'
# own workflow parser. yaml.safe_load would silently keep the LAST duplicate
# while the text layer's block extraction reads the FIRST — so under
# last-wins the two layers would inspect different job definitions and each
# could pass on properties the other never saw.
class StrictLoader(yaml.SafeLoader):
    def construct_mapping(self, node, deep=False):
        seen = set()
        for key_node, _value_node in node.value:
            key = self.construct_object(key_node, deep=deep)
            if isinstance(key, (dict, list)):
                # A complex (unhashable) key would TypeError on the set
                # membership below, which the outer except still catches — but
                # a named parse error beats an incidental one, and Actions
                # rejects complex keys in workflows anyway.
                raise yaml.constructor.ConstructorError(
                    None, None,
                    "found unhashable (complex) mapping key", key_node.start_mark)
            if key in seen:
                raise yaml.constructor.ConstructorError(
                    None, None,
                    "found duplicate mapping key %r" % key, key_node.start_mark)
            seen.add(key)
        return super().construct_mapping(node, deep)


try:
    with open(WORKFLOW, encoding="utf-8") as handle:
        doc = yaml.load(handle, Loader=StrictLoader)
except Exception as exc:  # any parse failure carries the same verdict
    print("FAIL: %s does not parse as YAML: %s" % (WORKFLOW, " ".join(str(exc).split())))
    print("      A workflow that cannot be parsed must fail LOUDLY here. Silently")
    print("      matching nothing would let a broken edit land green and surface")
    print("      only when Actions rejects the workflow at schedule time (#850).")
    sys.exit(1)

jobs = (doc or {}).get("jobs")
if not isinstance(jobs, dict):
    print("FAIL: %s parses but has no jobs: mapping — the #850 structural" % WORKFLOW)
    print("      assertions have nothing to scope to and would pass vacuously.")
    sys.exit(1)

# Property 1 — phase 1 is the FIRST step, unconditional, with its own bindings.
event_job = jobs.get("merge-clearance-gate")
if event_job is not None and not isinstance(event_job, dict):
    # A non-mapping value (a YAML list or scalar) is truthy, so `or {}` does
    # not normalise it and the .get below would raise — turning a malformed
    # workflow into a traceback with NO named property, unlike every other
    # malformed-input path here. The producer loop reports the not-a-mapping
    # cause for this key; normalising lets the phase-1/phase-2 messages fire
    # with accurate text instead of crashing before any of them print.
    event_job = None
steps = (event_job or {}).get("steps") or []
if not steps:
    bad("FAIL: [#850 phase-1 position] the merge-clearance-gate job declares no",
        "      steps, so nothing opens the in-progress check_run.")
elif not isinstance(steps[0], dict):
    bad("FAIL: [#850 phase-1 position] the FIRST entry of merge-clearance-gate's",
        "      steps is not a mapping, so nothing opens the in-progress check_run.")
else:
    first = steps[0]
    label = first.get("name") or "<unnamed>"
    body = strip_comments(first.get("run") or "")
    # Identity AND content, on the SAME step. Two unconnected substrings alone
    # would accept a preliminary step whose run body merely mentions them (an
    # echo, a comment block) while the real publisher sits later — satisfying
    # the text layer too, since that greps the whole job. The name is the same
    # identity the text layer's per-step extraction scopes to, so both layers
    # pin one step.
    if ("Open the required check_run" not in (first.get("name") or "")
            or "check-runs" not in body or "in_progress" not in body):
        bad("FAIL: [#850 phase-1 position] the FIRST step of merge-clearance-gate is",
            "      %r, which is not the 'Open the required check_run' publisher" % label,
            "      POSTing to check-runs with status=in_progress. Every failure after",
            "      this point — checkout, PR resolve, gate crash, runner death — only",
            "      fails CLOSED if the pending entry already retired the previous",
            "      verdict, so phase 1 must come first.")
    if "if" in first:
        bad("FAIL: [#850 phase-1 unconditional] the phase-1 step %r carries a" % label,
            "      step-level if: %r. A conditional publisher skips exactly when" % first["if"],
            "      the run it guards is the one that needed to retire a stale verdict.")
    env = first.get("env") or {}
    absent = [name for name in ("HEAD_SHA", "GH_TOKEN") if name not in env]
    if absent:
        bad("FAIL: [#850 phase-1 env] the phase-1 step %r does not bind %s in its" % (label, ", ".join(absent)),
            "      env. Under set -u an unbound HEAD_SHA exits before the POST, and an",
            "      unbound GH_TOKEN makes it 401 — either way nothing opens the run.")

# Property 2 — every producer is reachable on its own trigger.
for key in PRODUCERS:
    job = jobs.get(key)
    if not isinstance(job, dict):
        bad("FAIL: [#850 producer eligibility] job '%s' is missing or is not a" % key,
            "      mapping; that trigger path publishes nothing.")
        continue
    if "if" in job and is_falsy_if(job["if"]):
        bad("FAIL: [#850 producer eligibility] job '%s' carries a falsy job-level" % key,
            "      if: %r, so it never runs. Every trigger and every matched" % job["if"],
            "      string survives that edit — only the parse sees it — while that",
            "      path stops refreshing the required context.")

# Property 3 — phase 2 binds the PR head itself (#849 hole: a job-scoped grep
# for HEAD_SHA is satisfied by phase 1's binding while phase 2 has lost its).
close_step = step_named(event_job or {}, "Close the required check_run")
if close_step is None:
    bad("FAIL: [#850 phase-2 head binding] the merge-clearance-gate job has no",
        "      'Close the required check_run' step, so the run phase 1 opened is",
        "      never completed and the required context stays PENDING.")
elif (close_step.get("env") or {}).get("HEAD_SHA") not in HEAD_SHA_OK:
    bad("FAIL: [#850 phase-2 head binding] the 'Close the required check_run' step",
        "      binds HEAD_SHA to %r; it must be exactly" % (close_step.get("env") or {}).get("HEAD_SHA"),
        "      ${{ github.event.pull_request.head.sha }}. Phase 2 compares that value",
        "      against the live head to decide success vs head-moved, so any other",
        "      binding either kills the step under set -u or publishes on a commit",
        "      branch protection never consults.")

# Property 4 — every gh-invoking step binds the token (#849 hole).
# Detection runs over the UN-stripped body on purpose: prose mentioning `gh`
# only ever OVER-includes a step (it then has to bind the token it does not
# use), whereas stripping first would let a `gh` call hidden after a `#` on a
# live line escape the requirement entirely.
GH_INVOKE = re.compile(r"(?<![A-Za-z0-9_./-])gh[ \t]")
for key in PRODUCERS:
    job = jobs.get(key)
    if not isinstance(job, dict):
        continue
    for step in job.get("steps") or []:
        if not isinstance(step, dict):
            continue
        if not GH_INVOKE.search(step.get("run") or ""):
            continue
        token = (step.get("env") or {}).get("GH_TOKEN")
        if token not in GH_TOKEN_OK:
            bad("FAIL: [#850 gh token binding] step %r in job '%s' invokes gh but" % (step.get("name") or "<unnamed>", key),
                "      binds GH_TOKEN to %r. The only accepted value is" % token,
                "      ${{ secrets.GITHUB_TOKEN }} — gh with no token falls back to",
                "      unauthenticated and the check_run publish 401s, leaving that",
                "      trigger path silently not refreshing the required context.")

if failures:
    print("\n".join(failures))
    sys.exit(1)
sys.exit(0)
PY
  then
    FAILED=1
  fi
fi

if [ "$FAILED" -ne 0 ]; then
  echo "check_merge_clearance_gate: FAIL (pre-flight)"
  exit 1
fi

# Run the fixture-driven test suite.
if ! bash "$TEST"; then
  echo "check_merge_clearance_gate: FAIL (test suite)"
  exit 1
fi

echo "check_merge_clearance_gate: PASS"
exit 0
