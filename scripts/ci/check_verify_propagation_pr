#!/usr/bin/env bash
# scripts/ci/check_verify_propagation_pr — CI entry point for the
# propagation-PR review lane's faithful-mirror verifier (#264 / #268).
#
# Wraps tests/test_verify_propagation_pr.sh so the repo_lint workflow's
# "run all scripts/ci/check_*" loop picks it up. The verifier
# (scripts/workflow/verify-propagation-pr.sh) is security-load-bearing
# — it is what makes it safe for the lane to skip Phase 4 external
# review — so its test suite is a hard CI gate.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# The verifier and its segment-local protected-path matcher
# (scripts/workflow/match_protected_paths.sh, #471) are both
# security-load-bearing for the propagation lane, so both test suites are
# hard CI gates here.
TESTS=(
  "tests/test_verify_propagation_pr.sh"
  "tests/test_match_protected_paths.sh"
)

for rel in "${TESTS[@]}"; do
  full="$REPO_ROOT/$rel"
  if [ ! -f "$full" ]; then
    # Consumer-safe fail-closed (#467). Both wrapped tests travel to
    # consumers (consumers: all in .mergepath-sync.yml), so in a healthy
    # consumer they are present and run. But during a partial sync — or
    # if a future manifest edit narrows their consumer scope — a consumer
    # could hold this kit-propagated wrapper without the test. Use the
    # manifest as the canonical/consumer discriminator, same as
    # scripts/ci/check_bootstrap_sh:
    #   - .mergepath-sync.yml present → canonical checkout, the test MUST
    #     exist; a missing test is an accidental delete/rename → hard
    #     error so it surfaces in CI instead of silently disabling a
    #     security-load-bearing check.
    #   - .mergepath-sync.yml absent → consumer checkout missing the
    #     test → SKIP that test rather than red the consumer's repo-lint.
    if [ ! -f "$REPO_ROOT/.mergepath-sync.yml" ]; then
      echo "check_verify_propagation_pr: SKIP $rel (consumer checkout: test + .mergepath-sync.yml both absent)"
      continue
    fi
    echo "check_verify_propagation_pr: ERROR (missing $rel)" >&2
    exit 1
  fi
  echo "check_verify_propagation_pr: running $rel"
  bash "$full"
done
