        gate_name, lint_name = parent_names
        if "github.event.workflow_run.name == '%s'" % gate_name not in EXPECTED_JOB_IF[OPEN_JOB]:
            bad("FAIL: [rcp parent name] the pinned `open` condition does not admit the",
                "      gate parent %r by name. `open` would open no hold on any" % gate_name,
                "      delivery, and every verdict would land with no pending cover.")
        if "github.event.workflow_run.name != '%s'" % lint_name not in EXPECTED_JOB_IF[PUBLISH_JOB]:
            bad("FAIL: [rcp parent name] the pinned `publish` condition does not filter",
                "      the lint parent %r by name. Every lint completion — push-to-main" % lint_name,
                "      included — would then enter the rcp-publish queue as a full pass.")

# A7 — "nothing may observe the publisher via workflow_run" — is REMOVED
