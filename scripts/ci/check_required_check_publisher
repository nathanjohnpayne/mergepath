# entry orphans one signal class, an added entry is a third pass per event,
# and a reordering is a diff that has to arrive here on purpose. The same
# two names are then cross-checked against the literals inside the pinned
# job conditions (A4a): a parent renamed consistently in its file AND in
# `workflows:` would otherwise leave an `if:` arm comparing against a name
# no delivery ever carries — `open` would then open no hold at all and
# `publish` would admit every lint run, main's tip included.
PARENTS = (
    ("gate", PARENT_WORKFLOW),
    ("lint", LINT_PARENT_WORKFLOW),
)
if isinstance(triggers, dict):
    listed = (triggers.get("workflow_run") or {}).get("workflows") \
        if isinstance(triggers.get("workflow_run"), dict) else None
    # The load outcome is tracked SEPARATELY from the name it yields.
    # Collapsing both into `parent_name is None` conflates an unreadable
    # parent (already reported here) with a parent that parses cleanly and
    # declares no top-level `name:` — and the second is exactly the shape
    # this assertion exists to catch. Actions names an unnamed workflow
    # after its PATH, so the `workflows:` entry would then match no
    # workflow and every delivery from that parent is orphaned. Under a
    # single `is not None` guard, DELETING one line from the parent disarms
    # A6 instead of tripping it.
    parent_names = []
    parents_ok = True
