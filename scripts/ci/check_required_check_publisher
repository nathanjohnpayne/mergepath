                % (parent_path, " ".join(str(exc).split())),
                "      The publisher's workflow_run sources must be verified against",
                "      each parent's own top-level name:, not against a string in this",
                "      check.")
        if not parent_loaded:
            continue  # already reported above; a second failure would just be noise
        if not isinstance(parent_name, str) or not parent_name.strip():
            parents_ok = False
