            % (key, got_if),
            "      condition %r." % want_if,
            "      The two are DISJOINT: `open` runs on the workflow_run requested and",
            "      in_progress deliveries, `publish` on workflow_run completed plus every",
            "      non-workflow_run delivery. in_progress is the rerun cue and belongs to",
            "      `open` alone — a `publish` that also ran on it would overwrite the",
            "      rerun's own hold before the parent finished evaluating, reopening the",
            "      stale-verdict window. A condition Actions can never satisfy — literal",
            "      or not — makes the publisher open holds it never closes; an ABSENT if:",
            "      makes each job run on the other's deliveries too. Pinned verbatim",
            "      rather than screened for falsiness, so an equivalent respelling",
            "      arrives here as a diff too.")
    if "needs" in job:
        bad("FAIL: [rcp job eligibility] job %r declares needs: %r. The two phase"
            % (key, job.get("needs")),
            "      jobs run on DISJOINT deliveries, so a dependency between them is",
            "      never satisfied. `needs: open` on `publish` reads as harmless and",
            "      leaves every other value here intact, while on a `completed`",
            "      delivery `open` skips and takes `publish` with it — no verdict is",
            "      ever published and every hold stays pending.")

# ── A4 — publish is serialized on ONE fixed queue ──────────────────────
if publish_job is not None:
    conc = publish_job.get("concurrency")
    if not isinstance(conc, dict):
