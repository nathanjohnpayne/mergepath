# A8 (exactly one `conclusion="success"` assignment) and A12 (the
# freshness read and head revalidation precede the verdict POST) are
# REMOVED, not weakened. Both were counts and substring positions over
# shell text: respelling the quotes adds a second unearned-green path the
# count never sees, and appearing-before is not executing-before. #977
# reinstates both over a parsed shell AST, where the property is the one
# actually asserted.

# ── A14 — no runner-held waiting in either phase job (#2167) ───────────
#
# CI completion reaches this workflow as an EVENT (the repo-lint parent),
# so no `run:` body may sit on a runner waiting for a check to finish. The
# shape that used to do that elsewhere in this repo (#1062 finding 5, a
# 1,200 s wait at 15 s intervals) is a shell loop around a status read —
# `while`/`until` with a `sleep` — or `gh pr checks --watch`. The only loops
# the publisher legitimately contains are `read` loops over enumerated PRs
# and bounded `for attempt in 1 2 3` API retries.
#
# ASSERTION KIND, disclosed: this reads the `run:` bodies as TEXT (the same
# disclosed exception as A2), because a loop has no YAML-level expression.
# It rejects a `while`/`until` keyword at statement position whose command
# is not `read`, and any `--watch`. Residual, stated: a wait respelled as a
# `for` over a long range with a `sleep`, or a loop keyword mid-line after
# something other than `;`, `&&`, `||`, `do` or `then`, passes. Closing that
# needs the parsed-shell substrate tracked in #977; what this buys is that
# the two spellings that have actually shipped here cannot return silently.
def strip_shell_comments_quote_aware(text):
    """Comment stripping that respects shell quoting (Codex P2 on #2171, r2).

    strip_shell_comments above cuts from any whitespace-`#`, which treats the
    hash inside `echo "state #"; while true; ...` as a comment and hides the
    loop. This per-line state machine tracks single quotes, double quotes and
    backslash escapes; a `#` opens a comment only outside both quote kinds and
    after whitespace (or at line start). Quote state resets per line — a quoted
    string spanning lines is the stated residual (#977). Used by A14 only; the
    other text assertions keep the simpler stripper they were verified with.
    """
    kept = []
    for line in text.splitlines():
        if re.match(r"^[ \t]*#", line):
            continue
        out = []
        sq = dq = esc = False
        prev = " "
        for ch in line:
            if esc:
                out.append(ch); esc = False; prev = ch; continue
            if ch == "\\" and not sq:
                out.append(ch); esc = True; prev = ch; continue
            if ch == "'" and not dq:
                sq = not sq
            elif ch == '"' and not sq:
                dq = not dq
            elif ch == "#" and not sq and not dq and prev in " \t":
                break
            out.append(ch); prev = ch
        kept.append("".join(out))
    # A loop keyword ending a line continues on the next (Codex P2 on
    # #2171, round 3): `while` / newline / `true; do ...` is one statement
    # to the shell, so the two lines are joined before the scan.
    joined = []
    pending = None
    for line in kept:
        if pending is not None:
            line = pending + " " + line
            pending = None
        if re.search(r"(^|[ \t])(while|until)[ \t]*$", line):
            pending = line
            continue
        joined.append(line)
    if pending is not None:
        joined.append(pending)
    return "\n".join(joined)


LOOP_AT_STATEMENT = re.compile(
    r"(?m)(?:^[ \t]*|;[ \t]*|&&[ \t]*|\|\|[ \t]*|\bdo[ \t]+|\bthen[ \t]+)"
    # Only `while ... read` is the finite enumeration shape (Codex P2 on
    # #2171, round 4): `until read -r x </dev/null` never succeeds at EOF and
    # is an infinite runner-held wait, so `until` is never exempt.
    r"(?P<kw>while(?=[ \t]+(?!(?:IFS=[^ \t;]*[ \t]+)?read\b))|until(?=[ \t]))")
WATCH_FLAG = re.compile(r"--watch\b")
# EVERY job, not just the two known phase jobs (Codex P2 on #2171, round 4):
# A0 requires `open` and `publish` to exist but does not forbid a third, and
# a wait in a third job holds a runner just the same.
for key, job in jobs.items():
    if not isinstance(job, dict):
        continue
    steps = job.get("steps")
    if not isinstance(steps, list):
        continue
    for step in steps:
        if not isinstance(step, dict) or not isinstance(step.get("run"), str):
            continue
        body = strip_shell_comments_quote_aware(step["run"])
        label = step.get("name") or step.get("id") or "<unnamed step>"
        hit = LOOP_AT_STATEMENT.search(body)
        if hit:
            bad("FAIL: [rcp no runner-held wait] job %r step %r contains a `%s` loop"
                % (key, label, hit.group("kw")),
                "      that is not a `while ... read` loop. The publisher evaluates once and exits;",
                "      a loop around a status read holds a runner for the whole CI run,",
                "      which is the #1062 shape #2167 removed. CI completion must arrive",
                "      as a workflow_run delivery from the repo-lint parent, not be",
                "      polled for on a runner.")
        if WATCH_FLAG.search(body):
            bad("FAIL: [rcp no runner-held wait] job %r step %r passes `--watch`."
                % (key, label),
                "      A watch holds the runner until the checks finish — the runner-held",
                "      poll #2167 removed. Evaluate once; let the repo-lint parent's",
                "      completed delivery bring the publisher back.")

# The body/label gate's native contexts must never run on dispatch or cron
# (#1249): skipped jobs still satisfy required checks. Reuse ActionsLoader
# so quoted keys and flow-style YAML cannot bypass the trigger fence.
policy_path = os.path.join(WORKFLOW_DIR, "pr-review-policy.yml")
try:
    policy_doc = load(policy_path)
    policy_on = policy_doc.get("on") if isinstance(policy_doc, dict) else None
    if isinstance(policy_on, dict):
        policy_triggers = set(policy_on)
    elif isinstance(policy_on, list) and all(isinstance(x, str) for x in policy_on):
        policy_triggers = set(policy_on)
    elif isinstance(policy_on, str):
        policy_triggers = {policy_on}
    else:
        raise ValueError("missing or invalid on trigger definition")
    forbidden = policy_triggers & {"schedule", "workflow_dispatch"}
    if forbidden:
        bad("FAIL: [rcp review-policy triggers] %s forbids triggers %s (#1249):"
            % (policy_path, sorted(forbidden)),
            "      non-PR runs can publish satisfying skipped native gate checks.")
except Exception as exc:
    bad("FAIL: [rcp review-policy triggers] %s cannot be validated: %s"
        % (policy_path, " ".join(str(exc).split())))

# ── A5 — the native producers are RETAINED ─────────────────────────────
for basename, (job_key, context, expected_display) in NATIVE_PRODUCERS.items():
    path = os.path.join(WORKFLOW_DIR, basename)
    if not os.path.exists(path):
        bad("FAIL: [rcp native producer] %s is missing. It owns a required" % path,
            "      production contract for %r; without it that context loses" % context,
            "      its native same-repository lineage. A publisher or trusted fork",
            "      relay that is absent, renamed, disabled, or misses a workflow_run",
            "      delivery can then leave the context with no producer at all.")
        continue
    try:
        gate_doc = load(path)
    except Exception as exc:
        bad("FAIL: [rcp native producer] %s does not parse: %s"
            % (path, " ".join(str(exc).split())))
        continue
    # A15 (#2167) — the native producers' sweep cadence, pinned exactly. Each
    # tick walks every open PR against the shared 1,000/hr installation-token
    # budget (the gate's also chains a publisher full pass); at */15 the three
    # spent about twice that budget at 8 open PRs. Pinned in BOTH directions:
    # a faster cron re-exhausts the budget, a slower or absent one widens the
    # no-event stuck window past the 30 minutes REVIEW_POLICY.md states.
    gate_on = gate_doc.get("on") if isinstance(gate_doc, dict) else None
    sched = gate_on.get("schedule") if isinstance(gate_on, dict) else None
    crons = [e.get("cron") for e in sched if isinstance(e, dict)] if isinstance(sched, list) else None
    if crons != [EXPECTED_NATIVE_SWEEP_CRON]:
        bad("FAIL: [rcp native sweep cadence] %s schedule crons are %r, not exactly [%r]."
            % (path, crons, EXPECTED_NATIVE_SWEEP_CRON),
            "      #2167 set the three native producers' sweeps to */30: every tick walks",
            "      every open PR against the 1,000/hr installation-token budget, and at",
            "      */15 the three spent about twice that at 8 open PRs. Changing the",
            "      cadence is a REVIEW_POLICY.md decision (stuck window vs budget), so it",
            "      must arrive here as a diff.")
    if isinstance(gate_doc, dict) and "concurrency" in gate_doc:
        bad("FAIL: [rcp native workflow concurrency] %s must not declare workflow concurrency."
            % path,
            "      Workflow cancellation also cancels its native required producer (#1661).")
    gate_jobs = (gate_doc or {}).get("jobs")
    if not isinstance(gate_jobs, dict) or job_key not in gate_jobs:
        bad("FAIL: [rcp native producer] %s has no %r job." % (path, job_key),
            "      Deleting the natively-named job does not merge the two lineages, it",
            "      DELETES one — leaving the required context with a single producer",
            "      that a workflow owns.")
        continue
    gate_job = gate_jobs[job_key]
    if isinstance(gate_job, dict) and "concurrency" in gate_job:
        bad("FAIL: [rcp native concurrency] %s job %r must not declare concurrency."
            % (path, job_key),
            "      Cancelling a pending native required check cannot be retired by",
            "      the publisher's independent Checks-API lineage (#1661).")
    display = gate_job.get("name") if isinstance(gate_job, dict) else None
    effective = display if display is not None else job_key
    if str(effective) != expected_display:
        bad("FAIL: [rcp native producer] %s job %r reports as %r, not the required"
            % (path, job_key, effective),
            "      producer name %r. Branch protection keys on the evaluated display" % expected_display,
            "      name, so a drift can either de-wire the native lineage or let an",
            "      untrusted fork run occupy the required context while every other",
            "      check stays green.")
    if basename == "codex-p1-gate.yml" and isinstance(gate_job, dict):
        needs = gate_job.get("needs")
        needs_list = [needs] if isinstance(needs, str) else needs
        if not isinstance(needs_list, list) or "archive-edited-feedback" not in needs_list:
            bad("FAIL: [rcp native producer] %s job %r does not need"
                % (path, job_key),
                "      'archive-edited-feedback'. Its read-only-aware display name reads",
                "      that job's requires_relay output; without the dependency the expression",
                "      cannot reliably select the non-required handoff name.")

# ── A16 — the due threshold IS the gate sweep interval (#2220) ─────────
#
# DUE_MAX_AGE_SECONDS decides when an event pass re-evaluates a PR whose
# green slot shows no activity, and it is documented as "a verdict older
# than the sweep interval". It stayed at 900 when #2167 moved the sweep from
# */15 to */30, so every green PR fell due again after 15 minutes and event
# passes re-evaluated it twice as often as designed — one of the four causes
# of the installation-budget exhaustion #2220 measured. The two values live
# in different files, so only an assertion over both keeps them equal. The
# cron is read from the GATE PARENT, the workflow whose schedule fires the
# publisher's chained pass; a cron not of the form `*/N * * * *` fails here
# rather than being guessed at. The two budget-guard knobs on the same step
# are required non-negative integers (the per-PR cost must be positive): a
# missing or malformed knob makes the pass fall back to evaluating without
# a guard, which is silent.
PUBLISH_STEP_NAME = REQUIRED_HEAD_ENV[PUBLISH_JOB][0]
publish_step = None
if publish_job is not None:
    named = [s for s in (publish_job.get("steps") or [])
             if isinstance(s, dict) and s.get("name") == PUBLISH_STEP_NAME]
    publish_step = named[0] if len(named) == 1 else None
publish_env = (publish_step or {}).get("env") if isinstance((publish_step or {}).get("env"), dict) else {}
try:
    gate_parent_doc = load(PARENT_WORKFLOW)
except Exception:
    gate_parent_doc = None  # unreadable parent is already reported by A6
gate_parent_on = gate_parent_doc.get("on") if isinstance(gate_parent_doc, dict) else None
gate_sched = gate_parent_on.get("schedule") if isinstance(gate_parent_on, dict) else None
gate_crons = [e.get("cron") for e in gate_sched if isinstance(e, dict)] if isinstance(gate_sched, list) else []
sweep_seconds = None
if len(gate_crons) == 1 and isinstance(gate_crons[0], str):
    m = re.fullmatch(r"\*/([1-9][0-9]*) \* \* \* \*", gate_crons[0].strip())
    if m:
        sweep_seconds = int(m.group(1)) * 60
due_age = publish_env.get("DUE_MAX_AGE_SECONDS")
if gate_parent_doc is not None and sweep_seconds is None:
    bad("FAIL: [rcp due threshold] %s carries no single `*/N * * * *` schedule cron"
        % PARENT_WORKFLOW,
        "      (read %r), so the sweep interval DUE_MAX_AGE_SECONDS must equal" % gate_crons,
        "      cannot be derived (#2220).")
elif sweep_seconds is not None and str(due_age) != str(sweep_seconds):
    bad("FAIL: [rcp due threshold] the publish step's DUE_MAX_AGE_SECONDS is %r, but the"
        % due_age,
        "      gate parent's sweep cron %r is every %d seconds. An event pass" % (gate_crons[0], sweep_seconds),
        "      treats a quiet green as current only for this long, and it is defined",
        "      as the sweep interval: shorter re-evaluates every green PR more often",
        "      than the sweep (the 900-at-*/30 drift behind #2220), longer lets a",
        "      verdict outlive a quiet period the sweep already allowed.")
for knob, minimum in (("BUDGET_PER_PR_REQUESTS", 1), ("BUDGET_RESERVE_REQUESTS", 0),
                      ("BUDGET_PER_PR_GRAPHQL_POINTS", 1), ("BUDGET_GRAPHQL_RESERVE_POINTS", 0)):
    value = publish_env.get(knob)
    if not (isinstance(value, str) and value.isdigit() and int(value) >= minimum):
        bad("FAIL: [rcp budget guard] the publish step's %s is %r, not a quoted" % (knob, value),
            "      integer >= %d. The budget guard (#2220) reads it to decide whether a" % minimum,
            "      pass can afford every PR it would evaluate; a missing or malformed",
            "      knob silently turns the guard off and lets a pass exhaust the",
            "      installation budget again.")

# ── A17 — the auto-clear nomination job (#2239, #2205) ─────────────────
#
# POST /dispatches needs `contents: write`, so the nomination lives in a job
# of its own: the publish job runs the gate scripts and must never hold that
# grant. The job is pinned WHOLE, because each addition that would keep it
# looking right widens what runs with a write token: a `uses:` step (a
# checkout or an action) executes code under the grant, a second scope or an
# `environment:` widens the token, and a `concurrency:` block can cancel a
# pending nomination. The publish job's hand-off (its step id and its one
# output) is pinned with it, since a broken hand-off silently nominates
# nothing. The dispatched event type is read out of the run text (the same
# disclosed text exception as A2) and must be exactly the one type
# auto-clear-blocking-labels.yml listens to: a rename on either side orphans
# every nomination with nothing going red, the A6 failure in another file.
NOMINATE_JOB = "nominate-auto-clear"
NOMINATE_KEYS = {"name", "needs", "if", "runs-on", "permissions", "steps"}
NOMINATE_IF = "${{ !cancelled() && needs.publish.outputs.autoclear_prs != '' }}"
NOMINATE_STEP_KEYS = {"name", "env", "run"}
NOMINATE_ENV = {
    "GH_TOKEN": "${{ secrets.GITHUB_TOKEN }}",
    "REPO": "${{ github.repository }}",
    "AUTOCLEAR_PRS": "${{ needs.publish.outputs.autoclear_prs }}",
}
PUBLISH_OUTPUTS = {"autoclear_prs": "${{ steps.publish.outputs.autoclear_prs }}",
                   "evidence_escalations": "${{ steps.publish.outputs.evidence_escalations }}"}
nominate = jobs.get(NOMINATE_JOB)
if not isinstance(nominate, dict):
    bad("FAIL: [rcp auto-clear nomination] the publisher has no %r job mapping;" % NOMINATE_JOB,
        "      a green clearance verdict on a labeled PR then reaches auto-clear only",
        "      through its */5 sweep, which GitHub delays or drops under load (#2239).")
else:
    if set(nominate) != NOMINATE_KEYS:
        bad("FAIL: [rcp auto-clear nomination] job %r keys are %s, not exactly %s."
            % (NOMINATE_JOB, sorted(nominate), sorted(NOMINATE_KEYS)),
            "      An `environment:`, `concurrency:`, `outputs:` or `container:` beside",
            "      a contents: write token changes what the grant reaches.")
    if nominate.get("needs") not in ("publish", ["publish"]):
        bad("FAIL: [rcp auto-clear nomination] job %r needs %r, not the publish job."
            % (NOMINATE_JOB, nominate.get("needs")))
    if " ".join(str(nominate.get("if", "")).split()) != NOMINATE_IF:
        bad("FAIL: [rcp auto-clear nomination] job %r condition is %r, not %r."
            % (NOMINATE_JOB, nominate.get("if"), NOMINATE_IF),
            "      It must run only when the pass nominated a PR (no runner otherwise),",
            "      and must survive another PR's infra red in the publish job.")
    if nominate.get("permissions") != {"contents": "write"}:
        bad("FAIL: [rcp auto-clear nomination] job %r permissions are %r, not exactly"
            % (NOMINATE_JOB, nominate.get("permissions")),
            "      {'contents': 'write'}: POST /dispatches needs that and nothing else.")
    nsteps = nominate.get("steps")
    if not (isinstance(nsteps, list) and len(nsteps) == 1 and isinstance(nsteps[0], dict)):
        bad("FAIL: [rcp auto-clear nomination] job %r must carry exactly one step." % NOMINATE_JOB)
    else:
        nstep = nsteps[0]
        if set(nstep) != NOMINATE_STEP_KEYS:
            bad("FAIL: [rcp auto-clear nomination] job %r step keys are %s, not exactly %s."
                % (NOMINATE_JOB, sorted(nstep), sorted(NOMINATE_STEP_KEYS)),
                "      A `uses:` step (a checkout or an action) would execute code under",
                "      the contents: write grant.")
        if nstep.get("env") != NOMINATE_ENV:
            bad("FAIL: [rcp auto-clear nomination] job %r step env is %r, not %r."
                % (NOMINATE_JOB, nstep.get("env"), NOMINATE_ENV),
                "      The dispatch rides the job's own GITHUB_TOKEN, never a PAT.")
        run_text = strip_shell_comments(str(nstep.get("run", "")))
        sent = re.findall(r"event_type=([A-Za-z0-9_.-]+)", run_text)
        listener_types = None
        listener_path = os.path.join(WORKFLOW_DIR, "auto-clear-blocking-labels.yml")
        try:
            listener_on = (load(listener_path) or {}).get("on")
            listener_rd = listener_on.get("repository_dispatch") if isinstance(listener_on, dict) else None
            listener_types = listener_rd.get("types") if isinstance(listener_rd, dict) else None
        except Exception as exc:
            bad("FAIL: [rcp auto-clear nomination] could not read %s: %s"
                % (listener_path, " ".join(str(exc).split())))
        if not (isinstance(listener_types, list) and len(listener_types) == 1):
            bad("FAIL: [rcp auto-clear nomination] %s does not listen to exactly one"
                % listener_path,
                "      repository_dispatch type (read %r), so the nomination event has" % listener_types,
                "      no single listener to match.")
        elif sent != listener_types:
            bad("FAIL: [rcp auto-clear nomination] the job dispatches event_type %r, but" % sent,
                "      auto-clear-blocking-labels.yml listens to %r. A mismatch orphans" % listener_types,
                "      every nomination silently.")
if publish_job is not None:
    if publish_job.get("outputs") != PUBLISH_OUTPUTS:
        bad("FAIL: [rcp auto-clear nomination] the publish job's outputs are %r, not %r."
            % (publish_job.get("outputs"), PUBLISH_OUTPUTS))
    if (publish_step or {}).get("id") != "publish":
        bad("FAIL: [rcp auto-clear nomination] the publish step's id is %r, not 'publish';"
            % (publish_step or {}).get("id"),
            "      the job output reads steps.publish.outputs.autoclear_prs.")

if failures:
    print("\n".join(failures))
    sys.exit(1)
sys.exit(0)
