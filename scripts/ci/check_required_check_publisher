# ── A2 — every head_sha binding SITE is on an allowlist ────────────────
#
# Scope is exactly the binding sites, by spelling, plus their count; the
# value an allowlisted variable holds at the POST is a dataflow property
# outside any assertion over text (see HEAD_SHELL_ALLOWED above).
#
# The catastrophe this prevents: on a workflow_run run `github.sha` is the
# DEFAULT BRANCH's last commit, so one such binding puts all three
# contexts on a commit branch protection never consults — absent on every
# PR head, fleet-wide, permanently, with no partial degradation.
for key, job in ((OPEN_JOB, open_job), (PUBLISH_JOB, publish_job)):
    if job is None:
        continue
    step_name, bindings = REQUIRED_HEAD_ENV[key]
    matching_steps = [
        step for step in (job.get("steps") or [])
        if isinstance(step, dict) and step.get("name") == step_name
    ]
    if len(matching_steps) != 1:
        bad("FAIL: [rcp head binding] job %r has %d steps named %r; exactly one"
            % (key, len(matching_steps), step_name),
            "      consuming step is required so its head binding cannot be moved to",
            "      an unrelated step while the Checks-API POST receives an empty value.")
        continue
    env = matching_steps[0].get("env")
    for name, want in bindings.items():
        if not isinstance(env, dict) or name not in env:
            bad("FAIL: [rcp head binding] job %r consuming step %r declares no %s"
                % (key, step_name, name),
                "      env binding. PRESENCE is pinned on the step that expands it, not",
                "      somewhere else in the job: an allowlisted shell variable that is",
                "      unset at the POST publishes every context on an empty head_sha.")
