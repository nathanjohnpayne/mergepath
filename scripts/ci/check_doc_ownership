      cc[cc_n] = col
      cs[cc_n] = start_col
      cq[cc_n] = qdepth
      cb[cc_n] = 0
      code_column = col
    }
    # How many block quotes this line opens with. Up to three spaces of
    # indentation may precede each `>`, and one space after it is part of the
    # marker rather than of the content.
    #
    # `base` is the CONTENT COLUMN of the innermost container the line is
    # currently inside, and it is consumed before the three-space allowance is
    # applied — because that allowance is relative to the container, not to
    # column zero. Measuring from column zero rejected a valid quote marker
    # that merely sat inside an indented item: after `- para`, the line
    # `    > - # inner` puts its `>` two columns into item content, well
    # short of the six that would make it code, yet four absolute spaces broke
    # the loop and the depth came back zero. The list frame that line pushed
    # was then tagged at quote depth zero, so the unmarked blank that ends the
    # quote did not take it down with it; the stale frame raised the code
    # threshold and a six-column link was reported although both renderers
    # render it as indented code in the OUTER item.
    #
    # Two more facts about the prefix are reported back, because every
    # allowance measured "from the start of the line" is really measured from
    # the end of the container prefix: QD_CHARS is how many SOURCE CHARACTERS
    # the markers and their attached spaces occupy, and QD_COL is the absolute
    # COLUMN the content after them begins at. Both are zero on an unquoted
    # line, which is what makes the callers uniform.
    function quote_depth(s, base,   d, i, run, eaten, ch, col, adv) {
      d = 0
      i = 1
      QD_CHARS = 0
      QD_COL = 0
      # Container indentation first, and only as much of it as is actually
      # there — a line may be dedented below `base` and still open a quote.
      #
      # `base` is a COLUMN count, so the run that supplies it is measured in
      # columns too and a tab advances to the next tab stop rather than by one.
      # Accepting only literal spaces made the whole exception inert wherever
      # the indentation was spelled with a tab: under `-<TAB>para`, the line
      # `<TAB>> - # inner` consumed no prefix at all, so its `>` was never
      # reached, the inner frame was tagged at quote depth zero, and it
      # outlived the quote exactly as it did before the base existed.
      eaten = 0
      while (eaten < base) {
        ch = substr(s, i, 1)
        if (ch == " ") { eaten++; i++ }
        else if (ch == "\t") { eaten += tab_stop_advance(eaten); i++ }
        else break
      }
      # Every run from here on is measured in COLUMNS against `col`, the
      # absolute column reached so far, because a tab advances to the next tab
      # stop and how far it advances depends on where it starts. Counting
      # characters instead made the three-column allowance wrong for every
      # tab-spelled indentation: `- para` then two spaces, a tab and
      # `> - # inner` puts the marker at column four, which CommonMark
      # recognizes as a quote nested in the outer item, while a
      # spaces-only loop stopped at the tab and read no marker at all.
      col = eaten
      while (i <= length(s)) {
        # At most three columns may precede a marker; a fourth is indentation,
        # which makes the line content rather than a deeper quote.
        run = 0
        while (run < 4) {
          ch = substr(s, i, 1)
          if (ch == " ") { run++; col++; i++ }
          else if (ch == "\t") {
            adv = tab_stop_advance(col)
            run += adv; col += adv; i++
          } else break
        }
        if (run >= 4 || substr(s, i, 1) != ">") break
        d++
        i++
        col++
        # One space or tab after the marker belongs to the marker, not to the
        # content — and a tab there advances by columns like any other.
        ch = substr(s, i, 1)
        if (ch == " ") { i++; col++ }
        else if (ch == "\t") { col += tab_stop_advance(col); i++ }
        # Snapshot after each ACCEPTED marker rather than at the end of the
        # loop: the loop exits having already consumed the whitespace run that
        # failed the marker test, and that run is content indentation, not
        # prefix.
        QD_CHARS = i - 1
        QD_COL = col
      }
      return d
    }
    function strip_inline_code(s, out, pos, rel, open, width, scan, got, close_width) {
      out = ""; pos = 1
      while (pos <= length(s)) {
        rel = index(substr(s, pos), "`")
        if (rel == 0) return out substr(s, pos)
        open = pos + rel - 1
        width = run_len(s, open, "`")
        got = 0; scan = open + width
        while (scan <= length(s)) {
          if (substr(s, scan, 1) != "`") { scan++; continue }
          close_width = run_len(s, scan, "`")
          if (close_width == width) { got = 1; break }
          scan += close_width
        }
        # An unmatched delimiter renders literally; preserve it and the rest.
        if (!got) return out substr(s, pos)
        out = out substr(s, pos, open - pos) " "
        pos = scan + width
      }
