    # `col` is the new container CONTENT column; `start_col` is the column its
    # MARKER begins at. The two differ, and only the marker column says which
    # frames this container replaces: a marker at column S closes every
    # container whose content starts deeper than S, including the SIBLING item
    # it replaces. Popping at the content column instead kept a sibling frame
    # alive underneath the new one whenever the run after the new marker was
    # wider — `- one` then `-   # two` left the column-2 frame of the first
    # item under the column-4 frame of the second — and that stale frame rose
    # as a code threshold of six once the list closed, so top-level indented
    # code was scanned as prose.
    function push_container(col, start_col, qdepth) {
      pop_containers(start_col, qdepth)
