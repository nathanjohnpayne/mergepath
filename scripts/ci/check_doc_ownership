      probe = rendered
      sub(/^[ \t]*/, "", probe)
      if (probe ~ /^\[[^]]+\]:[ \t]*$/) {
        reference_pending = 1
        text_flow_open = 0
      } else if (reference_continuation) {
        text_flow_open = 0
      } else if (text_flow_open && col_indent >= code_column + 4) {
        # Indented code cannot interrupt a paragraph, so while one is open
        # a line this deep is lazy CONTINUATION TEXT — whatever block it
        # may look like. The classifier below is handed the line with its
        # indentation stripped and so cannot see the column at all, which
        # is the whole question here: it read a four-space `- # Heading`
        # under an open paragraph as a list starting there, closed the
        # paragraph that was really still open, and blanked the
        # continuation line after it as item code.
        #
        # The rule is one branch rather than a bullet-specific guard
        # because it holds for every block shape. Verified against the
        # reference parser with a paragraph open: at four columns past the
        # container, a bullet, an ordered marker, an ATX heading, a
        # thematic break, a block quote, a setext underline and an HTML
        # block ALL stay paragraph text. The HTML block is the
        # discriminating control — at three columns it does interrupt the
        # paragraph and the link below it does not render, at four it does
        # not interrupt and the link does.
        text_flow_open = 1
      } else {
        flow_probe = line
        sub(/^[ \t]*/, "", flow_probe)
        marker_columns = 0
        mc_n = 0
        flow_column = col_indent
        item_code_first = 0
        item_blank_first = 0
        item_fence_opened = 0
        item_fence_char = ""
        item_fence_width = 0
        html_opened = 0
        text_flow_open = opens_text_flow(flow_probe, text_flow_open)
        if (mc_n > 0) {
          # Outermost frame first: each push pops the frames its own MARKER
          # closes, so replaying them in order rebuilds the WHOLE container
          # stack the line opened rather than only its innermost item.
          #
          # Each marker starts where the previous one puts its content, and
          # the outermost starts at the indent of the line. That start column
          # is what the push pops against — see push_container: popping at the
          # content column instead let a sibling item survive under its
          # replacement.
          for (mc_i = 1; mc_i <= mc_n; mc_i++) {
            push_container(col_indent + mc[mc_i], \
                           (mc_i > 1) ? col_indent + mc[mc_i - 1] : col_indent, \
                           line_quote)
          }
          # Only the INNERMOST marker can be the one with nothing after it —
          # every marker outside it has the next marker as its content — so
          # the one-blank bound belongs to the frame the loop pushed last.
          # `- - ` then a blank closes the inner item and leaves the outer
          # one standing, which is what both renderers do.
          if (item_blank_first) cb[cc_n] = 1
        } else if (!text_flow_open) {
          # The pop above runs BEFORE the line is classified, so it has to
          # assume a dedented line might lazily continue the open paragraph
          # and leave the container alone. Once the line is classified we
          # know it did not — a heading after `- Governance` closes the item
          # — and the stale column has to go, or the next indented line is
          # measured against a container that no longer contains it and real
          # top-level code is reported as prose.
          pop_containers(col_indent, line_quote)
        }
        # A list item whose first child is an indented code block renders the
        # remainder of its OWN marker line as that code, so the marker line
        # carries no link either. The blanking above only ever reaches the
        # lines that FOLLOW a marker, so this case has to be caught here or a
        # link that never rendered gets reported.
        if (item_code_first) rendered = ""
        if (item_fence_opened) {
          in_fence = 1
          fence_char = item_fence_char
          fence_width = item_fence_width
          text_flow_open = 0
          rendered = ""
        }
        # The OPENER of an HTML block is raw HTML too, and whatever follows
        # the tag ON THAT LINE is block content rather than Markdown —
        # `<div>See [the audit](hub.md)` renders no link in either renderer.
        # A one-line block ends on its own opener, so the closer is tested
        # here as well; the branch above only ever sees the lines after it.
        if (html_opened) {
          rendered = ""
          in_html = (html_block_ends(substr(line, QD_CHARS + 1), html_opened)) \
                    ? 0 : html_opened
          # The quote depth the block was opened AT, so it can be closed when
          # that container closes — see the guard above.
          html_quote = line_quote
          html_container_depth = cc_n
          html_container_start = (cc_n > 0) ? cs[cc_n] : -1
        }
      }
      print rendered
    }
  ' "$f"
}

# Emit every rendered Markdown link/image target in a file, one per line, with
# fragments, angle brackets and link titles stripped. Used by check 10:
# a link's *target* is what a reader's browser resolves, and a target is
# written relative to the document that carries it, so a raw grep for
# the repo-relative path cannot see the sibling spellings that a doc in
# the same directory naturally uses (`[x](coderabbit-audit.md)`).
#
# Covers both Markdown link forms:
#   * inline        — `[label](target)`, `[label](<target>)`,
#                     `[label](target "title")`, and the `!` image variant
#   * reference def — `[label]: target "title"` at the start of a line,
#                     AND the CommonMark-legal wrapped spelling where the
#                     destination sits on the FOLLOWING line:
#
#                         [the audit]:
#                         coderabbit-audit.md
#
#                     "optional spaces or tabs (including up to one line
#                     ending)" separate the colon from the destination, so
#                     this renders as a working link — verified against
#                     markdown-it-py's commonmark preset, the parser this
#                     repo's prose-wrap tooling already relies on:
#                     `<a href="coderabbit-audit.md">the audit</a>`. A
#                     same-line-only grep emits no target for it, and the
#                     sibling spelling carries no `docs/agents/` prefix
#                     for the literal pass to find either — so the link
#                     ships broken to every consumer with check 10 silent
#                     (#797 review).
#
# The `|| true` inside the brace group belongs to the GREP and to nothing
# else. The group is the left side of a pipeline, so it runs in a subshell
# where `set -e` applies, and a no-match exit 1 from that grep would abort the
# group and silently discard the later producers' output — a real outcome,
# because a doc need not carry a same-line reference definition.
#
# The two awk producers carry no such guard, deliberately. Neither has a
# no-match state: they read every line and print what they find, so a nonzero
# exit from either means the classifier DIED, and swallowing that turns check
# 10 into a clean PASS on a document nobody could read. Measured on this
# program: restore the recursion the classifier used to use and hand it a
# document deep enough to segfault BWK awk, and with the guards in place the
# whole check exits 0 with no findings. The callers now inspect the status —
# see check 10 — so the same input reports a scan failure instead.
mp_doc_link_targets() {
  local f="$1"
  # `$2` selects which stream the final awk emits: empty (the default) for the
  # resolved destinations check 10 compares, `unresolvable` for the ones whose
  # character references cannot be expanded — see mp_doc_unresolvable_destinations.
  local emit="${2:-}"
  # CommonMark backslash escapes are limited to this ASCII punctuation set.
  # Keep it in the shell and pass it to both awk stages so destination
  # balancing and normalization share one definition across awk locales.
  local ascii_punctuation=$'!"#$%&\'()*+,-./:;<=>?@[\\]^_`{|}~'
  # These target-extraction awk stages compare pathname bytes. Pinning them to
  # the C locale keeps BSD awk, gawk, and mawk aligned; the preceding renderer
  # classifier keeps the caller's locale.
  {
    # Inline destinations need a small stateful reader rather than
    # `grep -o '\]([^)]*)'`: CommonMark bare destinations may contain
    # balanced parentheses (`hub(1).md`), and angle destinations may
    # contain parentheses or spaces. The first-closing-paren spelling
    # truncates those valid links and hides consumer-broken references.
    mp_markdown_renderable_text "$f" | LC_ALL=C awk -v ASCII_PUNCT="$ascii_punctuation" '
      {
        line = $0
        n = length(line)
        for (i = 1; i < n; i++) {
          if (substr(line, i, 2) != "](") continue
          start = i + 2

          # Angle-bracket destination: preserve the wrapper so the
          # common cleanup below can retain embedded whitespace.
          if (substr(line, start, 1) == "<") {
            for (j = start + 1; j <= n; j++) {
              c = substr(line, j, 1)
              if (c == "\\" && j < n) { j++; continue }
              if (c != ">") continue
              for (k = j + 1; k <= n; k++) {
                c = substr(line, k, 1)
                if (c == "\\" && k < n) { k++; continue }
                if (c == ")") {
                  print substr(line, start, j - start + 1)
                  i = k
                  break
                }
              }
              break
            }
            continue
          }

          # Bare destination: the `)` that closes the link is the first
          # one encountered at nesting depth zero. Backslash escapes do
          # not affect balancing, and the escape is carried through rather
          # than resolved here: normalize_target() below resolves escapes
          # and character references together, in one pass, and unescaping
          # twice would let `\&#46;` — an escaped ampersand, which renders
          # literally — decode into a `.` the reader never sees.
          depth = 0
          target = ""
          destination_done = 0
          for (j = start; j <= n; j++) {
            c = substr(line, j, 1)
            if (c == "\\" && j < n) {
              nextc = substr(line, j + 1, 1)
              if (index(ASCII_PUNCT, nextc) > 0) {
                if (!destination_done) target = target c nextc
                j++
                continue
              }
              if (!destination_done) target = target c
              continue
            }
            if (!destination_done && c ~ /[[:space:]]/ && depth == 0) {
              destination_done = 1
              continue
            }
            if (!destination_done && c == "(") {
              depth++
              target = target c
              continue
            }
            if (c == ")") {
              if (!destination_done && depth > 0) {
                depth--
                target = target c
                continue
              }
              print target
              i = j
              break
            }
            if (!destination_done) target = target c
          }
        }
      }
    '
    mp_markdown_renderable_text "$f" | grep -oE '^[[:space:]]{0,3}\[[^]]+\]:[[:space:]]*(<[^>]*>|[^[:space:]]+)' || true
    # Wrapped reference definition: a label + colon with NOTHING after it
    # on that line, then the destination as the first token of the next
    # non-blank line. Indentation is capped at three spaces the same way
    # the same-line grep caps it, but measured with `match()` rather than
    # an `{0,3}` interval, which not every awk implementation supports.
    # A blank line after the colon ends the definition (CommonMark allows
    # at most one line ending there), so nothing is emitted for it.
    mp_markdown_renderable_text "$f" | LC_ALL=C awk '
      function print_target(s, gt) {
        sub(/^[[:space:]]+/, "", s)
        if (substr(s, 1, 1) == "<") {
          gt = index(s, ">")
          if (gt > 1) { print substr(s, 1, gt); return }
        }
        sub(/[[:space:]].*$/, "", s)
        print s
      }
      pending {
        pending = 0
        if (NF > 0) { print_target($0); next }
      }
      /^[[:space:]]*\[[^]]+\]:[[:space:]]*$/ {
        indent = match($0, /[^[:space:]]/) - 1
        if (indent >= 0 && indent <= 3) pending = 1
      }
    '
  } | sed -E \
        -e 's/^\]\(//' \
        -e 's/\)$//' \
        -e 's/^[[:space:]]*\[[^]]+\]:[[:space:]]*//' \
    | LC_ALL=C awk -v EMIT="$emit" -v ASCII_PUNCT="$ascii_punctuation" '
        # CommonMark resolves entity and numeric character references inside
        # a link destination (§ Entity and numeric character references), so
        # the path a reader actually opens is the DECODED one:
        # `[audit](hub&#46;md)` navigates to `hub.md`. Comparing the encoded
        # spelling against the inventory therefore misses a hub-only target
        # the browser resolves perfectly well (#807).
        #
        # NAMED_TEXT holds every named reference this checker can expand.
        # It stores the expansion as a STRING, not as a code point: keying
        # by code point could not represent `&fjlig;` (which expands to the
        # two ASCII characters `fj`), so `[audit](hub&fjlig;.md)` reached
        # `hubfj.md` while the destination stayed encoded — a hub-only
        # sibling the browser resolves and the scan never saw.
        #
        # Two tables feed it. `refs` is the COMPLETE set of HTML5 named
        # references whose expansion is entirely ASCII: 46 members, 45
        # single-character ones listed as name/code-point pairs plus
        # `fjlig`. `latin` is every HTML5 named reference whose expansion
        # lies in Latin-1 Supplement or Latin Extended-A (U+00A0-U+017F,
        # 234 members, all single-character) — the accented letters that
        # actually spell European filenames. Both are generated from the
        # published HTML5 table, not hand-collected.
        #
        # Decoding no longer stops at ASCII. A code point above 127 now has
        # a deterministic byte spelling on every awk CI runs, because
        # utf8_of below picks the emit primitive that is correct for the
        # implementation it is running on rather than assuming one of them
        # (see the measurement in its header comment). A named reference
        # outside BOTH tables — an expansion outside the Latin blocks, such
        # as `&Alpha;` — is still left encoded, which loses a match rather
        # than inventing one; the numeric spelling of the same character
        # decodes in full either way, so no character is unreachable, only
        # one SPELLING of an exotic one. That residual is catalogued on
        # #929 rather than paid for with the whole 2125-entry table.
        BEGIN {
          # Measured on BWK awk 20200816, gawk 5.4.1 and mawk 1.3.4: a
          # LITERAL multi-byte character in this source survives
          # byte-identically on all three, in both a UTF-8 locale and
          # LC_ALL=C. Its length() is therefore a reliable runtime probe of
          # whether THIS awk counts characters or bytes — and so of what
          # sprintf("%c", n) means above ASCII.
          REPLACEMENT = "�"
          CHAR_ORIENTED = (length(REPLACEMENT) == 1)
          refs = "Tab 9 NewLine 10 excl 33 QUOT 34 quot 34 num 35 dollar 36"
          refs = refs " percnt 37 AMP 38 amp 38 apos 39 lpar 40 rpar 41"
          refs = refs " ast 42 midast 42 plus 43 comma 44 period 46 sol 47"
          refs = refs " colon 58 semi 59 LT 60 lt 60 equals 61 GT 62 gt 62"
          refs = refs " quest 63 commat 64 lbrack 91 lsqb 91 bsol 92"
          refs = refs " rbrack 93 rsqb 93 Hat 94 UnderBar 95 lowbar 95"
          refs = refs " DiacriticalGrave 96 grave 96 lbrace 123 lcub 123"
          refs = refs " VerticalLine 124 verbar 124 vert 124 rbrace 125"
          refs = refs " rcub 125"
          n_refs = split(refs, named_ref, " ")
          for (i = 1; i < n_refs; i += 2) {
            # A named expansion is stored ONCE here and returned verbatim
            # later, so the newline flag utf8_of raises would be lost by the
            # time `&NewLine;` is actually resolved. Capture it now, against
            # the same predicate rather than a second list of code points,
            # and char_reference_at re-raises it on use.
            TARGET_DROP = 0
            NAMED_TEXT[named_ref[i]] = utf8_of(named_ref[i + 1] + 0)
            if (TARGET_DROP) NAMED_DROP[named_ref[i]] = 1
          }
          # The 46th: the only HTML5 named reference whose expansion is more
          # than one ASCII character. It has no code point to list above.
          NAMED_TEXT["fjlig"] = "fj"
          latin = "AElig 198 Aacute 193 Abreve 258 Acirc 194 Agrave 192"
          latin = latin " Amacr 256 Aogon 260 Aring 197 Atilde 195 Auml 196"
          latin = latin " COPY 169 Cacute 262 Ccaron 268 Ccedil 199 Ccirc 264"
          latin = latin " Cdot 266 Cedilla 184 CenterDot 183 Dcaron 270"
          latin = latin " DiacriticalAcute 180 Dot 168 DoubleDot 168"
          latin = latin " Dstrok 272 ENG 330 ETH 208 Eacute 201 Ecaron 282"
          latin = latin " Ecirc 202 Edot 278 Egrave 200 Emacr 274 Eogon 280"
          latin = latin " Euml 203 Gbreve 286 Gcedil 290 Gcirc 284 Gdot 288"
          latin = latin " Hcirc 292 Hstrok 294 IJlig 306 Iacute 205 Icirc 206"
          latin = latin " Idot 304 Igrave 204 Imacr 298 Iogon 302 Itilde 296"
          latin = latin " Iuml 207 Jcirc 308 Kcedil 310 Lacute 313 Lcaron 317"
          latin = latin " Lcedil 315 Lmidot 319 Lstrok 321 Nacute 323"
          latin = latin " Ncaron 327 Ncedil 325 NonBreakingSpace 160"
          latin = latin " Ntilde 209 OElig 338 Oacute 211 Ocirc 212"
          latin = latin " Odblac 336 Ograve 210 Omacr 332 Oslash 216"
          latin = latin " Otilde 213 Ouml 214 PlusMinus 177 REG 174"
          latin = latin " Racute 340 Rcaron 344 Rcedil 342 Sacute 346"
          latin = latin " Scaron 352 Scedil 350 Scirc 348 THORN 222"
          latin = latin " Tcaron 356 Tcedil 354 Tstrok 358 Uacute 218"
          latin = latin " Ubreve 364 Ucirc 219 Udblac 368 Ugrave 217"
          latin = latin " Umacr 362 Uogon 370 Uring 366 Utilde 360 Uuml 220"
          latin = latin " Wcirc 372 Yacute 221 Ycirc 374 Yuml 376 Zacute 377"
          latin = latin " Zcaron 381 Zdot 379 aacute 225 abreve 259"
          latin = latin " acirc 226 acute 180 aelig 230 agrave 224 amacr 257"
          latin = latin " angst 197 aogon 261 aring 229 atilde 227 auml 228"
          latin = latin " brvbar 166 cacute 263 ccaron 269 ccedil 231"
          latin = latin " ccirc 265 cdot 267 cedil 184 cent 162 centerdot 183"
          latin = latin " circledR 174 copy 169 curren 164 dcaron 271 deg 176"
          latin = latin " die 168 div 247 divide 247 dstrok 273 eacute 233"
          latin = latin " ecaron 283 ecirc 234 edot 279 egrave 232 emacr 275"
          latin = latin " eng 331 eogon 281 eth 240 euml 235 frac12 189"
          latin = latin " frac14 188 frac34 190 gbreve 287 gcirc 285"
          latin = latin " gdot 289 half 189 hcirc 293 hstrok 295 iacute 237"
          latin = latin " icirc 238 iexcl 161 igrave 236 ijlig 307 imacr 299"
          latin = latin " imath 305 inodot 305 iogon 303 iquest 191"
          latin = latin " itilde 297 iuml 239 jcirc 309 kcedil 311"
          latin = latin " kgreen 312 lacute 314 laquo 171 lcaron 318"
          latin = latin " lcedil 316 lmidot 320 lstrok 322 macr 175 micro 181"
          latin = latin " middot 183 nacute 324 napos 329 nbsp 160 ncaron 328"
          latin = latin " ncedil 326 not 172 ntilde 241 oacute 243 ocirc 244"
          latin = latin " odblac 337 oelig 339 ograve 242 omacr 333 ordf 170"
          latin = latin " ordm 186 oslash 248 otilde 245 ouml 246 para 182"
          latin = latin " plusmn 177 pm 177 pound 163 racute 341 raquo 187"
          latin = latin " rcaron 345 rcedil 343 reg 174 sacute 347"
          latin = latin " scaron 353 scedil 351 scirc 349 sect 167 shy 173"
          latin = latin " strns 175 sup1 185 sup2 178 sup3 179 szlig 223"
          latin = latin " tcaron 357 tcedil 355 thorn 254 times 215"
          latin = latin " tstrok 359 uacute 250 ubreve 365 ucirc 251"
          latin = latin " udblac 369 ugrave 249 umacr 363 uml 168 uogon 371"
          latin = latin " uring 367 utilde 361 uuml 252 wcirc 373"
          latin = latin " yacute 253 ycirc 375 yen 165 yuml 255 zacute 378"
          latin = latin " zcaron 382 zdot 380"
          n_latin = split(latin, latin_ref, " ")
          for (i = 1; i < n_latin; i += 2) {
            # Same capture as the ASCII table above. No Latin-1 name expands
            # to a newline today, so this raises nothing — it is here so the
            # two tables cannot drift into disagreeing about the rule.
            TARGET_DROP = 0
            NAMED_TEXT[latin_ref[i]] = utf8_of(latin_ref[i + 1] + 0)
            if (TARGET_DROP) NAMED_DROP[latin_ref[i]] = 1
          }
          TARGET_DROP = 0
        }
        # Encode a Unicode code point as the bytes a filename carries.
        #
        # NEITHER available primitive is portable on its own. Measured on
        # BWK awk 20200816, gawk 5.4.1 and mawk 1.3.4 in a UTF-8 locale:
        #
        #   sprintf("%c", 252)          BWK: fc   gawk: c3 bc   mawk: fc
        #   sprintf("%c",195) then 188  BWK: c3 bc   mawk: c3 bc
        #                               gawk: c3 83 c2 bc
        #   a literal "u-umlaut" here   ALL THREE: c3 bc
        #
        # gawk in a UTF-8 locale reads "%c" as a CODE POINT — so it emits
        # the right character for one, and DOUBLE-ENCODES a hand-built
        # byte. BWK awk and mawk read "%c" as a BYTE — so a hand-built
        # sequence is right and a code point above 127 comes out as its
        # Latin-1 byte. Each implementation therefore gets the primitive
        # that is correct FOR IT, selected by the CHAR_ORIENTED probe.
        # Both branches were measured to emit the same bytes for the same
        # code point, which is what makes this decode deterministic across
        # CI runners instead of implementation-defined.
        #
        # CR and LF are handled for a reason of this program rather than of
        # the spec: targets are emitted ONE PER LINE, so a decoded newline
        # would split a single destination into two records and the tail
        # could false-match an inventory path — a canonical doc linking
        # `prefix&NewLine;hub.md` reporting a reference to `hub.md` that no
        # reader can follow. (The reference parser keeps the newline and
        # percent-encodes it: `prefix%0Ahub.md`, one destination, still not
        # `hub.md`.)
        #
        # SUBSTITUTING a character cannot solve that, whichever character is
        # picked. U+FFFD was chosen on the claim that it "matches no declared
        # path", and that claim is false: U+FFFD is a legal pathname
        # character, so a hub-only doc named `prefix<U+FFFD>hub.md` was
        # matched by `prefix&NewLine;hub.md` and drew a false ownership
        # failure. Every substitute has some such name.
        #
        # So the destination is DROPPED instead of rewritten. A flag records
        # that a newline was decoded and normalize_target returns the empty
        # string, which the emit filter discards. That loses a match rather
        # than inventing one, and it cannot alias anything, because no value
        # is ever compared. Nothing true is lost either: the target and
        # inventory lists are newline-separated the whole way through this
        # program, so a path that genuinely contains a newline is not
        # representable in them to begin with.
        #
        # The out-of-range guard is defensive — char_reference_at rejects
        # those values before they reach here, and every table entry is a
        # valid code point.
        # NUL is dropped for the same reason and by the same flag. It is not
        # a newline, but it is likewise not a byte any pathname can carry, so
        # substituting for it can only alias: `%00.md` reported a hub-only
        # doc named `<U+FFFD>.md`, and the rendered URL still says `%00.md`.
        # Every OTHER control byte IS legal in a pathname, is emitted as
        # itself, and so needs none of this.
        function utf8_of(cp) {
          if (cp == 0) { TARGET_DROP = 1; return REPLACEMENT }
          if (cp <= 0 || cp > 1114111) return REPLACEMENT
          if (cp >= 55296 && cp <= 57343) return REPLACEMENT
          if (cp == 10 || cp == 13) { TARGET_DROP = 1; return REPLACEMENT }
          if (cp < 128 || CHAR_ORIENTED) return sprintf("%c", cp)
          if (cp < 2048) {
            return sprintf("%c%c", 192 + int(cp / 64), 128 + cp % 64)
          }
          if (cp < 65536) {
            return sprintf("%c%c%c", 224 + int(cp / 4096), \
                           128 + int(cp / 64) % 64, 128 + cp % 64)
          }
          return sprintf("%c%c%c%c", 240 + int(cp / 262144), \
                         128 + int(cp / 4096) % 64, \
                         128 + int(cp / 64) % 64, 128 + cp % 64)
        }
        function hex_value(c, p) {
          p = index("0123456789ABCDEF", toupper(c))
          return p ? p - 1 : -1
        }
        # Decode the character reference starting at s[i] (an "&"). Sets the
        # global REF_LEN to the source length consumed; REF_LEN 0 means "not
        # a character reference", and the caller emits the "&" literally.
        #
        # The length caps are EIGHT digits in either base, and they come from
        # the renderer rather than from the prose of the spec. § Entity and
        # numeric character references says 1-7 decimal and 1-6 hex — but
        # this check does not ask "is this reference well-spelled", it asks
        # "does a reader following this link land on a hub-only doc", and
        # that is answered by the parser that produces the href. Measured
        # against the commonmark preset of markdown-it-py 4.2.0 in
        # DESTINATION position: `hub&#00000046;md` and `hub&#x0000002E;md`
        # (eight digits each) both render as links to `hub.md`, and nine
        # digits in either base does not. Spelling the prose caps here left
        # both of those as a silent false negative — the reader reaches the
        # hub-only sibling and the scan compares the encoded spelling. The
        # caps are tested with length() rather than an {1,8} interval, which
        # not every awk implementation supports.
        #
        # NOTE: this whole awk program is a single-quoted shell string, so a
        # lone apostrophe in a comment ENDS it and bash then parses the awk
        # source as commands. Keep comments apostrophe-free.
        function char_reference_at(s, i,   rest, semi, body, digits, cp, k) {
          REF_LEN = 0
          REF_UNKNOWN_NAME = 0
          rest = substr(s, i)
          semi = index(rest, ";")
          if (semi < 3) return ""
          body = substr(rest, 2, semi - 2)
          if (substr(body, 1, 1) != "#") {
            if (!(body in NAMED_TEXT)) {
              # An unknown NAME is not the same thing as "not a reference",
              # and treating the two alike is the one failure mode this
              # program must not have. The tables above hold ASCII, Latin-1
              # Supplement and Latin Extended-A; HTML5 defines about 2100 more
              # names, and every one of them the renderer resolves and this
              # table does not was a SILENT MISS — the encoded spelling was
              # compared, matched nothing, and the reference was permitted.
              # Measured in destination position, markdown-it-py 4.2.0 and
              # cmark-gfm agreeing exactly:
              #
              #   [the audit](&alpha;.md)     both: href="%CE%B1.md"
              #   [the audit](&notaname;.md)  both: href="&amp;notaname;.md"
              #
              # So a hub-only doc actually named with that Greek letter was
              # reachable by every reader and invisible to check 10 (#929
              # item 31). Completing the table means about 2100 more names
              # including the multi-code-point expansions, in awk; failing
              # closed costs one flag and turns the MISS into a report the
              # author can act on, which is the direction a guardrail should
              # err in.
              #
              # The trigger is deliberately WIDER than HTML5: `&notaname;` is
              # reported too, although both renderers leave it literal, because
              # distinguishing the two needs exactly the table this avoids
              # embedding. It is bounded on the one axis that costs nothing —
              # HTML5 defines no single-character name, so `&x;` cannot be one
              # and is still read as literal text.
              #
              # Reported as a fact about THIS reference rather than raised on
              # the destination directly, because where in the destination it
              # sits decides whether it matters at all — see normalize_target.
              if (length(body) >= 2 && body ~ /^[A-Za-z][A-Za-z0-9]*$/) {
                REF_UNKNOWN_NAME = 1
              }
              return ""
            }
            REF_LEN = semi
            # The expansion was computed once at startup, so re-raise the
            # newline flag its construction recorded.
            if (body in NAMED_DROP) TARGET_DROP = 1
            return NAMED_TEXT[body]
          }
          digits = substr(body, 2)
          if (substr(digits, 1, 1) == "x" || substr(digits, 1, 1) == "X") {
            digits = substr(digits, 2)
            if (digits !~ /^[0-9A-Fa-f]+$/ || length(digits) > 8) return ""
            cp = 0
            for (k = 1; k <= length(digits); k++) {
              cp = cp * 16 + hex_value(substr(digits, k, 1))
            }
          } else {
            if (digits !~ /^[0-9]+$/ || length(digits) > 8) return ""
            cp = digits + 0
          }
          # Every code point that names a character decodes, so no numeric
          # reference to a real character is compared by its ENCODED
          # spelling any more — that was the false-negative path
          # `[audit](h&#252;b.md)` took to reach a hub-only `hüb.md`
          # unreported.
          #
          # A value the renderer rejects is NOT a character reference here,
          # and the "&" is emitted literally. The spec substitutes U+FFFD
          # for these, but that rule is written for reference-in-TEXT; in
          # DESTINATION position the reference parser leaves the source
          # untouched, and the destination reading is the one that decides
          # where a reader lands:
          #
          #   `[l](a&#0;b.md)`        text: a<U+FFFD>b   href: a&#0;b.md
          #   `[l](a&#xD800;b.md)`    text: a<U+FFFD>b   href: a&#xD800;b.md
          #
          # Following the destination reading keeps this checker aligned
          # with the parser whose output decides whether a link renders.
          if (!valid_entity_code(cp)) return ""
          REF_LEN = semi
          return utf8_of(cp)
        }
        # Which code points the RENDERER will decode. Rejecting a value here
        # means the reference stays literal source text, which is what the
        # renderer does with it — it does not substitute U+FFFD.
        #
        # Measured in DESTINATION position with the commonmark preset of
        # markdown-it-py 4.2.0, every range below is left literal:
        #
        #   U+0000-U+0008, U+000B, U+000E-U+001F  C0 except tab, LF, FF, CR
        #   U+007F-U+009F                         DEL and the C1 range
        #   U+D800-U+DFFF                         surrogates
        #   U+FDD0-U+FDEF                         noncharacters
        #   any value whose low 16 bits are FFFE or FFFF
        #   above U+10FFFF                        out of range
        #
        # Only the surrogate and out-of-range rows were rejected before, so
        # `&#128;` decoded to a character the renderer never emits. That is a
        # divergence in the false-NEGATIVE direction: a hub-only doc whose
        # name carries the literal spelling is reachable by a reader and
        # invisible to the scan. The C1 range is where this bites hardest,
        # because HTML5 remaps it (`&#128;` to EURO) while CommonMark does
        # neither the remap nor the decode — so neither an HTML5 table nor a
        # plain decode matches the renderer, and leaving it literal does.
        function valid_entity_code(cp,   low) {
          if (cp <= 8 || cp == 11) return 0
          if (cp >= 14 && cp <= 31) return 0
          if (cp >= 127 && cp <= 159) return 0
          if (cp >= 55296 && cp <= 57343) return 0
          if (cp >= 64976 && cp <= 65007) return 0
          if (cp > 1114111) return 0
          low = cp % 65536
          if (low == 65534 || low == 65535) return 0
          return 1
        }
        # A percent-escape names a BYTE; utf8_of emits whatever unit the
        # running awk counts. On a byte-oriented awk the two coincide, so
        # sprintf("%c", byte) per escape was right. On a character-oriented
        # awk it is not: gawk reads sprintf("%c", 195) as the CHARACTER
        # U+00C3, so `%C3%B8` decoded one byte at a time became U+00C3 U+00B8
        # — the double-encoded spelling of the same name. It compares unequal
        # both to the literal filename and to the `&#248;` spelling, which
        # made this verdict depend on which awk CI happened to run.
        #
        # An escape RUN is therefore buffered as byte values and UTF-8
        # decoded to code points, and every code point is emitted through
        # utf8_of — the one place that knows what a character is on this awk.
        # A byte that is not part of a well-formed sequence (a stray
        # continuation, a truncated run, an overlong lead) DROPS the whole
        # destination, by the same reasoning as the decoded newline below:
        # U+FFFD is a legal pathname character, so emitting it and comparing
        # anyway lets `%FFhub.md` match a hub-only doc really named
        # `<U+FFFD>hub.md` and invent an ownership failure — while the href
        # a reader follows still says `%FF`, whose byte is not the UTF-8
        # spelling of that name. U+FFFD is still written into the decoded
        # text so the shape of the rest of the run is preserved; the flag,
        # not the character, is what keeps the value from being compared.
        # That also gives percent-escapes the CR/LF handling the reference
        # decoder already has, for the same one-destination-per-record
        # reason.
        function decode_escape_run(n,   out, k, b, cp, need, j, ok) {
          out = ""
          k = 1
          while (k <= n) {
            b = ESC_BYTE[k]
            need = -1
            if (b < 128) { cp = b; need = 0 }
            else if (b >= 194 && b <= 223) { cp = b - 192; need = 1 }
            else if (b >= 224 && b <= 239) { cp = b - 224; need = 2 }
            else if (b >= 240 && b <= 244) { cp = b - 240; need = 3 }
            if (need < 0 || k + need > n) {
              out = out REPLACEMENT
              TARGET_DROP = 1
              k++
              continue
            }
            ok = 1
            for (j = 1; j <= need; j++) {
              b = ESC_BYTE[k + j]
              if (b < 128 || b > 191) { ok = 0; break }
              cp = cp * 64 + (b - 128)
            }
            # A continuation-byte range check is not UTF-8 well-formedness.
            # Unicode Table 3-7 also bounds the SCALAR each sequence LENGTH
            # may carry, and a decoder that skips that bound invents a
            # character no reader ever sees. %E0%81%81 is an overlong
            # spelling: the bytes are malformed and the renderer yields
            # replacement characters, but decoding by continuation range
            # alone produced 65, so a hub-only doc named A.md drew a false
            # ownership failure from a link nobody can follow.
            #
            # The two-byte minimum is already enforced by the lead-byte
            # range above, where 194 excludes the overlong C0 and C1 leads.
            # The three- and four-byte minima, the surrogate range and the
            # U+10FFFF ceiling have to be spelled out here.
            if (ok && need == 2 && cp < 2048) ok = 0
            if (ok && need == 3 && cp < 65536) ok = 0
            if (ok && cp >= 55296 && cp <= 57343) ok = 0
            if (ok && cp > 1114111) ok = 0
            if (!ok) {
              out = out REPLACEMENT
              TARGET_DROP = 1
              k++
              continue
            }
            out = out utf8_of(cp)
            k += need + 1
          }
          return out
        }
        function percent_decode(s,   out, i, c, hi, lo, n) {
          out = ""
          n = 0
          for (i = 1; i <= length(s); i++) {
            c = substr(s, i, 1)
            if (c == "%" && i + 2 <= length(s)) {
              hi = hex_value(substr(s, i + 1, 1))
              lo = hex_value(substr(s, i + 2, 1))
              if (hi >= 0 && lo >= 0) {
                n = n + 1
                ESC_BYTE[n] = hi * 16 + lo
                i += 2
                continue
              }
            }
            if (n > 0) {
              out = out decode_escape_run(n)
              n = 0
            }
            out = out c
          }
          if (n > 0) out = out decode_escape_run(n)
          return out
        }
        # Backslash escapes and character references are resolved in ONE
        # left-to-right pass, because CommonMark resolves them together and
        # re-reads neither result as syntax. Two separate passes get both
        # directions wrong: an escaped ampersand (`\&#46;`, which renders
        # literally) would decode anyway, and `&#38;#46;` — an escaped
        # ampersand written as a reference — would decode twice into a `.`
        # the reader never sees.
        function unescape_and_decode(s,   out, i, c, nextc, decoded) {
          out = ""
          i = 1
          while (i <= length(s)) {
            c = substr(s, i, 1)
            if (c == "\\") {
              nextc = substr(s, i + 1, 1)
              if (nextc != "" && index(ASCII_PUNCT, nextc) > 0) {
                out = out nextc
                i += 2
                continue
              }
              out = out c
              i++
              continue
            }
            if (c == "&") {
              decoded = char_reference_at(s, i)
              if (REF_LEN > 0) {
                out = out decoded
                i += REF_LEN
                continue
              }
              # Record WHERE the first unexpandable name lands in the decoded
              # destination. normalize_target needs the position, not just the
              # fact, because a name in the query or fragment does not change
              # the PATH this program compares.
              if (REF_UNKNOWN_NAME && !TARGET_UNRESOLVED) {
                TARGET_UNRESOLVED = 1
                TARGET_UNRESOLVED_AT = length(out) + 1
              }
            }
            out = out c
            i++
          }
          return out
        }
        function normalize_target(s,   cut) {
          # Reset per destination: the flag is set by utf8_of when a decoded
          # CR or LF appears anywhere in THIS destination, in a character
          # reference or a percent escape alike. TARGET_UNRESOLVED is the
          # same shape, raised by char_reference_at for a named reference this
          # program cannot expand.
          TARGET_DROP = 0
          TARGET_UNRESOLVED = 0
          TARGET_UNRESOLVED_AT = 0
          s = unescape_and_decode(s)
          # URL parsing recognizes raw query/fragment delimiters before
          # percent decoding, so encoded %3F/%23 remain filename bytes. A
          # character reference is resolved BEFORE the URL is read, though,
          # so a `&#63;` really does start a query string — which is why the
          # decode above runs first.
          #
          # An unexpandable name is only worth reporting when it is in the
          # PATH, which is the only part this program compares. Both
          # renderers percent-encode `hub.md#&alpha;section` to
          # `hub.md#%CE%B1section`: the fragment changes, the path stays
          # `hub.md`, and reporting the destination as unverifiable would be a
          # false positive on a link that resolves perfectly (CodeRabbit,
          # #925). The delimiter position is taken BEFORE the strip, and an
          # unknown name at or past it is dropped.
          cut = match(s, /[?#]/)
          if (TARGET_UNRESOLVED && cut > 0 && TARGET_UNRESOLVED_AT >= cut) {
            TARGET_UNRESOLVED = 0
          }
          sub(/[?#].*$/, "", s)
          s = percent_decode(s)
          if (TARGET_DROP) return ""
          return s
        }
        # `EMIT` picks the stream. Empty (the default) is the resolved
        # destination, one per line, which is what check 10 compares against
        # the inventory. `unresolvable` is the destination AS WRITTEN, and
        # only for the ones normalize_target could not fully resolve.
        #
        # Two passes over one extractor rather than one pass with a marker
        # line mixed into the default stream: any marker is a string that some
        # real destination could also decode to, and a decoded control byte is
        # no safer — every control byte except NUL, CR and LF is a legal
        # pathname byte here and is emitted as itself. A separate stream
        # cannot alias anything.
        # The blank-line filter lives here rather than in a trailing
        # `grep -v ... || true`, and that placement is load-bearing. A `grep`
        # last in the pipeline exits 1 whenever it filters everything out,
        # which is an ORDINARY outcome (a doc with no destinations at all), so
        # the `|| true` that covered it also covered a producer that DIED. The
        # consequence is measurable on this program: restore the recursion the
        # classifier used to use, hand it a document deep enough to segfault
        # BWK awk, and check 10 prints a clean PASS on a document it could not
        # read. With the filter moved inside, the last stage is this awk and
        # its exit status means what it says.
        # The destinations check 10 never compares. Spelled to mirror the
        # shell `case` in that loop character for character — `''|*://*|
        # mailto:*|//*` — because the two lists saying different things is the
        # whole defect this guards: an absolute URL cannot resolve to a
        # repo-local doc, so an unexpandable name inside one hides nothing,
        # and reporting it blocks a portable canonical doc for no gain (Codex
        # P2 on #925). The empty case covers a destination dropped for a
        # decoded newline or NUL, which the target pass discards as well.
        function skipped_by_check_10(t) {
          return (t == "" || index(t, "://") > 0 \
                  || substr(t, 1, 7) == "mailto:" || substr(t, 1, 2) == "//")
        }
        function emit_target(decoded, raw) {
          if (EMIT == "unresolvable") {
            if (TARGET_UNRESOLVED && !skipped_by_check_10(decoded)) print raw
            return
          }
          if (decoded ~ /^[[:space:]]*$/) return
          print decoded
        }
        {
          sub(/^[[:space:]]+/, "")
          if (substr($0, 1, 1) == "<") {
            gt = index($0, ">")
            if (gt > 1) {
              # The destination AS WRITTEN is the angle wrapper, not the whole
              # line: a reference definition may carry a title after it, and
              # quoting `<x.md> "Title"` as the destination names something
              # the author did not write. The bare branch below already trims
              # at the first space; this is the same trim.
              emit_target(normalize_target(substr($0, 2, gt - 2)), \
                          substr($0, 1, gt))
              next
            }
          }
          sub(/[[:space:]].*$/, "")
          emit_target(normalize_target($0), $0)
        }
      '
}

# The destinations of `$1` that carry a named character reference this program
# cannot expand, emitted AS WRITTEN so the diagnostic can quote what the author
# typed. See char_reference_at for why an unknown name is reported rather than
# compared in its encoded spelling.
mp_doc_unresolvable_destinations() {
  mp_doc_link_targets "$1" unresolvable
}

# Resolve a link target against the directory of the document carrying
# it, collapsing '.' and '..' lexically, and print the repo-relative
# result. A leading '/' is read as repo-root-absolute (that is how these
# docs are written, and it is also what GitHub's blob view does for a
# root-relative href within one repo). A target that climbs above the
# repo root keeps its leading '..' segments, so it simply never equals a
# declared doc path — which is the correct outcome, not a crash.
mp_resolve_relative() {
  local base="$1" target="$2" combined out="" seg rest
  case "$target" in
    /*) combined="${target#/}" ;;
    *)
      case "$base" in
        ""|".") combined="$target" ;;
        *)      combined="$base/$target" ;;
      esac
      ;;
  esac
  rest="$combined"
  while [ -n "$rest" ]; do
    seg="${rest%%/*}"
    if [ "$seg" = "$rest" ]; then rest=""; else rest="${rest#*/}"; fi
    case "$seg" in
      ''|'.') continue ;;
      '..')
        case "$out" in
          ''|'..'|*'/..') out="${out:+$out/}.." ;;
          */*)            out="${out%/*}" ;;
          *)              out="" ;;
        esac
        ;;
      *) out="${out:+$out/}$seg" ;;
    esac
  done
  printf '%s' "$out"
}

# Blank out every sanctioned absolute reference on stdin, replacing each
# with a single space. Used by check 10's literal pass.
#
# The sanctioned escape hatch from that check is an absolute URL —
# `https://github.com/<org>/mergepath/blob/main/<path>` resolves from any
# repo — but such a URL CONTAINS the repo-relative path as a substring,
# so a literal search has to tell the two apart. Masking the reference
# and re-testing the remainder does that per OCCURRENCE. The earlier
# exemption did it per LINE, which is not the same thing: a sentence
# spelling the path BOTH ways —
#
#     Full procedure: `docs/agents/hub.md` ([hub copy](https://github.com/.../docs/agents/hub.md))
#
# — was exempted wholesale by its own absolute half, so the bare
# repo-relative mention beside it went unreported (#797 review). The
# resolved-target pass does not recover that case, because a path in
# prose or inline code is not a link and yields no target.
#
# TWO substitutions, in this order:
#
#   1. A whole inline link whose DESTINATION is absolute. The label is
#      masked along with the destination, because REVIEW_POLICY.md's
#      real spelling of the escape hatch puts the repo-relative path in
#      the LABEL and the hub URL in the destination — a link that clicks
#      through correctly from any repo. Masking only the destination
#      would red the very idiom this check tells authors to use.
#   2. Any remaining bare absolute URL, including a `<...>` autolink and
#      the destination half of a reference definition.
#
# Both key on the SCHEME, not on `github.com`, so an absolute URL is
# treated here the same way the resolved pass already treats one (it
# skips `*://*` targets as already-absolute). A bare URL run ends at
# whitespace or at any delimiter that cannot appear in a bare URL in
# this prose: the autolink brackets `<`/`>`, the inline-link parens,
# `[`/`]`, a quote, or a backtick. Replacing with a space rather than
# nothing keeps the two sides of a mask from fusing into a path that was
# never written.
#
# What is deliberately NOT masked: a link whose destination is relative.
# Its label may spell the path too, but the destination itself is the
# defect, and the resolved pass reports it.
mp_mask_absolute_urls() {
  sed -E \
    -e 's,\[[^]]*\]\([[:space:]]*<?([a-zA-Z][a-zA-Z0-9+.-]*://|//)[^)]*\), ,g' \
    -e 's,[a-zA-Z][a-zA-Z0-9+.-]*://[^][:space:]<>()"'"'"'`]*, ,g' \
    -e 's,(^|[[:space:]<(])//[^][:space:]<>()"'"'"'`]*,\1 ,g'
}

# Mask reference-style link USES whose definition has an absolute
# destination. The literal pass permits the repo-relative path in a
# link label when the destination is portable (the same rule as an
# inline `[path](https://...)` link), but a definition can live on a
# different line:
#
#     [docs/agents/hub.md][audit]
#     [audit]: https://github.com/.../docs/agents/hub.md
#
# A URL-only mask removes the definition's destination but leaves the
# visible label behind as a false repo-relative hit. Read the file twice:
# first collect absolute reference definitions (same-line or wrapped),
# then blank only the corresponding full/collapsed/shortcut link uses.
# Definition labels themselves stay intact; mp_mask_absolute_urls masks
# their destination in the next stage.
mp_mask_absolute_reference_links() {
  local f="$1"
  awk '
    function norm_label(s) {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", s)
      gsub(/[[:space:]]+/, " ", s)
      return tolower(s)
    }
    function first_target(s, t) {
      sub(/^[[:space:]]+/, "", s)
      t = s
      sub(/[[:space:]].*$/, "", t)
      sub(/^</, "", t)
      sub(/>$/, "", t)
      return t
    }
    function is_absolute(t) {
      return t ~ /^[A-Za-z][A-Za-z0-9+.-]*:\/\// || t ~ /^\/\// || t ~ /^mailto:/
    }
    NR == FNR {
      line = $0
      if (pending != "") {
        label = pending
        pending = ""
        if (line ~ /^[[:space:]]*$/) next
        target = first_target(line)
        if (is_absolute(target)) absolute[norm_label(label)] = 1
        next
      }

      indent = match(line, /[^[:space:]]/) - 1
      if (indent < 0 || indent > 3) next
      work = line
      sub(/^[[:space:]]*/, "", work)
      if (work !~ /^\[[^]]+\]:/) next
      label = work
      sub(/^\[/, "", label)
      sub(/\].*$/, "", label)
      rest = work
      sub(/^\[[^]]+\]:[[:space:]]*/, "", rest)
      if (rest == "") {
        pending = label
      } else {
        target = first_target(rest)
        if (is_absolute(target)) absolute[norm_label(label)] = 1
      }
      next
    }
    {
      line = $0
      out = ""

      # Full and collapsed references: [visible][id] / [visible][].
      while (match(line, /\]\[[^]]*\]/)) {
        before = substr(line, 1, RSTART - 1)
        token = substr(line, RSTART, RLENGTH)
        open = 0
        for (i = length(before); i >= 1; i--) {
          if (substr(before, i, 1) == "[") { open = i; break }
        }
        if (open == 0) {
          out = out substr(line, 1, RSTART + RLENGTH - 1)
          line = substr(line, RSTART + RLENGTH)
          continue
        }
        visible = substr(before, open + 1)
        label = substr(token, 3, length(token) - 3)
        if (label == "") label = visible
        consumed = RSTART + RLENGTH - 1
        if (absolute[norm_label(label)]) {
          out = out substr(before, 1, open - 1) " "
        } else {
          out = out substr(line, 1, consumed)
        }
        line = substr(line, consumed + 1)
      }
      line = out line

      # Shortcut references: [id]. Do not mask the definition [id]:.
      out = ""
      while (match(line, /\[[^]]+\]/)) {
        token = substr(line, RSTART, RLENGTH)
        label = substr(token, 2, length(token) - 2)
        after = substr(line, RSTART + RLENGTH, 1)
        if (absolute[norm_label(label)] && after != ":") {
          out = out substr(line, 1, RSTART - 1) " "
        } else {
          out = out substr(line, 1, RSTART + RLENGTH - 1)
        }
        line = substr(line, RSTART + RLENGTH)
      }
      print out line
    }
  ' "$f" "$f"
}

# ─────────────────────────────────────────────────────────────────────
# 1. `doc_ownership:` shape.
# ─────────────────────────────────────────────────────────────────────
#
# Same fail-closed extraction idiom as the sibling checks: assert the
# YAML tag is a sequence FIRST. A scalar `doc_ownership: oops` would let
# `.doc_ownership[]` iterate garbage while yq still exits 0, so the loop
# below would run zero times and the check would report PASS on a
# manifest with no inventory at all.
ownership_tag=$(yq '.doc_ownership | tag' "$MANIFEST" 2>/dev/null || echo "")
if [ "$ownership_tag" = "!!null" ]; then
  echo "FAIL: .mergepath-sync.yml has no 'doc_ownership:' block — every docs/agents/*.md must carry exactly one ownership class (canonical / per-repo-owned / hub-only). See the doc_ownership comment block in the manifest (#780)."
  echo "check_doc_ownership: FAIL"
  exit 1
fi
if [ "$ownership_tag" != "!!seq" ]; then
  echo "FAIL: .doc_ownership must be a list (got YAML tag '$ownership_tag')"
  echo "check_doc_ownership: FAIL"
  exit 1
fi

# One compact JSON object per entry. Do not use newline-delimited field
# joins here: `note:` is free text and YAML literal/folded style may
# contain embedded newlines, which would split one inventory row into
# multiple bogus shell loop records.
if ! ownership_rows=$(yq -o=json -I=0 '.doc_ownership[]' "$MANIFEST" 2>&1); then
  echo "FAIL: could not extract .doc_ownership from the manifest (yq error):"
  printf '%s\n' "$ownership_rows"
  echo "check_doc_ownership: FAIL"
  exit 1
fi

# ─────────────────────────────────────────────────────────────────────
# Manifest `paths:` snapshot, for checks 7 and 8.
# ─────────────────────────────────────────────────────────────────────
#
# type|path|dest|source per row. A missing `.paths` is tolerated here
# (check_sync_manifest owns that failure); the effect is an empty
# snapshot, which makes check 7 flag every non-pending canonical doc —
# fail-closed in the right direction.
if ! path_rows=$(yq -o=json -I=0 '(.paths // [])[]' "$MANIFEST" 2>&1); then
  echo "FAIL: could not extract .paths from the manifest (yq error):"
  printf '%s\n' "$path_rows"
  echo "check_doc_ownership: FAIL"
  exit 1
fi

# Comma-joined, sentinel-padded sets so a substring lookup cannot
# false-match a path prefix (",a/b," never matches inside ",a/bc,").
canonical_exact=","
verbatim_exact=","
verbatim_kit_dirs=""
verbatim_repo_root_kit=0
templated_self_source_exact=","
if [ -n "$path_rows" ]; then
  while IFS= read -r path_row; do
    [ -z "$path_row" ] && continue
    p_type=$(yq -r '.type // ""' <<< "$path_row")
    p_path=$(yq -r '.path // ""' <<< "$path_row")
    p_dest=$(yq -r '.dest // ""' <<< "$path_row")
    p_source=$(yq -r '.source // ""' <<< "$path_row")
    p_consumers=$(yq -r '(.consumers // "") | tostring' <<< "$path_row")
    [ -z "$p_type$p_path" ] && continue

    unsafe_field=""
    unsafe_value=""
    for field in path dest source; do
      case "$field" in
        path) value="$p_path" ;;
        dest) value="$p_dest" ;;
        source) value="$p_source" ;;
      esac
      if [ -n "$value" ] && mp_path_is_unsafe "$value"; then
        unsafe_field="$field"
        unsafe_value="$value"
        break
      fi
    done
    if [ -n "$unsafe_field" ]; then
      echo "FAIL: paths entry '$p_path' has unsafe $unsafe_field '$unsafe_value' — absolute paths and '..' segments are not allowed; embedded '.'/empty segments and commas are also rejected"
      FAILED=1
      continue
    fi

    n_path=$(mp_normalize_path "$p_path")
    n_dest=$(mp_normalize_path "${p_dest:-$p_path}")
    n_source=$(mp_normalize_path "${p_source:-$p_path}")
    if [ "$p_type" = "canonical" ] && [ "$p_consumers" = "all" ]; then
      # The canonical propagation engine enumerates and materializes `.path`;
      # it does not honor `dest`. Reject a real remap instead of recording a
      # destination the engine will never write.
      if [ -n "$p_dest" ] && [ "$n_dest" != "$n_path" ]; then
        echo "FAIL: canonical manifest entry '$p_path' remaps dest to '$p_dest', but canonical propagation writes only the entry path — remove the unsupported dest remap"
        FAILED=1
      else
        canonical_exact="${canonical_exact}${n_path},"
      fi
    fi
    if [ "$p_type" = "templated" ] && [ "$n_source" = "$n_dest" ]; then
      templated_self_source_exact="${templated_self_source_exact}${n_dest},"
    fi
    if [ "$p_type" = "canonical" ] || [ "$p_type" = "kit" ]; then
      verbatim_exact="${verbatim_exact}${n_path},${n_dest},${n_source},"
      if [ "$p_type" = "kit" ]; then
        for d in "$n_path" "$n_dest" "$n_source"; do
          if [ "$d" = "." ]; then
            verbatim_repo_root_kit=1
          else
            verbatim_kit_dirs="${verbatim_kit_dirs}${d}"$'\n'
          fi
        done
      fi
    fi
  done <<< "$path_rows"
fi

# Is $1 verbatim-mirrored by a canonical/kit entry? Echoes the reason.
verbatim_hit() {
  local doc="$1"
  case "$verbatim_exact" in
    *",$doc,"*) printf 'direct'; return 0 ;;
  esac
  if [ "$verbatim_repo_root_kit" = "1" ]; then
    printf 'repo-root-kit'; return 0
  fi
  local d
  while IFS= read -r d; do
    [ -z "$d" ] && continue
    case "$doc/" in
      "$d/"*) printf 'kit-contains(%s)' "$d"; return 0 ;;
    esac
  done <<< "$verbatim_kit_dirs"
  return 1
}

# ─────────────────────────────────────────────────────────────────────
# 2-4, 6-8: per-entry validation.
# ─────────────────────────────────────────────────────────────────────
declared=","
# Symlinks rejected during per-entry validation, so the exhaustive on-disk
# scan below can avoid printing the same diagnostic twice while still finding
# undeclared links independently of file type.
rejected_symlinks=","
# Newline-separated paths per class, collected only for entries that
# survive validation above — check 10 must not reason about an entry the
# loop already rejected.
canonical_docs=""
hub_only_docs=""
if [ -n "$ownership_rows" ]; then
  while IFS= read -r ownership_row; do
    [ -z "$ownership_row" ] && continue
    doc_path=$(yq -r '.path // ""' <<< "$ownership_row")
    doc_class=$(yq -r '.class // ""' <<< "$ownership_row")
    doc_pending_present=$(yq -r 'has("pending_manifest")' <<< "$ownership_row")
    doc_pending_tag=$(yq -r '.pending_manifest | tag' <<< "$ownership_row")
    doc_pending=$(yq -r '.pending_manifest // false' <<< "$ownership_row")
    doc_note=$(yq -r '(.note // "") | tostring' <<< "$ownership_row")

    if [ -z "$doc_path" ]; then
      echo "FAIL: doc_ownership entry has an empty 'path'"
      FAILED=1
      continue
    fi

    if mp_path_is_unsafe "$doc_path"; then
      echo "FAIL: doc_ownership entry '$doc_path' is unsafe — absolute paths and '..' segments are not allowed; embedded '.'/empty segments and commas are also rejected"
      FAILED=1
      continue
    fi

    # 2: closed class set.
    class_ok=0
    for c in $VALID_CLASSES; do
      [ "$doc_class" = "$c" ] && class_ok=1 && break
    done
    if [ "$class_ok" != "1" ]; then
      echo "FAIL: doc_ownership entry '$doc_path' has class '$doc_class' — must be exactly one of: $VALID_CLASSES"
      FAILED=1
      continue
    fi

    norm_doc=$(mp_normalize_path "$doc_path")

    # 3a: scope. The inventory is defined over Markdown files anywhere
    # under docs/agents/; a path outside it would create the illusion of
    # coverage the on-disk scan below never cross-checks.
    case "$norm_doc" in
      docs/agents/*.md) ;;
      *)
        echo "FAIL: doc_ownership entry '$doc_path' is outside the inventory's scope — every entry must be a 'docs/agents/*.md' path"
        FAILED=1
        continue
        ;;
    esac

    # 4: duplicate declaration = the "more than one class" case.
    case "$declared" in
      *",$norm_doc,"*)
        echo "FAIL: '$norm_doc' is declared more than once in doc_ownership — a doc must belong to EXACTLY one class"
        FAILED=1
        continue
        ;;
    esac
    declared="${declared}${norm_doc},"

    if [ "$doc_pending_present" = "true" ] && [ "$doc_pending_tag" != "!!bool" ]; then
      echo "FAIL: '$norm_doc' has pending_manifest with YAML type '$doc_pending_tag' — pending_manifest must be a YAML boolean, not a quoted string or another scalar"
      FAILED=1
      continue
    fi

    # A doc ownership entry describes repository content, not an indirection
    # whose target can leave the tree or carry a different Git mode. `-f`
    # follows symlinks, so reject them before the ordinary stale-entry test.
    if [ -L "$REPO_ROOT/$norm_doc" ]; then
      echo "FAIL: '$norm_doc' is a symbolic link — docs/agents ownership entries must be regular Markdown files so bootstrap and canonical propagation agree on both content and Git mode"
      rejected_symlinks="${rejected_symlinks}${norm_doc},"
      FAILED=1
      continue
    fi

    # 3b: stale entry.
    if [ ! -f "$REPO_ROOT/$norm_doc" ]; then
      echo "FAIL: doc_ownership declares '$norm_doc' but that file does not exist in this repo — remove the stale entry or restore the file"
      FAILED=1
      continue
    fi

    # 6: pending_manifest hygiene.
    if [ "$doc_pending" = "true" ]; then
      if [ "$doc_class" != "canonical" ]; then
        echo "FAIL: '$norm_doc' sets pending_manifest: true with class '$doc_class' — the flag records a canonical doc whose paths: entry has not landed yet, so it is meaningful only on class 'canonical'"
        FAILED=1
      elif [ -z "$doc_note" ]; then
        echo "FAIL: '$norm_doc' sets pending_manifest: true without a 'note:' — the transitional debt must name the follow-up that lands the paths: entry"
        FAILED=1
      fi
    fi

    case "$doc_class" in
      canonical) canonical_docs="${canonical_docs}${norm_doc}"$'\n' ;;
      hub-only)  hub_only_docs="${hub_only_docs}${norm_doc}"$'\n' ;;
    esac

    # 7 / 8: class ↔ manifest consistency.
    if [ "$doc_class" = "canonical" ]; then
      case "$canonical_exact" in
        *",$norm_doc,"*) ;;
        *)
          if [ "$doc_pending" != "true" ]; then
            echo "FAIL: '$norm_doc' is classified canonical but has no 'type: canonical' paths entry with 'consumers: all' in the manifest — an unbacked or subset-only canonical claim does not propagate verbatim to the full fleet, so consumers silently do not have it. Add a fleet-wide 'type: canonical' paths entry, or declare 'pending_manifest: true' with a note naming the follow-up."
            FAILED=1
          fi
          ;;
      esac
    else
      case "$templated_self_source_exact" in
        *",$norm_doc,"*)
          echo "FAIL: '$norm_doc' is classified $doc_class but is the effective source and destination of a templated manifest entry — rendering a noncanonical document from itself still clobbers each repo's own copy. Use a purpose-built template source outside the destination path, or drop the templated entry."
          FAILED=1
          ;;
      esac
      if hit=$(verbatim_hit "$norm_doc"); then
        echo "FAIL: '$norm_doc' is classified $doc_class but is VERBATIM-mirrored by a canonical/kit manifest entry ($hit) — a verbatim mirror clobbers each repo's own copy on the next propagation wave (the #744 failure). Drop the mirror, or reclassify the doc."
        FAILED=1
      fi
    fi
  done <<< "$ownership_rows"
fi

# ─────────────────────────────────────────────────────────────────────
# 5: every Markdown file under docs/agents/ is declared (the "zero classes" case).
# ─────────────────────────────────────────────────────────────────────
DOCS_DIR="$REPO_ROOT/docs/agents"
if [ -d "$DOCS_DIR" ]; then
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    rel="${f#"$REPO_ROOT"/}"
    if [ -L "$f" ]; then
      case "$rejected_symlinks" in
        *",$rel,"*) ;;
        *)
          echo "FAIL: '$rel' is a symbolic link — every docs/agents/*.md path must be a regular Markdown file, not an indirection outside the ownership inventory"
          FAILED=1
          ;;
      esac
      continue
    fi
    case "$declared" in
      *",$rel,"*) ;;
      *)
        echo "FAIL: '$rel' has NO ownership class — add a doc_ownership entry to .mergepath-sync.yml declaring exactly one of: $VALID_CLASSES (see the doc_ownership comment block for what each class means, #780)."
        FAILED=1
        ;;
    esac
    # `find -print` + read is intentional over a glob: it tolerates a
    # missing dir and does not silently yield the literal pattern when
    # nothing matches.
  done < <(find "$DOCS_DIR" \( -type f -o -type l \) -name '*.md' | LC_ALL=C sort)
fi

# ─────────────────────────────────────────────────────────────────────
# 9: drift guard against check_sync_manifest's IDENTITY_DOCS_DENYLIST.
# ─────────────────────────────────────────────────────────────────────
#
# The denylist and this inventory state the same governance fact from two
# directions ("must not be verbatim-mirrored" vs "is not canonical"). If
# a docs/agents/ path is on the denylist, classifying it canonical here
# is a contradiction: check 7 would demand a paths: entry that
# check_sync_manifest check 8 refuses to accept. Catch the contradiction
# at the declaration, not two checks later.
#
# The denylist lives in the SIBLING check, so read it from there rather
# than restating it (a second copy is the drift this guard exists to
# prevent). Soft-skip if the sibling or its array is absent: this guard
# is a consistency net over another check's data, and it must not be the
# thing that reds CI when that check is mid-refactor.
#
# The array body is Bash source, so read it the way Bash would rather
# than trusting today's incidental formatting. Trimming whitespace alone
# was not enough: the moment an entry is written `"docs/agents/x.md"` —
# ordinary, idiomatic Bash — the leading quote makes the
# `docs/agents/*` case below miss it, and the contradiction this guard
# advertises is silently skipped instead of reported.
#
# The reader below is therefore a character-level state machine over the
# declaration rather than a set of line-shaped rules. Its state — the
# token being built, the quote mode, and a stack of open shell
# constructs — persists across newlines, because to Bash an array element
# is not a line-bounded thing. Three blind spots (#786 round 2) all
# traced back to state discarded at the end of a line, at a paren, or at
# the end of the first declaration:
#
#   * `"docs/agents/iden\` + newline + `tity.md"` is ONE element to Bash,
#     which deletes a backslash-newline inside quotes and out. Resetting
#     at the newline split it into two fragments, neither of which names
#     a file, so the denylisted doc was silently skipped.
#   * `$(helper)` ends no array — that `)` closes the substitution.
#     Taking it for the array terminator stopped the read early and
#     handed back the truncated prefix as an all-clear, so every static
#     entry below it went unread.
#   * a later `IDENTITY_DOCS_DENYLIST=(...)` REPLACES the earlier value
#     and `+=(...)` appends to it. Reading only the first declaration
#     both missed entries a reassignment added and kept enforcing entries
#     a reassignment removed.
#
# The rules the machine implements, all of them Bash's: unquoted
# whitespace separates words; single and double quotes suppress that (and
# are dropped, not kept); a backslash escapes the next character, and a
# backslash before a newline joins the lines into one word; `$(`, `${`
# and a backtick open a construct whose contents can neither split a word
# nor end the array; the array ends at the first `)` that is unquoted and
# outside any such construct, wherever on the line it falls; a `#` that
# begins a word starts a comment that runs to end of line (a `#` mid-word
# is a literal); and the last `=` assignment wins, with `+=` appending to
# it.
#
# That paren rule is what scopes the read to one declaration. An earlier
# version keyed the end of the array off `/^\)/`, which only recognizes a
# closing paren in column 1 — so an indented `  )`, or a
# `DENYLIST=(a b)` written on one line, left the reader "inside" for the
# remainder of the file and turned every later token into denylist data
# (1326 tokens read instead of 12, measured against today's sibling).
# The same shape also silently DROPPED any element sharing the opening
# line, because that line was consumed by the declaration match alone.
#
# Deliberate limits, so the guard degrades safely rather than guessing.
# Nothing is expanded: an element spelled with a variable, a glob or a
# command substitution is read as literal text, matches no file on disk,
# and is skipped by the existence check below — but the reader now SAYS
# so, because a denylist that could only be read in part must not be
# reported as a clean one. Elements are buffered rather than streamed and
# are printed only once the array actually closes, so a declaration left
# open by an unbalanced quote yields a note and no denylist instead of
# the rest of the file re-read as entries. And the reader is not a Bash
# parser: it matches a declaration by line shape, so one written inside a
# heredoc or a quoted string would be read as though it were code.
#
# The awk program emits kind-tagged lines — `t<TAB>element` and
# `n<TAB>note` — so that a note can never be mistaken for a denylist
# entry, whatever a future entry happens to look like.
SIBLING="$REPO_ROOT/scripts/ci/check_sync_manifest"
if [ -f "$SIBLING" ]; then
  denylist=$(awk '
    # SQ/DQ/BS/BT are built with sprintf rather than written as literals:
    # the whole program lives inside one shell single-quoted string, so a
    # bare apostrophe cannot appear here, and %c is portable across the
    # awk implementations CI actually runs (mawk, gawk, BSD awk).
    BEGIN {
      SQ = sprintf("%c", 39); DQ = sprintf("%c", 34)
      BS = sprintf("%c", 92); BT = sprintf("%c", 96)
      NL = sprintf("%c", 10); TB = sprintf("%c", 9)
    }

    # --- output buffer, one declaration at a time --------------------
    # Held until the array closes so a partial read is never printed,
    # and dropped wholesale when a later assignment supersedes it.
    function put(kind, payload) { nbuf++; buf[nbuf] = kind TB payload }
    function drop_buffer() { nbuf = 0 }

    # --- token assembly ----------------------------------------------
    function keep(c) { tok = tok c; have = 1; boundary = 0 }
    function flush() {
      if (have) {
        if (index(tok, NL) > 0) {
          # A quoted literal newline is legal Bash, but it cannot survive
          # the line-based handoff below and cannot name a doc this check
          # compares. Say so rather than emitting half of it as an entry.
          put("n", "a denylist element spans a literal newline and was not carried across to the comparison")
        } else {
          put("t", tok)
          if (subst) {
            put("n", "denylist element " tok " contains an unexpanded substitution; it is read literally, so this check compared a PARTIAL denylist")
          }
        }
      }
      tok = ""; have = 0; subst = 0
    }

    # --- open-construct stack ----------------------------------------
    # One character per open construct, holding the closer it waits for.
    function top() { return substr(stack, length(stack), 1) }
    function push(closer) { stack = stack closer }
    function pop() { stack = substr(stack, 1, length(stack) - 1) }

    # Consume one chunk of array body (its newline included). Clears
    # `inside` when the array closes; all other state persists.
    function scan(s,   i, n, c, nx) {
      n = length(s)
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1); nx = substr(s, i + 1, 1)

        # Single quotes are literal all the way to the closing quote --
        # no escape, so not even a backslash can extend them.
        if (q == SQ) { if (c == SQ) { q = "" } else { keep(c) } ; continue }

        if (q == DQ) {
          # Inside double quotes \$, \`, \" and \\ escape, and a backslash
          # before a newline is a continuation Bash deletes; every other
          # backslash is an ordinary character to Bash as far as word
          # splitting is concerned, so it is kept as-is.
          if (c == BS) {
            if (nx == DQ || nx == BS || nx == "$" || nx == BT) { keep(nx); i++ }
            else if (nx == NL) { i++ }
            else { keep(c) }
            continue
          }
          if (c == DQ) { q = ""; continue }
          if (c == "$" || c == BT) { subst = 1 }
          keep(c)
          continue
        }

        if (c == BS) {
          # Unquoted backslash escapes the next character, which is how a
          # literal ) or # or space reaches an element without quoting.
          # Before a newline it joins the two lines into one word.
          if (nx == NL) { i++; continue }
          if (nx != "") { keep(nx); i++ }
          continue
        }
        if (c == SQ || c == DQ) { q = c; have = 1; boundary = 0; continue }

        # $( and ${ open a construct, a backtick opens or closes one.
        # Their contents can neither split a word nor end the array.
        if (c == "$" && (nx == "(" || nx == "{")) {
          if (nx == "(") { push(")") } else { push("}") }
          subst = 1
          keep(c); keep(nx); i++
          continue
        }
        if (c == BT) {
          if (top() == BT) { pop() } else { push(BT) }
          subst = 1; keep(c)
          continue
        }
        if (stack != "") {
          if (c == "(") { push(")") } else if (c == top()) { pop() }
          keep(c)
          continue
        }

        if (c == "#" && boundary) {
          # Comment to end of line. Stop ON the newline so the separator
          # below still sees it.
          while (i <= n && substr(s, i, 1) != NL) { i++ }
          i--
          continue
        }
        if (c == ")") { flush(); inside = 0; return }
        if (c == " " || c == TB || c == NL) { flush(); boundary = 1; continue }
        if (c == "$") { subst = 1 }
        keep(c)
      }
    }

    !inside {
      if (!match($0, /^[ \t]*IDENTITY_DOCS_DENYLIST(\+=|=)\(/)) { next }
      # `=` replaces the array, `+=` appends to it -- exactly as Bash
      # would evaluate the file top to bottom.
      if (index(substr($0, RSTART, RLENGTH), "+") == 0) { drop_buffer() }
      inside = 1; tok = ""; have = 0; subst = 0; q = ""; stack = ""; boundary = 1
      # Start after the opening paren so elements written on the
      # declaration line are read rather than discarded with it.
      scan(substr($0, index($0, "(") + 1) NL)
      next
    }
    { scan($0 NL) }

    END {
      # An unterminated declaration is not a short denylist: Bash would
      # reject the file outright. Report that rather than its prefix.
      if (inside) {
        drop_buffer()
        put("n", "the IDENTITY_DOCS_DENYLIST declaration never closes; the denylist could not be read at all")
      }
      for (k = 1; k <= nbuf; k++) { print buf[k] }
    }
  ' "$SIBLING")
  if [ -n "$denylist" ]; then
    while IFS= read -r row; do
      # Kind-tagged: "t<TAB>element" or "n<TAB>note". A note is surfaced
      # and never treated as an entry.
      if [ "${row:0:1}" = "n" ]; then
        echo "check_doc_ownership: note: ${row:2}"
        continue
      fi
      denied="${row:2}"
      case "$denied" in
        docs/agents/*) ;;
        *) continue ;;
      esac
      # Only meaningful for docs that exist here; a denylist entry for a
      # deleted doc is check_sync_manifest's problem, not this one.
      norm_denied=$(mp_normalize_path "$denied")
      [ -f "$REPO_ROOT/$norm_denied" ] || continue
      declared_class=""
      while IFS= read -r ownership_row; do
        [ -z "$ownership_row" ] && continue
        doc_path=$(yq -r '.path // ""' <<< "$ownership_row")
        if mp_path_is_unsafe "$doc_path"; then
          continue
        fi
        if [ "$(mp_normalize_path "$doc_path")" = "$norm_denied" ]; then
          declared_class=$(yq -r '.class // ""' <<< "$ownership_row")
          break
        fi
      done <<< "$ownership_rows"
      if [ "$declared_class" = "canonical" ]; then
        echo "FAIL: '$norm_denied' is on check_sync_manifest's IDENTITY_DOCS_DENYLIST (must never be verbatim-mirrored) but doc_ownership classifies it 'canonical' — the two declarations contradict each other. Reclassify it per-repo-owned or hub-only, or remove it from the denylist."
        FAILED=1
      fi
    done <<< "$denylist"
  fi
fi

# ─────────────────────────────────────────────────────────────────────
# 10: consumer-truthfulness — no canonical → hub-only reference.
# ─────────────────────────────────────────────────────────────────────
#
# A canonical doc is mirrored verbatim into every consumer; a hub-only
# doc never travels. So a repo-relative reference from the former to the
# latter is a link that works only where it was written and 404s in all
# nine consumers — and nothing downstream would ever report it, because
# the consumer has no manifest and no inventory to check against.
#
# Scope is deliberately narrow: it compares two classes this inventory
# already declares, so there is nothing to keep in step and no guessing
# about which OTHER hub files travel. A same-line absolute URL is the
# escape hatch — `https://github.com/<org>/mergepath/blob/main/<path>`
# resolves from any repo, which is exactly how REVIEW_POLICY.md links
# the hub-only CodeRabbit audit.
#
# TWO passes, because one spelling of the same broken link is invisible
# to the other:
#
#   (a) LITERAL — the full repo-relative path appears anywhere in the
#       text (`see \`docs/agents/coderabbit-audit.md\``), link or prose.
#       An absolute URL *contains* the path as a substring, so every
#       absolute URL is MASKED OUT of the matched text first and the
#       remainder re-tested; the exemption is therefore scoped to the
#       URL itself, not to the whole line that carries it.
#   (b) RESOLVED — every Markdown link target is resolved against the
#       directory of the doc carrying it, then compared as a whole path.
#       Canonical and hub-only docs are siblings under docs/agents/, so
#       the natural spelling is `[audit](coderabbit-audit.md)` or
#       `[audit](./coderabbit-audit.md)` — neither contains the string
#       pass (a) looks for, so without this pass the broken link ships
#       to all nine consumers unreported. Pass (b) needs no same-line
#       URL exemption: it parses targets, and an `https://` target is
#       skipped as already-absolute.
#
# A doc that trips both passes is reported once, naming the spelling
# that was found first.
if [ -n "$canonical_docs" ] && [ -n "$hub_only_docs" ]; then
  while IFS= read -r canon_doc; do
    [ -n "$canon_doc" ] || continue
    # Missing files were already reported by check 3b; skip rather than
    # emit a second, less specific failure for the same cause.
    [ -f "$REPO_ROOT/$canon_doc" ] || continue

    # Resolve this doc's link targets ONCE, not once per hub-only doc.
    #
    # The extraction is captured and its STATUS inspected rather than read
    # straight from a here-string, because a here-string discards it. The
    # extractor cannot fail quietly and be harmless: it produces the evidence
    # this whole check reasons from, so no output is indistinguishable from a
    # clean document. Measured on this program by restoring the recursion the
    # classifier used to use and handing it a document deep enough to segfault
    # BWK awk — the check printed PASS. It now reports the scan failure and
    # skips the comparisons that would be made on absent evidence.
    canon_dir="${canon_doc%/*}"
    [ "$canon_dir" = "$canon_doc" ] && canon_dir="."
    if ! link_targets_out=$(mp_doc_link_targets "$REPO_ROOT/$canon_doc"); then
      echo "FAIL: canonical doc '$canon_doc' could not be scanned for link targets — the Markdown extractor exited non-zero, so its link inventory is unknown and this doc was NOT checked against the hub-only inventory. Re-run the check; if it repeats, the document is hitting a limit of the extractor and belongs on an issue rather than in a silent pass."
      FAILED=1
      continue
    fi
    resolved_targets=""
    while IFS= read -r link_target; do
      case "$link_target" in
        # Empty or already absolute (any scheme, plus protocol-relative
        # `//host/...`) — nothing repo-relative to break.
        #
        # A pure fragment is NOT tested here, because it cannot arrive: the
        # extractor strips `[?#]...` from the target while it is still in
        # URL syntax, so `#section` reaches this loop as the empty string
        # and `other.md#frag` as `other.md`. Re-testing for a leading `#`
        # after decoding was therefore redundant, and worse than
        # redundant — percent decoding runs after that strip, exactly so
        # that an ENCODED delimiter stays path data, so `%23hub.md`
        # arrives as the pathname `#hub.md` and was being discarded as a
        # fragment. That silently missed a real canonical -> hub-only link.
        ''|*://*|mailto:*|//*) continue ;;
      esac
      resolved_targets="${resolved_targets}$(mp_resolve_relative "$canon_dir" "$link_target")"$'\n'
    done <<< "$link_targets_out"

    # (c) A destination this checker cannot fully decode is UNVERIFIABLE, not
    # clean. The named-reference table covers ASCII and the two Latin blocks;
    # a name outside it used to be compared in its still-encoded spelling,
    # which matches no inventory path and quietly permitted the link — so
    # `[the audit](&alpha;.md)`, which every reader resolves, hid a hub-only
    # doc actually named with that letter (#929 item 31). Reporting the
    # destination trades that MISS for a possible false positive, which is
    # the direction a guardrail should err in, and the author has two exact
    # spellings to reach for instead.
    #
    # Captured and status-checked for the same reason as the pass above, and
    # more sharply: a stream that exists to report what could not be decoded
    # must not be the one stream that goes quiet when the decoder breaks.
    if ! unresolvable_out=$(mp_doc_unresolvable_destinations "$REPO_ROOT/$canon_doc"); then
      echo "FAIL: canonical doc '$canon_doc' could not be scanned for unresolvable link destinations — the Markdown extractor exited non-zero, so nothing about this doc's destinations is known."
      FAILED=1
      continue
    fi
    while IFS= read -r raw_dest; do
      [ -n "$raw_dest" ] || continue
      echo "FAIL: canonical doc '$canon_doc' has the link destination '$raw_dest', which carries a named character reference this check cannot expand — the destination a reader opens is therefore unknown, and it cannot be compared against the hub-only inventory. Write the character itself, or its numeric reference (&#NNN; or &#xHH;), both of which are decoded in full; if the text is meant literally, spell the ampersand &amp;."
      FAILED=1
    done <<< "$unresolvable_out"

    while IFS= read -r hub_doc; do
      [ -n "$hub_doc" ] || continue
      spelling=""
      # (a) literal path mention. `grep -v` (not -q) reads its input to
      # completion: with `set -o pipefail`, an early-exiting `grep -q`
      # could SIGPIPE the producer and turn a real hit into a silent pass.
      # Mask portable inline/bare URLs and reference-style link uses,
      # then search the remainder. Reading the full file is necessary:
      # a reference definition may live far from the label it licenses.
      bare=$(mp_mask_absolute_reference_links "$REPO_ROOT/$canon_doc" \
        | mp_mask_absolute_urls \
        | grep -F -- "$hub_doc" || true)
      [ -n "$bare" ] && spelling="by repo-relative path"
      # (b) relative link target that resolves to it. Same `grep -q`
      # caution as above — match with `-xF` and test the captured output.
      if [ -z "$spelling" ] && [ -n "$resolved_targets" ]; then
        resolved_hit=$(printf '%s' "$resolved_targets" | grep -xF -- "$hub_doc" || true)
        [ -n "$resolved_hit" ] && spelling="by a relative Markdown link that resolves to it"
      fi
      [ -n "$spelling" ] || continue
      echo "FAIL: canonical doc '$canon_doc' references the hub-only doc '$hub_doc' $spelling — a canonical doc is mirrored verbatim to every consumer, a hub-only doc never travels, so that reference resolves on the hub and 404s downstream. Drop the reference, restate the content inline, or link it as an absolute https://github.com/... URL."
      FAILED=1
    done <<< "$hub_only_docs"
  done <<< "$canonical_docs"
fi

if [ "$FAILED" -ne 0 ]; then
  echo "check_doc_ownership: FAIL"
  exit 1
fi

# Run the regression test suite if present — same convention as
# check_sync_manifest. Suppressed when this invocation was itself driven
# by a fixture (MERGEPATH_MANIFEST_PATH set), because that is the test
# harness calling back into us and re-entering would recurse.
if [ "$CI_CHECK_RUN_SELF_TEST" -eq 1 ] && [ -z "${MERGEPATH_MANIFEST_PATH:-}" ]; then
  echo "check_doc_ownership: running regression test suite"
  if ! bash "$TEST_SUITE"; then
    echo "check_doc_ownership: FAIL (regression test suite failed)"
    exit 1
  fi
fi

# `grep -c` exits 1 on a zero count, which `|| true` would turn into an
# EMPTY declared_count rather than "0". Default it explicitly so the
# summary line stays readable on an empty inventory.
declared_count=$(printf '%s' "$declared" | tr ',' '\n' | grep -c . || true)
declared_count=${declared_count:-0}
echo "check_doc_ownership: PASS ($declared_count docs/agents doc(s) classified; classes: $VALID_CLASSES)"
exit 0
