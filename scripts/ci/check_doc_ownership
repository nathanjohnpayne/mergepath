            # Reported back so the caller can bound how long the frame lives.
            # An item that begins with a blank line is allowed exactly one, so
            # its container closes on the NEXT blank rather than surviving to
            # the end of the document. Read off the innermost marker, which is
            # where the recursion stops.
            if (LM_BLANK_FIRST) item_blank_first = 1
            return 0
          }
          s = substr(s, LM_CHARS + 1)
          # The item content is parsed as blocks IN ITS OWN RIGHT, so no
          # paragraph is open inside it yet — whatever was open outside stopped
          # at the marker. Carrying flow_open in made the item inherit the outer
          # paragraph and re-apply the interrupt rules to its own first child:
          # under an open paragraph, `- 2. # Heading` had its NESTED marker
          # rejected as unable to interrupt, so that item never pushed a content
          # column and prose six or seven columns in was measured against the
          # OUTER frame and blanked as code. The renderer shows it as ordinary
          # nested-item prose, so a hub-only link there escaped check 10
          # entirely — a missed reference, not a false alarm.
          flow_open = 0
          continue
        }
        if (substr(s, 1, 1) == "#") {
          hashes = run_len(s, 1, "#")
          if (hashes <= 6 && substr(s, hashes + 1) ~ /^([ \t]|$)/) return 0
        }
        if (s ~ /^\[[^]]+\]:[ \t]*/) return 0
        # A list item whose first child is a fence has no Markdown text flow:
        # `- ````, its indented contents and its matching closer are one code
        # block. Leaving this to the prose fallback emitted links from inside
        # that block, so carry the opener to the caller that owns fence state.
