        # opener. Set here rather than inside opens_html_block so the two
        # other callers of that function stay pure predicates.
        html_opened = opens_html_block(s, flow_open)
        if (html_opened) return 0
        return 1
      }
    }
    # Container content columns, innermost last. List items nest, so the
    # threshold for indented code is a STACK, not a scalar: leaving an inner
    # item must restore the column of the item enclosing it, and setting the
    # scalar back to zero instead measured the prose of the outer item against the
    # top-level four-column threshold and blanked it. Popping every frame
    # indented deeper than `col` leaves `code_column` at the innermost
    # container the line is still inside — zero when it is inside none.
    #
    # A frame also remembers the BLOCK QUOTE DEPTH it was created at, because
    # a column alone cannot say whether the container is still open. A list
    # inside a quote dies with the quote: after `> - # Heading`, an unmarked
    # blank line ends the quote and everything in it, yet the frame recorded
    # only its column, so a following four-space line was measured against a
    # list that no longer existed and top-level indented code was scanned as
    # prose. A frame whose quote is deeper than the current line therefore
    # pops no matter how its column compares.
    function pop_containers(col, qdepth) {
      while (cc_n > 0 && (cc[cc_n] > col || cq[cc_n] > qdepth)) {
        delete cc[cc_n]; delete cs[cc_n]; delete cq[cc_n]; delete cb[cc_n]; cc_n--
      }
      code_column = (cc_n > 0) ? cc[cc_n] : 0
    }
    # CommonMark 0.31.2 § List items: "A list item can begin with at most one
    # blank line." So a container opened by a marker with nothing after it
    # lives only until the next line, and a blank one there leaves the item
    # empty and closes it — what follows is measured from the column OUTSIDE
    # the list. `cb` flags exactly those frames; every other frame survives a
    # blank, because an item that already has content may hold one and keep
    # going. Without the distinction, `- ` then a blank then a four-column
    # link would keep the column-2 frame, raise the code threshold to six,
    # and report top-level indented code as prose.
    function close_blank_first_frame() {
      if (cc_n > 0 && cb[cc_n]) {
        delete cc[cc_n]; delete cq[cc_n]; delete cb[cc_n]; cc_n--
