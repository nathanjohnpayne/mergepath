#!/usr/bin/env bash
# CI wrapper for scripts/coderabbit-wait.sh timeout/status-probe behavior (#417).

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
MODE_HELPER="$REPO_ROOT/scripts/lib/ci-check-modes.sh"
if [ ! -f "$MODE_HELPER" ]; then
  echo "check_coderabbit_wait: ERROR scripts/lib/ci-check-modes.sh missing" >&2
  exit 1
fi
# shellcheck source=../lib/ci-check-modes.sh
. "$MODE_HELPER"
if ! ci_check_select_mode "$@"; then
  echo "usage: check_coderabbit_wait [--check | --self-test]" >&2
  exit 2
fi
SUITES=(
  "coderabbit-wait status-probe tests" "$REPO_ROOT/tests/test_coderabbit_wait_status_probe.sh"
  "coderabbit-wait identity-derivation tests (#438)" "$REPO_ROOT/tests/test_coderabbit_wait_identity_derivation.sh"
  "coderabbit-wait paused/skip tests (#490)" "$REPO_ROOT/tests/test_coderabbit_wait_paused.sh"
  "coderabbit-wait codex rate-limit failover tests (#489)" "$REPO_ROOT/tests/test_coderabbit_wait_codex_failover.sh"
  "auto-merge rate-limit gate tests (#489)" "$REPO_ROOT/tests/test_coderabbit_automerge_rate_limit_gate.sh"
  "StatusContext rate-limit false-clear tests (#596)" "$REPO_ROOT/tests/test_coderabbit_wait_statuscontext_ratelimit.sh"
  "rate-limit remaining-window sleep tests (#727)" "$REPO_ROOT/tests/test_coderabbit_wait_ratelimit_window.sh"
  "post-clearance fast-path cap tests (#727)" "$REPO_ROOT/tests/test_coderabbit_wait_post_clearance.sh"
  "Phase 2.5 invocation-decision tests (#1084)" "$REPO_ROOT/tests/test_coderabbit_should_invoke.sh"
)

if [ ! -x "$REPO_ROOT/scripts/coderabbit-wait.sh" ]; then
  echo "check_coderabbit_wait: ERROR scripts/coderabbit-wait.sh missing or not executable" >&2
  exit 1
fi
if ! bash -n "$REPO_ROOT/scripts/coderabbit-wait.sh"; then
  echo "check_coderabbit_wait: ERROR scripts/coderabbit-wait.sh has invalid shell syntax" >&2
  exit 1
fi

if [ "$CI_CHECK_RUN_SELF_TEST" -eq 1 ]; then
  _i=1
  while [ "$_i" -lt "${#SUITES[@]}" ]; do
    TEST=${SUITES[$_i]}
    if [ ! -x "$TEST" ]; then
      echo "check_coderabbit_wait: ERROR $TEST missing or not executable" >&2
      exit 1
    fi
    _i=$((_i + 2))
  done
fi

if [ "$CI_CHECK_RUN_SELF_TEST" -eq 1 ] && ! command -v jq >/dev/null 2>&1; then
  echo "check_coderabbit_wait: ERROR (jq is required — the wrapped suite would self-skip with exit 0 and report a green check over zero assertions)" >&2
  exit 1
fi

if [ "$CI_CHECK_RUN_SELF_TEST" -eq 0 ]; then
  echo "check_coderabbit_wait: PASS (live structure and syntax)"
  exit 0
fi

_i=0
while [ "$_i" -lt "${#SUITES[@]}" ]; do
  echo "check_coderabbit_wait: running ${SUITES[$_i]}"
  "${SUITES[$((_i + 1))]}"
  _i=$((_i + 2))
done
echo "check_coderabbit_wait: PASS"
