#!/usr/bin/env bash
# check_pr_review_policy_nudge — CI for the #931 recovery nudge.
#
# scripts/pr-review-policy-nudge.sh is hub-only operator tooling: it takes
# `<PR#> [owner/repo]`, so one copy run from the hub serves the whole fleet,
# and the credential it needs to edit a PR body lives on the operator's
# machine rather than in any consumer repo. This wrapper therefore SKIPs on
# consumers via the sync-to-downstream marker, the way check_wave_audit and
# check_project_doc_sync do; the paired suite legitimately does not travel.
#
# Two live assertions run before the suite, because each pins a property whose
# quiet loss would turn the nudge back into the architecture #931 rejected:
#
#   1. It publishes nothing. The whole reason this is a nudge and not a second
#      producer is that it never writes a check run. A write verb appearing in
#      the script would re-acquire the ownership, retirement, fencing and
#      Phase-4 obligations the design exists to avoid.
#   2. The context names are in lockstep with pr-review-policy.yml's job
#      names. The refuse-on-presence guardrail matches check-run names against
#      those two strings; if the workflow renames a job, the match silently
#      stops firing and the script degrades into an unconditional "re-run my
#      checks" button, which is exactly what it must not become.
#
# See docs/architecture/0003-pr-review-policy-recovery-producer.md.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Marker-first, and BEFORE every other lookup — the mode helper included.
# docs/agents/propagation-ordering.md is explicit: the sync-to-downstream
# marker test must come first, before any test of the check's own hub-only
# artifacts. Loading the shared mode helper ahead of it would turn the
# required `lint` context red on a consumer that received this wrapper but
# not `scripts/lib/ci-check-modes.sh` — bootstrap skew or a sync override —
# for hub-only tooling that consumer cannot use anyway. Guard on the marker
# ALONE: the presence of any wrapped artifact is the wrong signal, because a
# stale bootstrap can leave one behind.
if [ ! -f scripts/sync-to-downstream.sh ]; then
  echo "check_pr_review_policy_nudge: SKIP (consumer checkout: scripts/sync-to-downstream.sh is absent; the #931 recovery nudge is hub-only operator tooling)"
  exit 0
fi

# Live assertions and an implementation regression suite are separable here,
# so the two get explicit modes per docs/agents/testing-requirements.md
# § Repo-lint execution: the fast lane takes --check, deep CI takes
# --self-test, and the no-argument form still runs both so a consumer whose
# repo_lint.yml arrives before this wrapper is unaffected by the skew.
MODE_HELPER="$ROOT/scripts/lib/ci-check-modes.sh"
if [ ! -f "$MODE_HELPER" ]; then
  echo "check_pr_review_policy_nudge: ERROR scripts/lib/ci-check-modes.sh missing" >&2
  exit 1
fi
# shellcheck source=../lib/ci-check-modes.sh
. "$MODE_HELPER"
if ! ci_check_select_mode "$@"; then
  echo "usage: check_pr_review_policy_nudge [--check | --self-test]" >&2
  exit 2
fi

SUBJECT="scripts/pr-review-policy-nudge.sh"
TEST_SCRIPT="tests/test_pr_review_policy_nudge.sh"
GATE_WORKFLOW=".github/workflows/pr-review-policy.yml"
LABEL_GATE_TEST="tests/test_label_gate_live_labels.sh"


for f in "$SUBJECT" "$TEST_SCRIPT" "$GATE_WORKFLOW" "$LABEL_GATE_TEST"; do
  if [ ! -f "$f" ]; then
    echo "check_pr_review_policy_nudge: missing required file: $f" >&2
    exit 1
  fi
done
for f in "$SUBJECT" "$TEST_SCRIPT" "$LABEL_GATE_TEST"; do
  if [ ! -x "$f" ]; then
    echo "check_pr_review_policy_nudge: $f is not executable" >&2
    exit 1
  fi
done

# --- 1: it publishes nothing ------------------------------------------------
# Comments are stripped first so the rationale above — which necessarily talks
# about check runs and POSTs — cannot satisfy or trip its own assertion.
# FULL-LINE comments only. A trailing-comment strip cuts a code line at its
# first `#`, and this file's own `die` messages contain `$REPO#$PR_NUMBER` —
# so a future `gh api` call sharing a line with one would have its flags
# hidden from the scan below, which is the one thing this scan must not
# allow. The rationale prose that would otherwise trip the scan is all
# full-line, so nothing is lost.
CODE=$(grep -v '^[[:space:]]*#' "$SUBJECT")

# Scan gh invocations, not the whole file: `-f` and `-F` are ordinary test and
# rm operators elsewhere in the script. Backslash continuations are joined
# first, or an option on a wrapped line goes unseen. `gh api` is the only verb
# that can create a check run — `gh pr edit`, the one write here, cannot.
GH_CALLS=$(printf '%s\n' "$CODE" | sed -e :a -e '/\\$/{N;s/\\\n//;ba' -e '}' | grep -E 'gh[[:space:]]+api' || true)

# Every option that makes `gh api` non-GET. `-f` / `-F` / `--field` /
# `--raw-field` matter as much as `-X`: gh's own help says "adding request
# parameters will automatically switch the request method to POST", so a
# check-run writer needs no explicit method at all.
#
# The short forms take NO suffix constraint. Requiring a space or `=` after
# them let `-fbody=x`, `-Fname=x` and `-XPOST` through, which are valid
# attached-value spellings gh accepts — the guard read as tight while missing
# the shortest way to write the thing it forbids. On a `gh api` line a bare
# `-X`, `-f` or `-F` at a word boundary is suspicious whatever follows it.
if printf '%s\n' "$GH_CALLS" \
  | grep -Eq -- '(^|[[:space:]])(-[XfF]|--method|--input|--field|--raw-field)'; then
  echo "check_pr_review_policy_nudge: $SUBJECT issues a non-GET gh api call; the nudge must publish nothing" >&2
  exit 1
fi

# Occurrences, not matching lines: joining continuations above means one line
# can now carry several references.
CHECK_RUN_REFS=$(printf '%s\n' "$CODE" | grep -o 'check-runs' | grep -c '' || true)
if [ "$CHECK_RUN_REFS" -ne 1 ]; then
  echo "check_pr_review_policy_nudge: expected exactly one check-runs reference (the read) in $SUBJECT; found $CHECK_RUN_REFS" >&2
  exit 1
fi

# --- 2: lockstep with the canonical producer's job names --------------------
# GitHub derives a check-run context from the JOB's `name`, so that is what
# must match. An earlier version grepped the file for any indented `name:` —
# which a STEP name satisfies too, so renaming a job while some step kept the
# old text would have left this passing and the refusal silently broken.
# Read from the script rather than restated here, so the constants cannot
# drift into a third copy.
if ! command -v yq >/dev/null 2>&1; then
  echo "check_pr_review_policy_nudge: ERROR yq is required to read $GATE_WORKFLOW" >&2
  exit 1
fi

assert_job_name() {  # <script constant> <workflow job id>
  local var=$1 job=$2 value actual
  value=$(printf '%s\n' "$CODE" | sed -n "s/^$var=\"\(.*\)\"\$/\1/p" | head -1)
  if [ -z "$value" ]; then
    echo "check_pr_review_policy_nudge: could not read $var from $SUBJECT" >&2
    exit 1
  fi
  actual=$(yq -r ".jobs.\"$job\".name // \"\"" "$GATE_WORKFLOW")
  if [ "$actual" != "$value" ]; then
    echo "check_pr_review_policy_nudge: $var is '$value' but $GATE_WORKFLOW job '$job' is named '$actual'; the refuse-on-presence guard would never match" >&2
    exit 1
  fi
}

assert_job_name CONTEXT_SELF_REVIEW self-review-check
assert_job_name CONTEXT_LABEL_GATE label-gate

# --- 3: the recovery contract the nudge depends on --------------------------
# The whole mechanism is "a body edit fires `edited`, and `edited` re-runs all
# three producer jobs". Nothing else in the repository asserts that, so if the
# workflow later drops `edited` from its types, or gates the Phase 4 classifier
# off for that action, the nudge would report success while firing no complete
# re-evaluation — the "recorded that we called it, not that it worked" shape.
#
# Decided over the PARSED trigger map, never a line grep: `on:`, `"on":` and
# the inline-mapping spelling all resolve to the same map and a grep anchored
# to one of them sees only that one. yq is installed earlier in this lane.
TYPES=$(yq -r '.on.pull_request.types // [] | join(" ")' "$GATE_WORKFLOW")
case " $TYPES " in
  *" edited "*) ;;
  *)
    echo "check_pr_review_policy_nudge: $GATE_WORKFLOW no longer subscribes to pull_request 'edited'; the nudge would fire nothing (types: $TYPES)" >&2
    exit 1 ;;
esac

# Every producer must actually run for `edited`. Pattern-matching the `if:`
# for the word "edited" was the wrong instrument twice over: a positive
# narrowing like `action == 'opened' || action == 'synchronize'` excludes
# edited while never naming it, and `action == 'edited'` names it while being
# perfectly valid. Evaluating GitHub expression semantics here is out of
# proportion, so the accepted conditions are PINNED instead: a job may carry
# no `if`, or one complete expression on this list. Conditions on other
# event fields can also exclude edited, so they receive no blanket exemption.
# Anything else has to be added deliberately, which is the point — the
# condition is load-bearing for the whole mechanism, so a change to it should
# force someone to re-reason rather than slip through a regex.
# The verified set, one complete expression per line. Retain the workflow's
# existing Dependabot exemption, exclude only the two label actions, or name
# edited outright. Other nonempty conditions require explicit verification.
JOB_CONDITIONS_VERIFIED_FOR_EDITED=$(cat <<'CONDITIONS'
github.event.pull_request.user.login != 'dependabot[bot]'
github.event.action != 'labeled' && github.event.action != 'unlabeled'
github.event.action == 'edited'
CONDITIONS
)

for job in self-review-check label-gate external-review-labeling; do
  if [ "$(yq -r ".jobs.\"$job\" // \"MISSING\"" "$GATE_WORKFLOW")" = "MISSING" ]; then
    echo "check_pr_review_policy_nudge: $GATE_WORKFLOW has no job '$job'; the recovery contract named three producers" >&2
    exit 1
  fi
  # Preserve a literal false: yq's alternate operator would turn it into the
  # same empty string as an absent condition and silently accept a skipped job.
  JOB_IF=$(yq -r ".jobs.\"$job\".if | select(. != null)" "$GATE_WORKFLOW")
  [ -z "$JOB_IF" ] && continue
  if ! printf '%s\n' "$JOB_CONDITIONS_VERIFIED_FOR_EDITED" | grep -Fxq "$JOB_IF"; then
    echo "check_pr_review_policy_nudge: $GATE_WORKFLOW job '$job' has a condition this check has not verified runs for 'edited':" >&2
    echo "    $JOB_IF" >&2
    echo "  Confirm a body edit still runs it, then add the expression to JOB_CONDITIONS_VERIFIED_FOR_EDITED." >&2
    exit 1
  fi
done

if [ "$CI_CHECK_RUN_SELF_TEST" -eq 0 ]; then
  echo "check_pr_review_policy_nudge: PASS (live assertions only; suite runs in deep CI)"
  exit 0
fi

bash "$TEST_SCRIPT"
# #1339: the Label Gate in the same workflow reads LIVE labels. Run here
# because this lane already owns the lockstep assertions on this workflow.
bash "$LABEL_GATE_TEST"

echo "check_pr_review_policy_nudge: PASS"
