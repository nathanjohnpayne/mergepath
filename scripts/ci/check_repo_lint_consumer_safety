#!/usr/bin/env bash
# scripts/ci/check_repo_lint_consumer_safety — CI entry point for the #601
# consumer-safety net (Codex P2 on #624: the net existed but nothing ran it).
#
# Wraps tests/test_repo_lint_consumer_safety.sh, which re-runs every
# scripts/ci/check_* wrapper inside a consumer-SHAPED checkout (hub-only
# files stripped) and fails if any wrapper errors instead of skipping or
# passing — catching a hub-only check that would red a consumer BEFORE the
# wave propagates it. Hub-only by nature (it needs the full hub tree to
# build the consumer shape from), so it uses the standard nested
# consumer-safety guard itself. It is the slowest deep-safety step on the
# hub and SKIPs everywhere else.
#
# The guard is marker-FIRST (see check_consumer_residue_safety for the full
# argument). It used to be the both-absent PAIR (wrapped test absent AND
# scripts/sync-to-downstream.sh absent), which falls through on any consumer
# that still carries tests/test_repo_lint_consumer_safety.sh as bootstrap
# residue: that consumer ran its stale, unselected copy of the whole hub
# suite on every deep-safety run (~15-20 min per run on fiveacross) — the
# check_consumer_residue_safety KNOWN_RESIDUE_VIOLATIONS EXIT entry this
# retires.
# Marker-first keeps the pair's protection: on the hub the marker is
# present, so a lost wrapped test still hard-errors below.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
TEST_SCRIPT="$REPO_ROOT/tests/test_repo_lint_consumer_safety.sh"

# Marker-FIRST consumer gate (#601 consumer-safety; repo_lint.yml is
# manifest-canonical, so consumers run this wrapper too). Consulted before
# ANY test of this check's own hub-only artifacts, so the SKIP decision is a
# function of what the manifest delivered and nothing else.
if [ ! -f "$REPO_ROOT/scripts/sync-to-downstream.sh" ]; then
  echo "check_repo_lint_consumer_safety: SKIP (consumer checkout: hub marker scripts/sync-to-downstream.sh absent; hub-only consumer-safety net)"
  exit 0
fi

if [ ! -f "$TEST_SCRIPT" ]; then
  echo "check_repo_lint_consumer_safety: ERROR (missing $TEST_SCRIPT)" >&2
  exit 1
fi

bash "$TEST_SCRIPT"
