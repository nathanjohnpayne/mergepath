#!/usr/bin/env bash
# scripts/ci/check_op_preflight_contract — CI entry point for #282.
#
# Runs the unit tests for the tightened op-preflight contract:
#   - --check / --status mode never invokes op, never warms SSH
#   - Default --mode is review (not all)
#   - OP_PREFLIGHT_QUIET=1 collapses the cache-hit stderr block
#   - The five helper scripts auto-source the cache when GH_TOKEN is
#     unset, and the shared preflight-helpers.sh library works as
#     documented.
#   - scripts/agent-capability-probe.sh measures and caches the session's
#     capability tier, and scripts/lib/credential-class.sh refuses a
#     brokered or app-installed credential that reads as the right user
#     (#1057).
#
# Hard-fails when either test file is missing so a rename can't
# silently disable the check.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

TESTS=(
  "tests/test_op_preflight_check.sh"
  "tests/test_op_preflight_token_mode.sh"
  "tests/test_helper_autosource.sh"
  "tests/test_preflight_agent_name.sh"
  # #1057: the capability probe is the other half of "what can this session
  # do": op-preflight --check answers whether credentials are cached, the
  # probe answers whether they (or the ambient credential) can actually
  # write under the right byline, and caches a tier for later tool calls.
  "tests/test_agent_capability_probe.sh"
  # #1057 F: the committed cloud-environment recipe, its SessionStart hook and
  # its setup script.
  "tests/test_cloud_environment.sh"
  # #1057 D + G: the local-agent handback and the thread-resolution CI lane.
  "tests/test_local_agent_handback.sh"
  # #2938: --mode pr-assets, the scoped upload credential's own slot.
  "tests/test_op_preflight_pr_assets.sh"
)

# Each suite is one case-pool case (#2990): they share no state, so the pool
# runs them side by side and replays their output in this order. A failing or
# missing suite adds to FAIL, which is what the pool counts. A checkout behind
# the wave that delivers the pool runs the same suites one after another: the
# skew costs time, never a suite.
# shellcheck disable=SC2034 # case_pool_wait adds each suite's passes here
PASS=0
FAIL=0
# shellcheck disable=SC2329 # invoked through case_pool_add / the serial loop
run_suite() { # <rel>
  local full="$REPO_ROOT/$1"
  if [ ! -f "$full" ]; then
    echo "check_op_preflight_contract: ERROR (missing $1)" >&2
    FAIL=$((FAIL + 1))
    return 0
  fi
  echo "check_op_preflight_contract: running $1"
  if ! bash "$full"; then
    echo "check_op_preflight_contract: FAIL ($1)" >&2
    FAIL=$((FAIL + 1))
  fi
}
if [ -f "$REPO_ROOT/tests/lib/case-pool.sh" ]; then
  # shellcheck source=tests/lib/case-pool.sh
  source "$REPO_ROOT/tests/lib/case-pool.sh"
  for rel in "${TESTS[@]}"; do
    case_pool_add run_suite "$rel"
  done
  case_pool_wait
else
  for rel in "${TESTS[@]}"; do
    run_suite "$rel"
  done
fi
FAILED=0
[ "$FAIL" -eq 0 ] || FAILED=1

if [ "$FAILED" -ne 0 ]; then
  echo "check_op_preflight_contract: FAIL"
  exit 1
fi

echo "check_op_preflight_contract: PASS"
exit 0
