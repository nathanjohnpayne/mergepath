#!/usr/bin/env bash
# check_auto_clear_workflow — smoke tests for auto-clear-blocking-labels.yml
#
# The workflow itself runs in GitHub Actions; what we test here is the
# YAML structure (parses, has the right triggers, has the self-fire
# guard) and the PR-number resolution dispatch logic (which is bash
# inside the workflow). Mirrors the integration-test gap that #195's
# implementation plan flagged.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
WORKFLOW="$ROOT/.github/workflows/auto-clear-blocking-labels.yml"
CONTINUATION_TEST="$ROOT/tests/test_approval_merge_continuation.sh"
CONTINUATION_REPORTER="$ROOT/scripts/workflow/report-approval-continuation-failures.sh"

pass=0
fail=0
skip_reason=""

# ── Test 1: workflow file exists and is valid YAML
echo "auto-clear-blocking-labels.yml structural tests"

if [ ! -f "$WORKFLOW" ]; then
  echo "  FAIL: $WORKFLOW does not exist" >&2
  exit 1
fi

# Parse via yq (preferred — no extra deps needed in GitHub-hosted
# runner) → python3+PyYAML → grep fallback. Graceful skip when no
# YAML parser is available rather than treating absence as failure.
if command -v yq >/dev/null 2>&1; then
  if yq eval '.' "$WORKFLOW" >/dev/null 2>&1; then
    pass=$((pass + 1))
    echo "  PASS: workflow YAML parses (via yq)"
  else
    fail=$((fail + 1))
    echo "  FAIL: workflow YAML invalid (per yq)" >&2
  fi
elif python3 -c "import yaml" >/dev/null 2>&1; then
  # Pass the path via argv (sys.argv[1]) instead of string-interpolating
  # `$WORKFLOW` into the Python source literal. Interpolation was brittle:
  # a path containing a quote or backslash would break the literal (or
  # worse). argv keeps the path out of the parsed Python text entirely.
  if python3 -c 'import sys, yaml; yaml.safe_load(open(sys.argv[1]))' "$WORKFLOW" 2>/dev/null; then
    pass=$((pass + 1))
    echo "  PASS: workflow YAML parses (via python+PyYAML)"
  else
    fail=$((fail + 1))
    echo "  FAIL: workflow YAML invalid (per python+PyYAML)" >&2
  fi
else
  skip_reason="no YAML parser available; install yq or PyYAML for the parse assertion"
  echo "  INFO: $skip_reason"
fi

# ── Test 2: required triggers present
# Codex P1 on PR #202 r1: workflow_run replaces check_suite (which
# doesn't fire for Actions-created suites).
for trig in 'pull_request_target' 'pull_request_review' 'workflow_run'; do
  if grep -qE "^[[:space:]]+${trig}:" "$WORKFLOW"; then
    pass=$((pass + 1))
    echo "  PASS: trigger '$trig' configured"
  else
    fail=$((fail + 1))
    echo "  FAIL: missing required trigger '$trig'" >&2
  fi
done

# Negative: workflow_run is the canonical post-CI signal. check_suite
# would silently fail to fire for GitHub-Actions-created suites.
if grep -qE "^[[:space:]]+check_suite:" "$WORKFLOW"; then
  fail=$((fail + 1))
  echo "  FAIL: check_suite trigger should NOT be present (codex P1 on #202 — doesn't fire for Actions suites)" >&2
else
  pass=$((pass + 1))
  echo "  PASS: check_suite trigger absent (regression closed for codex P1 on #202)"
fi

# Schedule trigger present (#197 sub-C of #191) — catches the
# 👍-after-last-push case where no event-driven trigger fires.
# CR Minor on PR #213: anchor to the actual cron entry (not just
# any `schedule:` / `cron:` text anywhere) so a comment couldn't
# satisfy the assertion.
if grep -qE "^[[:space:]]+schedule:" "$WORKFLOW" && \
   grep -qF -- "- cron: '*/5 * * * *'" "$WORKFLOW"; then
  pass=$((pass + 1))
  echo "  PASS: schedule trigger configured with 5-min cron (#197/#324)"
else
  fail=$((fail + 1))
  echo "  FAIL: missing schedule trigger or expected cron entry (5-min cron per #324)" >&2
fi

# scheduled-sweep job exists and is gated to schedule-only events.
# Anchor to the executable `if:` line so a string in a comment
# couldn't satisfy the assertion. CR Minor on PR #213.
if grep -qE "^[[:space:]]+scheduled-sweep:" "$WORKFLOW" && \
   grep -qE "^[[:space:]]+if:[[:space:]]+github\.event_name == 'schedule'" "$WORKFLOW"; then
  pass=$((pass + 1))
  echo "  PASS: scheduled-sweep job gated by executable 'if: ... schedule' line"
else
  fail=$((fail + 1))
  echo "  FAIL: scheduled-sweep job missing or not gated to schedule events (executable line)" >&2
fi

# CR Major on PR #213: gh pr list defaults to --limit 30. The scheduled
# sweep must use a higher limit so repos with many open
# needs-external-review PRs get them ALL processed, not just the first 30.
#
# #730/#731 (Codex P3): anchor this to the sweep's LABEL-FILTERED query
# specifically, not "the first gh pr list". The #730 head_sha fallback added
# a SECOND, intentionally-unlabeled `gh pr list` that appears EARLIER in the
# file — a bare first-match assertion (the old `awk '/gh pr list/,/…/'`
# range) could pass against that fallback's --limit and keep printing the
# "handles >30-PR repos" pass even if the sweep later lost its own --limit.
# The sweep query is the one carrying `--label needs-external-review`; require
# --limit ≥100 on that same query line. (The #730 fallback is intentionally
# unlabeled — it matches a single head SHA, not the label queue.)
if grep -E -- '--label needs-external-review' "$WORKFLOW" | grep -qE -- '--limit [1-9][0-9]{2,}'; then
  pass=$((pass + 1))
  echo "  PASS: scheduled-sweep label-filtered query uses --limit ≥100 (handles >30-PR repos; #730-anchored)"
else
  fail=$((fail + 1))
  echo "  FAIL: sweep 'gh pr list --label needs-external-review' must use --limit ≥100 (CR Major #213; anchored per #730 Codex P3)" >&2
fi

# CR Major on PR #213: opt-out parser must strip trailing YAML
# comments. `scheduled_sweep_enabled: false  # opt out` was being
# parsed as `false#optout`. The fix is `sub(/#.*/, "")` before the
# value extraction.
if grep -qE 'sub\(/#\.\*/, ""\)' "$WORKFLOW"; then
  pass=$((pass + 1))
  echo "  PASS: opt-out parser strips trailing YAML comments"
else
  fail=$((fail + 1))
  echo "  FAIL: opt-out parser must strip trailing YAML comments (CR Major on PR #213)" >&2
fi

# CR Major on PR #213 r2: evaluate-and-clear must skip on cron runs.
# Without this guard, every 15-min sweep paid for a checkout-only
# no-op job before the event resolver decided 'schedule' was
# unsupported.
if grep -qE -- "github\.event_name != 'schedule'" "$WORKFLOW"; then
  pass=$((pass + 1))
  echo "  PASS: evaluate-and-clear skips schedule events (cron runs only the sweep job)"
else
  fail=$((fail + 1))
  echo "  FAIL: evaluate-and-clear must skip schedule events (CR Major on PR #213 r2)" >&2
fi

# CR Major on PR #213 r2: sweep must capture `gh pr list` exit
# status separately, not via process substitution into mapfile (which
# swallows the producer's exit code, silently turning a gh failure
# into "0 PRs found"). #324 wrapped the gh call in
# `with_gh_retry`; tolerate either form.
if grep -qE -- 'if ! prs_raw=\$\((with_gh_retry )?gh pr list' "$WORKFLOW" && \
   grep -qE -- 'echo "::error::Failed to list open PRs' "$WORKFLOW"; then
  pass=$((pass + 1))
  echo "  PASS: sweep captures gh pr list exit status (no silent failure on gh error)"
else
  fail=$((fail + 1))
  echo "  FAIL: sweep must capture gh pr list status separately, not via mapfile <(...) (CR Major on PR #213 r2)" >&2
fi

# workflow_run must listen to the EXACT upstream workflow names. A
# rename or typo on either side would silently break the auto-clear
# without this test catching it. CR Trivial on PR #202 r2.
# "repo-lint-local" added for #655 — the consumer-local repo_lint_local.yml
# annex (#601), verified against a live consumer's annex workflow name.
# ".github/workflows/repo_lint_local.yml" added for #655 round 11 —
# workflow_run matches by displayed name, which is the workflow FILE PATH
# when the annex omits a top-level `name:` key (round 6's fallback case).
# "Merge Clearance Gate" added for #730 — its SUCCESS is the direct clearance
# signal, and unlike "PR Review Policy" it actually reaches conclusion=success
# when the gate clears (PR Review Policy's Label Gate is red while the label is
# present, so it never triggers auto-clear via workflow_run).
for wf in 'PR Review Policy' 'Agent Review Pipeline' 'Merge Clearance Gate' 'repo-lint' 'repo-lint-local' '.github/workflows/repo_lint_local.yml'; do
  if grep -qF -- "- \"$wf\"" "$WORKFLOW"; then
    pass=$((pass + 1))
    echo "  PASS: workflow_run listens to '$wf'"
  else
    fail=$((fail + 1))
    echo "  FAIL: workflow_run missing '$wf'" >&2
  fi
done

# A consumer annex may use any top-level workflow name, which cannot be
# enumerated in workflow_run.workflows. The existing five-minute sweep must
# therefore re-enter the exact-head approval continuation for open approved
# PRs as a bounded general backstop (#1062).
if grep -qF -- "--search 'review:approved'" "$WORKFLOW" \
   && grep -qF -- 'Continue approved PRs after custom-workflow completions' "$WORKFLOW" \
   && grep -qF -- 'scripts/workflow/approval-merge-continuation.sh "$PR" "$REPO"' "$WORKFLOW" \
   && grep -qF -- 'echo "enabled=$enabled" >> "$GITHUB_OUTPUT"' "$WORKFLOW" \
   && [ "$(grep -cF "steps.find.outputs.enabled != 'false'" "$WORKFLOW")" -eq 2 ]; then
  pass=$((pass + 1))
  echo "  PASS: enabled scheduled sweep backstops custom annex workflow names and preserves the opt-out (#1062)"
else
  fail=$((fail + 1))
  echo "  FAIL: scheduled sweep must continue approved PRs whose custom annex name cannot appear in workflow_run.workflows, while honoring scheduled_sweep_enabled:false (#1062)" >&2
fi

# Both approval-continuation loops have their own failure-surfacing step. An
# infrastructure/config failure must therefore export both the sentinel and
# the affected PR list before exiting nonzero; shell-local variables disappear
# at the step boundary and cannot drive the following check-run publisher.
event_continuation_block=$(awk '
  /- name: Continue approved PRs after completed checks/ {in_block=1}
  in_block && /- name:/ && $0 !~ /- name: Continue approved PRs after completed checks/ {exit}
  in_block {print}
' "$WORKFLOW")
clear_block=$(awk '
  /- name: Re-evaluate gate per PR \+ remove label on pass/ {in_block=1}
  in_block && /- name:/ && $0 !~ /- name: Re-evaluate gate per PR \+ remove label on pass/ {exit}
  in_block {print}
' "$WORKFLOW")
scheduled_clear_block=$(awk '
  /- name: Re-evaluate gate per PR$/ {in_block=1}
  in_block && /- name:/ && $0 !~ /- name: Re-evaluate gate per PR$/ {exit}
  in_block {print}
' "$WORKFLOW")
scheduled_continuation_block=$(awk '
  /- name: Continue approved PRs after custom-workflow completions/ {in_block=1}
  in_block && /- name:/ && $0 !~ /- name: Continue approved PRs after custom-workflow completions/ {exit}
  in_block {print}
' "$WORKFLOW")
clear_block_protects_before_delete() {
  local block="$1" protect_line failure_line delete_line
  protect_line=$(grep -nF -- '--retract-unsafe-only "$PR" "$REPO"' <<<"$block" | head -1 | cut -d: -f1 || true)
  failure_line=$(grep -nF 'if [ "$protective_rc" -ne 0 ]; then' <<<"$block" | head -1 | cut -d: -f1 || true)
  delete_line=$(grep -nF 'del_out=$(gh api "repos/$REPO/issues/$PR/labels/needs-external-review" -X DELETE' <<<"$block" | head -1 | cut -d: -f1 || true)
  grep -Fq 'WORKFLOW_TOKEN: ${{ github.token }}' <<<"$block" \
    && grep -Fq 'GH_TOKEN: ${{ secrets.CI_ACTOR_TOKEN || secrets.REVIEWER_ASSIGNMENT_TOKEN }}' <<<"$block" \
    && grep -Fq 'GH_TOKEN="$WORKFLOW_TOKEN" bash scripts/workflow/approval-merge-continuation.sh' <<<"$block" \
    && [ -n "$protect_line" ] && [ -n "$failure_line" ] && [ -n "$delete_line" ] \
    && [ "$protect_line" -lt "$failure_line" ] \
    && [ "$failure_line" -lt "$delete_line" ] \
    && grep -Fq 'had_infra_error=1' <<<"$block"
}
if clear_block_protects_before_delete "$clear_block" \
   && clear_block_protects_before_delete "$scheduled_clear_block"; then
  pass=$((pass + 1))
  echo "  PASS: both label-clear paths retract with the workflow token before PAT-backed blocker deletion"
else
  fail=$((fail + 1))
  echo "  FAIL: every label-clear path must retract with github.token, fail closed, and retain the PAT for deleting needs-external-review" >&2
fi

# Execute both literal clear blocks against a token-aware stub. Structural
# ordering alone cannot prove that a failed protective call actually skips the
# DELETE, or that the ambient PAT still owns the label write that re-triggers
# downstream workflows.
clear_harness_dir=$(mktemp -d "${TMPDIR:-/tmp}/auto-clear-protection.XXXXXX")
mkdir -p "$clear_harness_dir/bin" "$clear_harness_dir/scripts/lib" \
  "$clear_harness_dir/scripts/workflow"

extract_named_run_block() {
  local name="$1" destination="$2"
  awk -v target="$name" '
    $0 == "      - name: " target { in_step=1; next }
    in_step && $0 == "        run: |" { in_run=1; next }
    in_run && /^          / { sub(/^          /, ""); print; next }
    in_run && /^[[:space:]]*$/ { print; next }
    in_run { exit }
  ' "$WORKFLOW" >"$destination"
}

extract_named_run_block \
  'Re-evaluate gate per PR + remove label on pass' \
  "$clear_harness_dir/event-clear.sh"
extract_named_run_block \
  'Re-evaluate gate per PR' \
  "$clear_harness_dir/scheduled-clear.sh"

cat >"$clear_harness_dir/scripts/lib/gh-retry-helpers.sh" <<'STUB'
with_gh_retry() { "$@"; }
STUB
cat >"$clear_harness_dir/scripts/codex-review-check.sh" <<'STUB'
#!/usr/bin/env bash
exit 0
STUB
cat >"$clear_harness_dir/scripts/workflow/approval-merge-continuation.sh" <<'STUB'
#!/usr/bin/env bash
# APPROVAL_PROTECTIVE_RETRACTION_V2
printf 'protect:%s\n' "${GH_TOKEN:-unset}" >>"${CLEAR_STUB_LOG:?}"
exit "${CLEAR_PROTECT_RC:-0}"
STUB
cat >"$clear_harness_dir/bin/gh" <<'STUB'
#!/usr/bin/env bash
set -euo pipefail
case "${1:-} ${2:-}" in
  'pr view')
    if [ "$(cat "${CLEAR_LABEL_STATE:?}")" = present ]; then
      printf 'true\n'
    else
      printf 'false\n'
    fi
    ;;
  'pr comment')
    printf 'comment:%s\n' "${GH_TOKEN:-unset}" >>"${CLEAR_STUB_LOG:?}"
    ;;
  'api repos/owner/repo/issues/7/labels/needs-external-review')
    printf 'delete:%s\n' "${GH_TOKEN:-unset}" >>"${CLEAR_STUB_LOG:?}"
    printf 'absent\n' >"${CLEAR_LABEL_STATE:?}"
    printf 'HTTP/2.0 204 No Content\n'
    ;;
  *)
    printf 'unexpected gh call: %s\n' "$*" >&2
    exit 90
    ;;
esac
STUB
chmod +x "$clear_harness_dir/bin/gh" \
  "$clear_harness_dir/scripts/codex-review-check.sh" \
  "$clear_harness_dir/scripts/workflow/approval-merge-continuation.sh"

run_clear_harness() {
  local script="$1" input_name="$2" protective_rc="$3"
  printf 'present\n' >"$clear_harness_dir/label-state"
  : >"$clear_harness_dir/calls.log"
  : >"$clear_harness_dir/github-env"
  : >"$clear_harness_dir/github-output"
  (
    cd "$clear_harness_dir"
    env \
      PATH="$clear_harness_dir/bin:$PATH" \
      GH_TOKEN=pat-token \
      WORKFLOW_TOKEN=workflow-token \
      REPO=owner/repo \
      PR_NUMBERS="$([ "$input_name" = PR_NUMBERS ] && printf 7)" \
      PRS="$([ "$input_name" = PRS ] && printf 7)" \
      CLEAR_PROTECT_RC="$protective_rc" \
      CLEAR_STUB_LOG="$clear_harness_dir/calls.log" \
      CLEAR_LABEL_STATE="$clear_harness_dir/label-state" \
      GITHUB_ENV="$clear_harness_dir/github-env" \
      GITHUB_OUTPUT="$clear_harness_dir/github-output" \
      bash "$script" >"$clear_harness_dir/run.out" 2>&1
  )
}

clear_execution_ok=1
for clear_case in event scheduled; do
  if [ "$clear_case" = event ]; then
    clear_script="$clear_harness_dir/event-clear.sh"
    clear_input=PR_NUMBERS
  else
    clear_script="$clear_harness_dir/scheduled-clear.sh"
    clear_input=PRS
  fi

  set +e
  run_clear_harness "$clear_script" "$clear_input" 0
  clear_success_rc=$?
  set -e
  clear_success_calls=$(grep -E '^(protect|delete|comment):' \
    "$clear_harness_dir/calls.log" | tr '\n' ' ')
  if [ "$clear_success_rc" -ne 0 ] \
     || [ "$clear_success_calls" != \
          'protect:workflow-token delete:pat-token comment:pat-token ' ]; then
    echo "  INFO: $clear_case clear success fixture rc=$clear_success_rc calls='$clear_success_calls'" >&2
    sed 's/^/        call: /' "$clear_harness_dir/calls.log" >&2
    sed 's/^/        /' "$clear_harness_dir/run.out" >&2
    clear_execution_ok=0
  fi

  set +e
  run_clear_harness "$clear_script" "$clear_input" 3
  clear_failure_rc=$?
  set -e
  if [ "$clear_failure_rc" -ne 1 ] \
     || ! grep -Fxq 'protect:workflow-token' "$clear_harness_dir/calls.log" \
     || grep -Eq '^(delete|comment):' "$clear_harness_dir/calls.log" \
     || ! grep -Fxq 'HAD_INFRA_ERROR=1' "$clear_harness_dir/github-env"; then
    echo "  INFO: $clear_case clear failure fixture rc=$clear_failure_rc" >&2
    sed 's/^/        /' "$clear_harness_dir/run.out" >&2
    clear_execution_ok=0
  fi
done

if [ "$clear_execution_ok" -eq 1 ]; then
  pass=$((pass + 1))
  echo "  PASS: both literal clear blocks protect before PAT deletion and skip all writes on protective failure"
else
  fail=$((fail + 1))
  echo "  FAIL: label-clear execution must use workflow-token protection, PAT deletion, and no writes after protective failure" >&2
fi
rm -rf "$clear_harness_dir"

event_protect_line=$(grep -nF -- '--retract-unsafe-only "$PR" "$REPO"' <<<"$event_continuation_block" | head -1 | cut -d: -f1 || true)
event_continue_line=$(grep -nF 'MERGEPATH_PROTECTIVE_RETRACTION_DONE=1' <<<"$event_continuation_block" | head -1 | cut -d: -f1 || true)
event_no_author_line=$(grep -nF '[ -z "${AUTHOR_TOKEN:-}" ]' <<<"$event_continuation_block" | head -1 | cut -d: -f1 || true)
scheduled_protect_line=$(grep -nF -- '--retract-unsafe-only "$PR" "$REPO"' <<<"$scheduled_continuation_block" | head -1 | cut -d: -f1 || true)
scheduled_continue_line=$(grep -nF 'MERGEPATH_PROTECTIVE_RETRACTION_DONE=1' <<<"$scheduled_continuation_block" | head -1 | cut -d: -f1 || true)
scheduled_no_author_line=$(grep -nF '[ -z "${AUTHOR_TOKEN:-}" ]' <<<"$scheduled_continuation_block" | head -1 | cut -d: -f1 || true)
if grep -qF 'echo "CONTINUATION_INFRA_ERROR=$continuation_infra_error" >> "$GITHUB_ENV"' <<<"$event_continuation_block" \
   && grep -qF 'echo "CONTINUATION_INFRA_ERROR_PRS=$(echo $continuation_failing_prs)" >> "$GITHUB_ENV"' <<<"$event_continuation_block" \
   && grep -qF 'if [ ! -f scripts/workflow/approval-merge-continuation.sh ]; then' <<<"$event_continuation_block" \
   && grep -qF "APPROVAL_PROTECTIVE_RETRACTION_V2" <<<"$event_continuation_block" \
   && grep -qF 'AUTHOR_TOKEN: ${{ secrets.AUTHOR_MERGE_TOKEN }}' <<<"$event_continuation_block" \
   && grep -qF 'WORKFLOW_TOKEN: ${{ github.token }}' <<<"$event_continuation_block" \
   && grep -qF 'GH_TOKEN="$WORKFLOW_TOKEN" bash scripts/workflow/approval-merge-continuation.sh' <<<"$event_continuation_block" \
   && grep -qF 'elif [ "$protective_rc" -eq 0 ]; then' <<<"$event_continuation_block" \
   && grep -qF 'GH_TOKEN="$AUTHOR_TOKEN" MERGEPATH_PROTECTIVE_TOKEN="$WORKFLOW_TOKEN"' <<<"$event_continuation_block" \
   && grep -qF 'MERGEPATH_PROTECTIVE_RETRACTION_DONE=1' <<<"$event_continuation_block" \
   && [ -n "$event_protect_line" ] && [ -n "$event_no_author_line" ] && [ -n "$event_continue_line" ] \
   && [ "$event_protect_line" -lt "$event_no_author_line" ] \
   && [ "$event_no_author_line" -lt "$event_continue_line" ] \
   && grep -qF 'echo "CONTINUATION_INFRA_ERROR=$continuation_infra_error" >> "$GITHUB_ENV"' <<<"$scheduled_continuation_block" \
   && grep -qF 'echo "CONTINUATION_INFRA_ERROR_PRS=$(echo $continuation_failing_prs)" >> "$GITHUB_ENV"' <<<"$scheduled_continuation_block" \
   && grep -qF 'if [ ! -f scripts/workflow/approval-merge-continuation.sh ]; then' <<<"$scheduled_continuation_block" \
   && grep -qF "APPROVAL_PROTECTIVE_RETRACTION_V2" <<<"$scheduled_continuation_block" \
   && grep -qF 'AUTHOR_TOKEN: ${{ secrets.AUTHOR_MERGE_TOKEN }}' <<<"$scheduled_continuation_block" \
   && grep -qF 'WORKFLOW_TOKEN: ${{ github.token }}' <<<"$scheduled_continuation_block" \
   && grep -qF 'GH_TOKEN="$WORKFLOW_TOKEN" bash scripts/workflow/approval-merge-continuation.sh' <<<"$scheduled_continuation_block" \
   && grep -qF 'elif [ "$protective_rc" -eq 0 ]; then' <<<"$scheduled_continuation_block" \
   && grep -qF 'GH_TOKEN="$AUTHOR_TOKEN" MERGEPATH_PROTECTIVE_TOKEN="$WORKFLOW_TOKEN"' <<<"$scheduled_continuation_block" \
   && grep -qF 'MERGEPATH_PROTECTIVE_RETRACTION_DONE=1' <<<"$scheduled_continuation_block" \
   && [ -n "$scheduled_protect_line" ] && [ -n "$scheduled_no_author_line" ] && [ -n "$scheduled_continue_line" ] \
   && [ "$scheduled_protect_line" -lt "$scheduled_no_author_line" ] \
   && [ "$scheduled_no_author_line" -lt "$scheduled_continue_line" ]; then
  pass=$((pass + 1))
  echo "  PASS: both approval-continuation loops protect with github.token before author-token continuation and export a dedicated failure channel"
else
  fail=$((fail + 1))
  echo "  FAIL: each approval-continuation loop must guard the helper, run ordered workflow-token protection before author-token continuation, and export dedicated failure state" >&2
fi

continuation_surface_count=$(grep -cF 'name: Surface approval continuation failures as per-PR check-runs' "$WORKFLOW" || true)
if [ "$continuation_surface_count" -eq 2 ] \
   && [ "$(grep -cF "env.CONTINUATION_INFRA_ERROR == '1'" "$WORKFLOW")" -eq 2 ] \
   && [ "$(grep -cF 'report-approval-continuation-failures.sh' "$WORKFLOW")" -ge 4 ] \
   && ! grep -Fq -- '--json labels' "$ROOT/scripts/workflow/report-approval-continuation-failures.sh"; then
  pass=$((pass + 1))
  echo "  PASS: continuation failures use a separate non-healing per-PR diagnostic path"
else
  fail=$((fail + 1))
  echo "  FAIL: continuation failures must not share the label-removal healing channel" >&2
fi

reporter_tmp=$(mktemp -d "${TMPDIR:-/tmp}/continuation-reporter.XXXXXX")
mkdir -p "$reporter_tmp/bin"
cat > "$reporter_tmp/bin/gh" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$GH_STUB_LOG"
if [ "$1" = "pr" ] && [ "$2" = "view" ]; then
  printf '%s' abc123
  exit 0
fi
if [ "$1" = "api" ]; then
  exit 0
fi
exit 90
STUB
chmod +x "$reporter_tmp/bin/gh"
: > "$reporter_tmp/gh.log"
if PATH="$reporter_tmp/bin:$PATH" GH_STUB_LOG="$reporter_tmp/gh.log" GH_RETRY_ATTEMPTS=1 \
     bash "$CONTINUATION_REPORTER" owner/repo https://example.test/run/1 "7" >/dev/null \
   && grep -Fq 'api repos/owner/repo/check-runs' "$reporter_tmp/gh.log" \
   && grep -Fq 'head_sha=abc123' "$reporter_tmp/gh.log" \
   && grep -Fq 'conclusion=failure' "$reporter_tmp/gh.log" \
   && ! grep -Fq -- '--json labels' "$reporter_tmp/gh.log"; then
  pass=$((pass + 1))
  echo "  PASS: continuation reporter posts a failure without label-absence healing"
else
  fail=$((fail + 1))
  echo "  FAIL: continuation reporter must publish an unconditional head-pinned failure diagnostic" >&2
fi
rm -rf "$reporter_tmp"

# #730: the pull_request_target trigger must include `edited` so a body-edit
# nudge (the reliable re-fire for a claude-authored Phase-4 PR after a late
# Codex clearance) re-evaluates auto-clear on the PR head. Anchor to the
# pull_request_target types line specifically.
if awk '/^[[:space:]]+pull_request_target:/{f=1} f&&/types:/{print; exit}' "$WORKFLOW" | grep -qE '\bedited\b'; then
  pass=$((pass + 1))
  echo "  PASS: pull_request_target listens to 'edited' (#730 body-edit nudge)"
else
  fail=$((fail + 1))
  echo "  FAIL: pull_request_target missing 'edited' trigger (#730)" >&2
fi

# #730: the workflow_run resolver must fall back to head_sha when
# pull_requests[] is empty, else a Merge Clearance Gate success on the PR head
# resolves no PR and the label stays stuck.
if grep -qE 'workflow_run\.pull_requests empty; resolving open PRs by head_sha' "$WORKFLOW" && \
   grep -qE 'select\(\.headRefOid == \$sha\)' "$WORKFLOW"; then
  pass=$((pass + 1))
  echo "  PASS: workflow_run resolver falls back to head_sha when pull_requests[] is empty (#730)"
else
  fail=$((fail + 1))
  echo "  FAIL: workflow_run resolver missing the head_sha fallback (#730)" >&2
fi

# SECURITY: checkout MUST pin to default branch ref for
# pull_request_review safety. CR Critical on PR #202 r2 — without
# the explicit ref, a malicious PR could supply its own version of
# scripts/codex-review-check.sh and have it run with this workflow's
# pull-requests:write permissions.
if grep -qF "ref: \${{ github.event.repository.default_branch }}" "$WORKFLOW"; then
  pass=$((pass + 1))
  echo "  PASS: checkout pinned to default_branch (security: blocks PR-controlled gate-script execution)"
else
  fail=$((fail + 1))
  echo "  FAIL: checkout MUST pin ref to default_branch (CR Critical on #202 r2)" >&2
fi

# Least-privilege permissions: parse the permissions block and
# compare against the EXACT expected set, not a denylist. Codifies
# the expected permission shape so any drift (added scope, changed
# read↔write) is surfaced as a CI failure. CR Major on PR #202 r4
# (denylist approach was incomplete — missed artifact-metadata,
# repository-projects, vulnerability-alerts).
perm_block=$(
  awk '
    /^permissions:/ {in_block=1; next}
    in_block && /^[^[:space:]]/ {exit}
    # Skip blank lines AND comment-only lines so inline rationale
    # comments inside the permissions block don'"'"'t leak into the
    # allowlist comparison (CodeRabbit Major on PR #311 / #310).
    in_block && /^[[:space:]]*#/ {next}
    in_block && NF { sub(/^[[:space:]]+/, "", $0); print }
  ' "$WORKFLOW" | sort
)
# `actions: read` added in #310 — codex-review-check.sh's GraphQL
# drill into statusCheckRollup.checkSuite.workflowRun requires it
# in addition to the `checks` scope. See the inline rationale comment
# next to the permission in auto-clear-blocking-labels.yml.
# `checks: write` added in #324 — the "Surface infra failure as
# check-run" step posts a failed check-run when this workflow hits
# an infrastructure error, so flake recurrences are visible on the
# PR's checks tab without grepping workflow logs. It is the SINGLE
# `checks` entry: `write` supersets `read`, so a separate
# `checks: read` must NOT coexist with it. #324 shipped exactly that
# duplicate `checks:` map key; this text-based assertion happily
# matched both lines and stayed green, while GitHub's workflow parser
# rejected the duplicate-key file and every trigger produced a
# zero-job startup failure (the label never auto-cleared). The
# expected set below now codifies the single-key shape so re-adding
# `checks: read` fails this check instead of silently breaking the
# workflow at runtime.
# `issues: read` added in #431 — codex-review-check.sh reads
# /issues/{pr}/reactions (Codex 👍 clearance) and
# /issues/{pr}/timeline (force-push anchor). On restricted-default
# GITHUB_TOKEN repos an omitted scope is `none`, those reads 403,
# and the gate aborts rc=3 with `needs-external-review` stuck. Same
# class as the merge-clearance-gate.yml `issues: read` fix (#429).
# `security-events: read` added in #1101 (CodeRabbit on PR #1106) —
# scripts/workflow/approval-merge-continuation.sh's review-feedback-
# accounting.sh call (both evaluate-and-clear's and scheduled-sweep's
# "Continue approved PRs..." steps reach it) reads code-scanning/alerts
# to grade a github-advanced-security[bot] finding's severity. That
# call runs under ACCOUNTING_GH_TOKEN (this workflow's GITHUB_TOKEN),
# not the ambient AUTHOR_MERGE_TOKEN the continuation steps otherwise
# use, specifically so this permissions block can reach it.
expected_perms=$'actions: read\nchecks: write\ncontents: read\nissues: read\npull-requests: write\nsecurity-events: read'
if [ "$perm_block" = "$expected_perms" ]; then
  pass=$((pass + 1))
  echo "  PASS: workflow permissions exactly match the least-privilege set"
else
  fail=$((fail + 1))
  echo "  FAIL: workflow permissions drifted from expected least-privilege set" >&2
  echo "      expected:" >&2; echo "$expected_perms" | sed 's/^/        /' >&2
  echo "      got:" >&2; echo "$perm_block" | sed 's/^/        /' >&2
fi

# Issue #499: a successful label removal followed by an unreadable
# verification read must not leave a permanent failed synthetic
# `auto-clear-blocking-labels` check-run. The failure-surfacing step
# gets one last read before posting a check-run; if that read proves
# the label is already absent, it posts a success check-run with the
# same name to heal any prior synthetic failure. Both event-driven and
# scheduled-sweep surfaces need the same behavior.
heal_title_count=$(grep -c 'Auto-clear confirmed needs-external-review absent' "$WORKFLOW" || true)
heal_success_count=$(grep -c -- "-f conclusion='success'" "$WORKFLOW" || true)
heal_read_count=$(grep -c 'current_has_label=$(with_gh_retry gh pr view "$PR" --repo "$REPO" --json labels' "$WORKFLOW" || true)
valid_label_predicate_count=$(grep -Fc -- "--jq 'any(.labels[]?; .name == \"needs-external-review\")'" "$WORKFLOW" || true)
if [ "$heal_title_count" -ge 2 ] && [ "$heal_success_count" -ge 2 ] && [ "$heal_read_count" -ge 2 ] && [ "$valid_label_predicate_count" -ge 4 ]; then
  pass=$((pass + 1))
  echo "  PASS: infra-failure surfacing heals stale auto-clear check-runs when the label is already absent (#499)"
else
  fail=$((fail + 1))
  echo "  FAIL: infra-failure surfacing must re-read label state with a valid jq predicate and post success check-runs when the label is already absent (#499)" >&2
fi

# Sentinel: rc=3 from codex-review-check.sh sets had_infra_error and
# the job exits non-zero at the end. Without this, gate-evaluation
# infrastructure failures would silently leave the workflow green.
# CR Major on PR #202 r2.
# CR Major on PR #202 r5: anchored to start-of-line + word boundary
# so commented-out occurrences don't satisfy the assertion.
if grep -qE '^[[:space:]]*had_infra_error=1([[:space:]]|$)' "$WORKFLOW" && \
   grep -qE '^[[:space:]]*exit[[:space:]]+"?\$had_infra_error"?([[:space:]]|$)' "$WORKFLOW"; then
  pass=$((pass + 1))
  echo "  PASS: rc=3 sets infra-error sentinel + job exits non-zero on it (executable lines)"
else
  fail=$((fail + 1))
  echo "  FAIL: rc=3 from codex-review-check.sh must surface as job failure (sentinel + final exit)" >&2
fi

# ── Test 3: self-fire loop guard present
if grep -qE "github\.event\.action == 'unlabeled'" "$WORKFLOW" && \
   grep -qE "github\.event\.label\.name == 'needs-external-review'" "$WORKFLOW"; then
  pass=$((pass + 1))
  echo "  PASS: self-fire loop guard for unlabeled+needs-external-review present"
else
  fail=$((fail + 1))
  echo "  FAIL: self-fire loop guard missing or malformed" >&2
fi

# ── Test 4: scope discipline — only needs-external-review is removed
# CR Major on PR #202 r3: tighten the positive grep to the actual
# executable removal line, not anywhere in the file (header comments/
# attribution-message would otherwise satisfy the match even if the
# executable line regressed).
# #536 hardening: anchor with `^[^#]*` so a `#` appearing before the
# command disqualifies the line — a COMMENT that merely mentions the
# removal can no longer satisfy the positive check (nor can a
# commented-out forbidden-label removal trip the negatives, which would
# have caused a spurious FAIL). Indented executable lines inside `run:`
# blocks still match (no `#` precedes the command).
#
# #827: the removal moved from `gh pr edit --remove-label` to a REST
# DELETE on the issue-labels endpoint, so the positive assertion follows
# it. `gh pr edit --remove-label` is backed by the idempotent GraphQL
# removeLabelsFromLabelable mutation and exits 0 even when the label was
# never present — it cannot tell "this run removed the label" from "the
# label was already gone", which is the signal the attribution comment is
# gated on (see the duplicate-comment guard below). Both spellings stay
# refuted for the three forbidden labels, so a regression to either
# mechanism on a human-action label still fails this check.
if grep -qE '^[^#]*issues/\$PR/labels/needs-external-review' "$WORKFLOW" && \
   ! grep -qE '^[^#]*issues/\$PR/labels/needs-human-review' "$WORKFLOW" && \
   ! grep -qE '^[^#]*issues/\$PR/labels/policy-violation' "$WORKFLOW" && \
   ! grep -qE '^[^#]*issues/\$PR/labels/human-hold' "$WORKFLOW" && \
   ! grep -qE '^[^#]*gh pr edit[^#]*--remove-label needs-human-review([[:space:]]|$)' "$WORKFLOW" && \
   ! grep -qE '^[^#]*gh pr edit[^#]*--remove-label policy-violation([[:space:]]|$)' "$WORKFLOW" && \
   ! grep -qE '^[^#]*gh pr edit[^#]*--remove-label human-hold([[:space:]]|$)' "$WORKFLOW"; then
  pass=$((pass + 1))
  echo "  PASS: scope discipline — only needs-external-review is auto-removed (executable line)"
else
  fail=$((fail + 1))
  echo "  FAIL: workflow either misses the target label or auto-removes a forbidden one" >&2
fi

# ── Test 4b: duplicate-comment guard (#827)
# The attribution comment must be gated on THIS run having performed the
# removal — the DELETE's HTTP status — never on a bare "the label is
# absent" read. Absence is not attributable: this workflow carries no
# concurrency group (a per-PR one is not expressible for workflow_run,
# whose PR is resolved inside a step), so several runs pass the
# label-presence check, one write wins, and every one of them then reads
# "absent". On #797 that produced 15 attribution comments for 5 real
# removals. Both jobs must capture the status and branch on it.
del_capture_count=$(grep -cE '^[^#]*del_status=\$\(printf' "$WORKFLOW" || true)
del_branch_count=$(grep -cE '^[^#]*case "\$del_status" in' "$WORKFLOW" || true)
del_delete_count=$(grep -cE '^[^#]*-X DELETE -i --silent' "$WORKFLOW" || true)
if [ "$del_capture_count" -ge 2 ] && [ "$del_branch_count" -ge 2 ] && [ "$del_delete_count" -ge 2 ]; then
  pass=$((pass + 1))
  echo "  PASS: both jobs gate the attribution comment on the DELETE's HTTP status, not on label absence (#827)"
else
  fail=$((fail + 1))
  echo "  FAIL: attribution comment must be gated on the removal's HTTP status in BOTH jobs (#827): capture=$del_capture_count branch=$del_branch_count delete=$del_delete_count (expected >=2 each)" >&2
fi

# ── Test 4c: sweep re-verifies the label authoritatively (#827)
# The sweep's PR list comes from `gh pr list --label`, which resolves
# through the GraphQL search() API — an eventually-consistent index, not
# live label state. A cleared PR keeps appearing there (observed on #797:
# ~3.5h across 9 consecutive sweeps). Without an authoritative precheck
# the sweep burns a full codex-review-check.sh evaluation per stale hit
# and then comments on a label it never removed. Both jobs must carry the
# HAS_LABEL precheck.
haslabel_count=$(grep -cE '^[^#]*HAS_LABEL=\$\(with_gh_retry gh pr view' "$WORKFLOW" || true)
if [ "$haslabel_count" -ge 2 ] && grep -qF 'stale search-index hit' "$WORKFLOW"; then
  pass=$((pass + 1))
  echo "  PASS: both jobs re-verify needs-external-review authoritatively before acting (#827)"
else
  fail=$((fail + 1))
  echo "  FAIL: the scheduled sweep must re-verify the label against the authoritative endpoint before acting (#827; found $haslabel_count HAS_LABEL prechecks, expected >=2)" >&2
fi

# ── Test 4c: bash syntax check on every `run:` block
# Extract each `run: |` block to a temp file and feed to `bash -n`.
# Catches heredoc/subshell errors that only surface at runtime.
# Real bug from PR #202 r5: `gh pr comment ... --body "$(cat <<'COMMENT'
# ... COMMENT )"` had the closing `COMMENT` indented, which is
# invalid heredoc syntax — this test would have caught it pre-merge.
echo
echo "auto-clear-blocking-labels.yml bash syntax test"

block_dir=$(mktemp -d)
# awk extracts each `run: |` block to a separate file in $block_dir.
# Exit a run block when ANY non-empty line drops to indent <= base
# (the `run:` line's own indent), not just column-0. This catches
# job/step transitions like `  scheduled-sweep:` (under `jobs:`) and
# `      - name: Foo` (under steps:) which would otherwise be
# treated as continuations of the prior bash block.
awk -v outdir="$block_dir" '
  /^[[:space:]]+run:[[:space:]]+\|[[:space:]]*$/ {
    if (in_run) { close(outfile) }
    n++; outfile = outdir "/block-" n ".sh"
    match($0, /^[[:space:]]+/); base_indent = RLENGTH
    in_run = 1; next
  }
  in_run && NF == 0 { print > outfile; next }
  in_run {
    match($0, /^[[:space:]]*/); cur_indent = RLENGTH
    if (cur_indent <= base_indent) {
      close(outfile); in_run = 0; next
    }
    # Strip the YAML run-block indentation (base_indent + 2 spaces).
    sub("^[[:space:]]{" (base_indent + 2) "}", "")
    print > outfile
  }
  END { if (in_run) close(outfile) }
' "$WORKFLOW"

extracted_count=$(ls -1 "$block_dir" 2>/dev/null | wc -l | tr -d ' ')
syntax_errors=0
for f in "$block_dir"/block-*.sh; do
  [ -f "$f" ] || continue
  if ! err=$(bash -n "$f" 2>&1); then
    fail=$((fail + 1))
    syntax_errors=$((syntax_errors + 1))
    echo "  FAIL: bash syntax error in $(basename "$f")" >&2
    echo "$err" | sed 's/^/    /' >&2
  fi
done
rm -rf "$block_dir"

if [ "$syntax_errors" -eq 0 ] && [ "$extracted_count" -gt 0 ]; then
  pass=$((pass + 1))
  echo "  PASS: all $extracted_count run blocks have valid bash syntax"
elif [ "$extracted_count" = "0" ]; then
  fail=$((fail + 1))
  echo "  FAIL: extracted 0 run blocks (extraction logic broken?)" >&2
fi

# ── Test 5: PR-number resolution dispatch (extracted bash logic)
# The workflow embeds this dispatch as inline bash. Extract the logic
# pattern and exercise the three event shapes against canned
# github.event payloads.
echo
echo "auto-clear-blocking-labels.yml PR-number resolution tests"

# Stub `gh` for the #730 head_sha fallback below. GH_STUB_PRS is a JSON array
# of {number, headRefOid}; the stub returns it for `gh pr list --json ...`.
# Empty/unset ⇒ `[]` (models "no open PR matches", e.g. a main-branch sha).
gh() {
  if [ "${1:-}" = "pr" ] && [ "${2:-}" = "list" ]; then
    printf '%s' "${GH_STUB_PRS:-[]}"
    return 0
  fi
  echo "unexpected gh call in test: $*" >&2
  return 1
}

dispatch() {
  # Mirrors the workflow's case statement. Args: event_name,
  # event_json. Unsupported events return 0 (matching the workflow's
  # `exit 0  # don't fail; just skip` semantics — CR Minor on PR #202).
  local event_name="$1"
  local event_json="$2"
  case "$event_name" in
    pull_request_target|pull_request_review)
      jq -r '.pull_request.number' <<<"$event_json"
      ;;
    workflow_run)
      local conclusion prs
      conclusion=$(jq -r '.workflow_run.conclusion' <<<"$event_json")
      if [ "$conclusion" != "success" ]; then
        return 0  # workflow's "skip on non-success" path
      fi
      prs=$(jq -r '.workflow_run.pull_requests[].number' <<<"$event_json")
      # #730 head_sha fallback — mirrors the workflow's resolve step.
      if [ -z "$prs" ]; then
        local head_sha
        head_sha=$(jq -r '.workflow_run.head_sha // empty' <<<"$event_json")
        if [ -n "$head_sha" ]; then
          prs=$(gh pr list --repo x --state open --limit 500 --json number,headRefOid 2>/dev/null \
            | jq -r --arg sha "$head_sha" '.[] | select(.headRefOid == $sha) | .number' 2>/dev/null || true)
        fi
      fi
      printf '%s' "$prs"
      ;;
    *)
      echo "Unsupported event: $event_name" >&2
      return 0  # workflow exit 0 on unsupported (don't fail; just skip)
      ;;
  esac
}

# pull_request_target → 1 PR
out=$(dispatch pull_request_target '{"pull_request":{"number":42}}')
if [ "$out" = "42" ]; then
  pass=$((pass + 1))
  echo "  PASS: pull_request_target resolves to PR number"
else
  fail=$((fail + 1))
  echo "  FAIL: pull_request_target dispatch (got: $out)" >&2
fi

# pull_request_review → 1 PR
out=$(dispatch pull_request_review '{"pull_request":{"number":99}}')
if [ "$out" = "99" ]; then
  pass=$((pass + 1))
  echo "  PASS: pull_request_review resolves to PR number"
else
  fail=$((fail + 1))
  echo "  FAIL: pull_request_review dispatch (got: $out)" >&2
fi

# workflow_run success → multiple PRs
out=$(dispatch workflow_run '{"workflow_run":{"conclusion":"success","pull_requests":[{"number":7},{"number":8}]}}')
expected=$'7\n8'
if [ "$out" = "$expected" ]; then
  pass=$((pass + 1))
  echo "  PASS: workflow_run (success) enumerates multiple PRs"
else
  fail=$((fail + 1))
  echo "  FAIL: workflow_run (success) dispatch (got: $out)" >&2
fi

# workflow_run failure → empty (don't bother re-evaluating gate when
# the upstream workflow itself failed)
out=$(dispatch workflow_run '{"workflow_run":{"conclusion":"failure","pull_requests":[{"number":7}]}}')
if [ -z "$out" ]; then
  pass=$((pass + 1))
  echo "  PASS: workflow_run (failure conclusion) skips re-evaluation"
else
  fail=$((fail + 1))
  echo "  FAIL: workflow_run failure should produce empty (got: $out)" >&2
fi

# workflow_run with empty pull_requests AND no head_sha → empty (fallback
# skipped for lack of a SHA to match on)
out=$(dispatch workflow_run '{"workflow_run":{"conclusion":"success","pull_requests":[]}}')
if [ -z "$out" ]; then
  pass=$((pass + 1))
  echo "  PASS: workflow_run with no PRs and no head_sha produces empty output"
else
  fail=$((fail + 1))
  echo "  FAIL: workflow_run empty PRs (no head_sha) should yield empty (got: $out)" >&2
fi

# #730: empty pull_requests but head_sha matches an OPEN PR → resolves it via
# the fallback (the Merge-Clearance-Gate-success-on-PR-head case).
GH_STUB_PRS='[{"number":11,"headRefOid":"df809ae"},{"number":22,"headRefOid":"cafe00"}]'
out=$(dispatch workflow_run '{"workflow_run":{"conclusion":"success","pull_requests":[],"head_sha":"df809ae"}}')
if [ "$out" = "11" ]; then
  pass=$((pass + 1))
  echo "  PASS: #730 — empty pull_requests + matching head_sha resolves the PR via the fallback"
else
  fail=$((fail + 1))
  echo "  FAIL: #730 head_sha fallback should resolve PR 11 (got: $out)" >&2
fi

# #730: empty pull_requests + head_sha that matches NO open PR (a default-branch
# commit — the concurrent-main-merge case) → empty → correct no-op.
out=$(dispatch workflow_run '{"workflow_run":{"conclusion":"success","pull_requests":[],"head_sha":"4852bc74main"}}')
if [ -z "$out" ]; then
  pass=$((pass + 1))
  echo "  PASS: #730 — empty pull_requests + non-PR head_sha (main) yields empty (no-op)"
else
  fail=$((fail + 1))
  echo "  FAIL: #730 non-matching head_sha should yield empty (got: $out)" >&2
fi
unset GH_STUB_PRS

# Unsupported event → exit 0 with stderr message (matches workflow
# behavior; CR Minor on PR #202 r1 fixed the prior return-1 mismatch)
set +e
out=$(dispatch wat '{}' 2>&1)
rc=$?
set -e
if [ "$rc" = "0" ] && echo "$out" | grep -q "Unsupported event"; then
  pass=$((pass + 1))
  echo "  PASS: unsupported event returns 0 with clear stderr (matches workflow)"
else
  fail=$((fail + 1))
  echo "  FAIL: unsupported event handling (rc=$rc, out=$out)" >&2
fi

echo
if [ "$fail" -eq 0 ]; then
  if [ ! -f "$CONTINUATION_TEST" ]; then
    skip_reason="approval continuation test not present in this consumer checkout"
  elif ! bash "$CONTINUATION_TEST"; then
    echo "check_auto_clear_workflow: FAIL (approval continuation contract)" >&2
    exit 1
  fi
  if [ -n "$skip_reason" ]; then
    echo "check_auto_clear_workflow: SKIP ($skip_reason)"
  else
    echo "check_auto_clear_workflow: PASS ($pass tests)"
  fi
  exit 0
else
  echo "check_auto_clear_workflow: FAIL ($fail of $((pass + fail)) tests)" >&2
  exit 1
fi
