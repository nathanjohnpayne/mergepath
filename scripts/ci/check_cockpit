#!/usr/bin/env bash
# Cockpit is hub-only; the CI kit wrapper remains safe on every consumer.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"

# Marker FIRST: bootstrap residue never changes the consumer verdict.
if [ ! -f scripts/sync-to-downstream.sh ]; then
  echo "check_cockpit: SKIP (consumer checkout; Cockpit is hub-only)"
  exit 0
fi

# shellcheck source=../lib/ci-check-modes.sh
. "$ROOT/scripts/lib/ci-check-modes.sh"
if ! ci_check_select_mode "$@"; then
  echo "usage: check_cockpit [--check | --self-test]" >&2
  exit 2
fi
for subject in scripts/cockpit.sh tests/test_cockpit.sh tests/test_cockpit.py specs/cockpit_foundation.md \
  mergepath/cockpit/__main__.py mergepath/cockpit/server.py mergepath/cockpit/github.py \
  mergepath/cockpit/author_budget.py tests/test_cockpit_author_budget.py \
  mergepath/cockpit/inventory.py mergepath/cockpit/scheduler.py mergepath/cockpit/bootstrap.html \
  mergepath/cockpit/bootstrap.js mergepath/cockpit/index.html mergepath/cockpit/assets/cockpit.css \
  mergepath/cockpit/assets/components.js mergepath/cockpit/assets/app.js tests/test_cockpit_ui.cjs \
  mergepath/cockpit/assets/layout.js mergepath/cockpit/assets/layout.css tests/test_cockpit_layout_ui.cjs \
  mergepath/cockpit/actions.py mergepath/cockpit/assets/actions.js mergepath/cockpit/assets/actions.css \
  mergepath/cockpit/assets/actions_init.js tests/test_cockpit_actions.py tests/test_cockpit_actions_ui.cjs specs/cockpit_actions.md \
  mergepath/cockpit/ci.py \
  mergepath/cockpit/assets/ci.js \
  mergepath/cockpit/assets/ci.css \
  tests/test_cockpit_ci.py \
  tests/test_cockpit_ci_ui.cjs \
  tests/test_cockpit_logs.py \
  specs/cockpit_ci.md \
  mergepath/cockpit/prs.py \
  mergepath/cockpit/pr_settings.json \
  mergepath/cockpit/assets/prs.js \
  mergepath/cockpit/assets/pr_rows.js \
  mergepath/cockpit/assets/prs.css \
  tests/test_cockpit_prs.py \
  tests/test_cockpit_prs_ui.cjs \
  specs/cockpit_prs.md \
  mergepath/cockpit/fleet.py mergepath/cockpit/assets/fleet.js mergepath/cockpit/assets/fleet.css \
  tests/test_cockpit_fleet.py tests/test_cockpit_fleet_ui.cjs specs/cockpit_fleet.md \
  mergepath/cockpit/sync.py mergepath/cockpit/sync_worker.py mergepath/cockpit/assets/sync.js mergepath/cockpit/assets/sync.css \
  tests/test_cockpit_sync.py tests/test_cockpit_sync_ui.cjs specs/cockpit_sync.md \
  mergepath/cockpit/agents.py mergepath/cockpit/assets/agents.js mergepath/cockpit/assets/agents.css \
  tests/test_cockpit_agents.py tests/test_cockpit_agents_ui.cjs specs/cockpit_agents.md \
  mergepath/cockpit/live_agents.py mergepath/cockpit/assets/live_agents.js mergepath/cockpit/assets/live_agents.css \
  tests/test_cockpit_live_agents.py tests/test_cockpit_live_agents_ui.cjs specs/cockpit_live_agents.md \
  mergepath/cockpit/assets/fonts/local-fonts.css mergepath/cockpit/assets/fonts/manifest.json; do
  [ -f "$subject" ] || { echo "check_cockpit: missing $subject" >&2; exit 1; }
done
bash -n scripts/cockpit.sh tests/test_cockpit.sh
python3 - <<'PY'
import ast
from pathlib import Path
for subject in list(Path('mergepath/cockpit').glob('*.py')) + [Path('tests/test_cockpit.py'), Path('tests/test_cockpit_author_budget.py'), Path('tests/test_cockpit_ci.py'), Path('tests/test_cockpit_logs.py'), Path('tests/test_cockpit_prs.py'), Path('tests/test_cockpit_actions.py'), Path('tests/test_cockpit_agents.py'), Path('tests/test_cockpit_live_agents.py'), Path('tests/test_cockpit_fleet.py'), Path('tests/test_cockpit_sync.py')]:
    ast.parse(subject.read_text(), filename=str(subject))
PY
node --check mergepath/cockpit/bootstrap.js
node --check mergepath/cockpit/assets/components.js
node --check mergepath/cockpit/assets/app.js
node --check tests/test_cockpit_ui.cjs
node --check mergepath/cockpit/assets/layout.js
node --check tests/test_cockpit_layout_ui.cjs
node --check mergepath/cockpit/assets/actions.js
node --check mergepath/cockpit/assets/actions_init.js
node --check tests/test_cockpit_actions_ui.cjs
node --check mergepath/cockpit/assets/ci.js
node --check tests/test_cockpit_ci_ui.cjs
node --check mergepath/cockpit/assets/prs.js
node --check mergepath/cockpit/assets/pr_rows.js
node --check tests/test_cockpit_prs_ui.cjs
node --check mergepath/cockpit/assets/fleet.js
node --check tests/test_cockpit_fleet_ui.cjs
node --check mergepath/cockpit/assets/sync.js
node --check tests/test_cockpit_sync_ui.cjs
node --check mergepath/cockpit/assets/agents.js
node --check tests/test_cockpit_agents_ui.cjs
node --check mergepath/cockpit/assets/live_agents.js
node --check tests/test_cockpit_live_agents_ui.cjs
if [ "$CI_CHECK_RUN_SELF_TEST" -eq 1 ]; then
  bash tests/test_cockpit.sh
fi
echo "check_cockpit: PASS"
