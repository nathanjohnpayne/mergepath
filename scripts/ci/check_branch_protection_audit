#!/usr/bin/env bash
# scripts/ci/check_branch_protection_audit — branch-protection audit suite (#774).
#
# Wraps the two hermetic suites behind the fleet protection audit:
#
#   tests/test_audit_branch_protection.sh
#     scripts/audit-branch-protection.sh itself — the #285 auth/ruleset
#     semantics AND the #774 --fleet loop (exit-code classification,
#     hub inclusion, summary-file completeness, fail-closed prerequisites).
#     This suite existed unwired before #774; the scheduled workflow now
#     depends on the exit-code contract it pins, so it runs in CI.
#
#   tests/test_audit_branch_protection_workflow.sh
#     .github/workflows/branch-protection-audit.yml — structural shape plus
#     an execution of the workflow's own extracted bash (verdict
#     classification, missing-secret guard, rollup-issue body assembly).
#
# Both the audited script and the suites are HUB-ONLY (deliberately not in
# .mergepath-sync.yml): the fleet audit reads every consumer's branch
# protection from the hub, and no consumer runs it. The wrapper itself DOES
# ship (repo_lint.yml is manifest-canonical and wires it as a step), so it
# must SKIP cleanly on a consumer checkout.
#
# Consumer disambiguation keys ONLY on the hub marker
# scripts/sync-to-downstream.sh, and it is checked FIRST — before any
# wrapped-file requirement. The marker is the sole authoritative signal: it
# is deliberately never propagated and never seeded at bootstrap, so its
# absence means "consumer checkout" no matter what else is on disk.
#
# This is deliberately NOT the "wrapped test absent + marker absent" idiom
# check_wave_audit / check_audit_canonical_mirrors use (#624). That idiom
# treats the presence of a wrapped test as proof of a hub checkout, which is
# false for any consumer bootstrapped BEFORE the path joined
# BOOTSTRAP_MIRROR_EXCLUDES: the exclusion stops future seeding, it does not
# retroactively scrub the repos already carrying the file. nathanjohnpayne/
# gaycruisebingo is exactly that case — commit a2965a93 "Initial commit
# (bootstrapped from mergepath)" (2026-07-07) left it carrying
# scripts/audit-branch-protection.sh AND tests/test_audit_branch_protection.sh
# while it has neither the workflow, nor the second suite, nor the marker.
# Under the both-absent idiom that stale residue defeats the SKIP branch,
# control reaches the required-file loop, and the check hard-fails on the
# missing workflow — reddening repo_lint on every gaycruisebingo PR from the
# sync wave that delivers this wrapper onward. Marker-first is immune to
# residue in either direction and is strictly equivalent on the hub, where
# the marker is always present.
#
# Hub behavior is unchanged and still fail-closed: marker present → all four
# files are required, and any missing one is a hard error (the hub lost a
# suite to an accidental delete/rename).
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
AUDIT_SCRIPT="$REPO_ROOT/scripts/audit-branch-protection.sh"
WORKFLOW="$REPO_ROOT/.github/workflows/branch-protection-audit.yml"
TESTS=(
  "$REPO_ROOT/tests/test_audit_branch_protection.sh"
  "$REPO_ROOT/tests/test_audit_branch_protection_workflow.sh"
)

if [ ! -f "$REPO_ROOT/scripts/sync-to-downstream.sh" ]; then
  echo "check_branch_protection_audit: SKIP (consumer checkout: hub marker scripts/sync-to-downstream.sh absent; hub-only fleet protection audit)"
  exit 0
fi

for f in "$AUDIT_SCRIPT" "$WORKFLOW" "${TESTS[@]}"; do
  if [ ! -f "$f" ]; then
    echo "check_branch_protection_audit: ERROR missing required file: $f" >&2
    exit 1
  fi
done

# Both suites parse YAML with mikefarah/yq and fail closed without it.
# Self-bootstrap on CI (#616) so this check does not depend on where it
# lands relative to repo_lint.yml's yq install step; a local run keeps the
# suites' own "yq is required" error rather than getting a surprise install.
if [ -f "$REPO_ROOT/scripts/lib/ensure-yq.sh" ]; then
  bash "$REPO_ROOT/scripts/lib/ensure-yq.sh" --ci-only
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "check_branch_protection_audit: ERROR (jq is required — the wrapped suite would self-skip with exit 0 and report a green check over zero assertions)" >&2
  exit 1
fi

for t in "${TESTS[@]}"; do
  echo "check_branch_protection_audit: running $(basename "$t")"
  bash "$t"
done

echo "check_branch_protection_audit: PASS"
