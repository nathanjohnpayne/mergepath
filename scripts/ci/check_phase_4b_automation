#!/usr/bin/env bash
# check_phase_4b_automation
#
# Verifies the Phase 4b automated-review handoff package is present,
# executable, structurally sound, and passing its unit tests. The package
# automates REVIEW_POLICY.md § Phase 4b (design:
# plans/automated-phase-4b-handoff.md):
#
#   scripts/phase-4b-review.sh                      (orchestrator)
#   scripts/phase-4b/adapters/review-via-codex.sh   (Direction A: codex exec)
#   scripts/phase-4b/adapters/review-via-claude.sh  (Direction B: claude -p)
#   scripts/phase-4b/verdict.schema.json            (verdict contract)
#   scripts/phase-4b/lib.sh                          (shared, sourced)
#
# Fail-closed around tests/test_phase_4b_automation.sh: a missing test
# script is a hard error, not a silent skip (matches check_codex_scripts).

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
MODE_HELPER="$REPO_ROOT/scripts/lib/ci-check-modes.sh"
if [ ! -f "$MODE_HELPER" ]; then
  echo "check_phase_4b_automation: ERROR scripts/lib/ci-check-modes.sh missing" >&2
  exit 1
fi
# shellcheck source=../lib/ci-check-modes.sh
. "$MODE_HELPER"
if ! ci_check_select_mode "$@"; then
  echo "usage: check_phase_4b_automation [--check | --self-test]" >&2
  exit 2
fi

REQUIRED_EXEC=(
  "scripts/phase-4b-review.sh"
  "scripts/phase-4b/adapters/review-via-codex.sh"
  "scripts/phase-4b/adapters/review-via-claude.sh"
  "scripts/phase-4b/collect-enablement-evidence.sh"
  "scripts/phase-4b/immutable-input.sh"
)
REQUIRED_FILES=(
  "scripts/phase-4b/lib.sh"
  "scripts/phase-4b/escalation.cjs"
  "tests/test_phase_4b_escalation.cjs"
  "scripts/phase-4b/heartbeat.sh"
  "tests/test_phase_4b_heartbeat.sh"
  "tests/test_phase_4b_immutable_input.sh"
  "tests/test_phase_4b_round_cap.sh"
  "tests/test_coderabbit_wait_status_probe.sh"
  "tests/fixtures/coderabbit_status_refusal.json"
  "tests/fixtures/coderabbit_quota_refusal.json"
  "scripts/phase-4b/verdict.schema.json"
  "scripts/lib/codex-failure-markers.sh"
  "scripts/lib/gh-api-array.sh"
  "scripts/lib/p4b-review-provenance.sh"
)
TEST="tests/test_phase_4b_automation.sh"

FAILED=0

for rel in "${REQUIRED_EXEC[@]}"; do
  full="$REPO_ROOT/$rel"
  if [ ! -f "$full" ]; then
    echo "FAIL: missing required script: $rel"; FAILED=1; continue
  fi
  if [ ! -x "$full" ]; then
    echo "FAIL: script is not executable: $rel"
    echo "      Fix with: chmod +x $rel"; FAILED=1
  fi
done

for rel in "${REQUIRED_FILES[@]}"; do
  if [ ! -f "$REPO_ROOT/$rel" ]; then
    echo "FAIL: missing required file: $rel"; FAILED=1
  fi
done

# verdict.schema.json must be valid JSON (it is fed to `codex exec
# --output-schema`, and lib.sh's validator mirrors it).
if command -v jq >/dev/null 2>&1; then
  if [ -f "$REPO_ROOT/scripts/phase-4b/verdict.schema.json" ] \
     && ! jq -e . "$REPO_ROOT/scripts/phase-4b/verdict.schema.json" >/dev/null 2>&1; then
    echo "FAIL: scripts/phase-4b/verdict.schema.json is not valid JSON"; FAILED=1
  fi
else
  echo "WARN: jq not available — skipping schema JSON validation"
fi

# Optional static analysis: run shellcheck when present (CI has it).
# --severity=warning fails on warnings + errors but tolerates info/style
# (e.g. SC1091 unfollowed `source`, the intentional &&/|| test idiom). No
# -x, so we lint only these files and do not transitively re-lint repo libs.
#
# When shellcheck is ABSENT this used to skip silently (#588). It now routes
# through scripts/lib/lint-tooling.sh, which prints a loud WARN locally and, in
# CI (or with MERGEPATH_REQUIRE_SHELLCHECK=1), fails hard — so a runner that has
# lost shellcheck can no longer pass this check without linting.
LINT_TOOLING_LIB="$REPO_ROOT/scripts/lib/lint-tooling.sh"
if [ ! -f "$LINT_TOOLING_LIB" ]; then
  echo "FAIL: missing required library: scripts/lib/lint-tooling.sh"
  echo "check_phase_4b_automation: FAIL"
  exit 1
fi
# shellcheck source=../lib/lint-tooling.sh
. "$LINT_TOOLING_LIB"
if command -v shellcheck >/dev/null 2>&1; then
  if ! shellcheck --severity=warning \
      "$REPO_ROOT/scripts/phase-4b-review.sh" \
      "$REPO_ROOT/scripts/phase-4b/lib.sh" \
      "$REPO_ROOT/scripts/lib/codex-failure-markers.sh" \
      "$REPO_ROOT/scripts/phase-4b/adapters/review-via-codex.sh" \
      "$REPO_ROOT/scripts/phase-4b/adapters/review-via-claude.sh" \
      "$REPO_ROOT/scripts/phase-4b/collect-enablement-evidence.sh" \
      "$REPO_ROOT/tests/test_phase_4b_automation.sh" \
      "$REPO_ROOT/scripts/phase-4b/heartbeat.sh" \
      "$REPO_ROOT/scripts/phase-4b/immutable-input.sh" \
      "$REPO_ROOT/tests/test_phase_4b_immutable_input.sh" \
      "$REPO_ROOT/tests/test_phase_4b_heartbeat.sh"; then
    echo "FAIL: shellcheck reported warnings/errors in the phase-4b scripts"; FAILED=1
  fi
else
  lint_tooling_require_shellcheck || FAILED=1
fi

if [ "$FAILED" -eq 1 ]; then
  echo "check_phase_4b_automation: FAIL"
  exit 1
fi

if [ ! -f "$REPO_ROOT/$TEST" ]; then
  echo "FAIL: missing required test: $TEST (fail-closed — no silent skip)"
  echo "check_phase_4b_automation: FAIL"
  exit 1
fi

if [ "$CI_CHECK_RUN_SELF_TEST" -eq 0 ]; then
  echo "check_phase_4b_automation: PASS (live structure)"
  exit 0
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "check_phase_4b_automation: ERROR (jq is required — the wrapped suite would self-skip with exit 0 and report a green check over zero assertions)" >&2
  exit 1
fi

# p4b_self_test_supervise <command...>
# Runs one suite with stdin closed, its stdout and stderr merged and streamed,
# as the leader of its own process group. If the suite prints nothing for
# P4B_SELF_TEST_STALL_SECONDS (default 300), the supervisor reports the stall
# and the last line the suite printed (the last case that finished), kills the
# whole group (SIGTERM, then SIGKILL 2s later) and returns 124 (#3007). A
# stuck case used to run to the job's 60-minute timeout and print nothing.
# The longest gap between lines in a passing CI run is about 15s, so 300s is
# far outside normal pacing. A suite that finishes keeps its own exit status;
# group members it leaves behind are killed. Without perl the suite is not
# started at all (exit 1): an unsupervised suite is exactly the unbounded run
# this exists to prevent.
p4b_self_test_supervise() {
  local stall="${P4B_SELF_TEST_STALL_SECONDS:-300}"
  case "$stall" in ''|*[!0-9]*|0) stall=300 ;; esac
  if ! command -v perl >/dev/null 2>&1; then
    echo "check_phase_4b_automation: ERROR perl is required for the ${stall}s stall supervisor; not running unsupervised: $*" >&2
    return 1
  fi
  perl -e '
    use strict; use warnings; use POSIX (); use IO::Handle;
    my $stall = shift @ARGV;
    STDOUT->autoflush(1);
    pipe(my $r, my $w) or die "pipe: $!";
    my $pid = fork; defined $pid or die "fork: $!";
    if (!$pid) {
      POSIX::setpgid(0, 0);
      close $r;
      open STDIN, "<", "/dev/null"; open STDOUT, ">&", $w; open STDERR, ">&", $w;
      { no warnings "exec"; exec { $ARGV[0] } @ARGV; }
      print STDERR "cannot run $ARGV[0]: $!\n"; POSIX::_exit(127);
    }
    POSIX::setpgid($pid, $pid);
    # Ctrl-C or a TERM/HUP to this supervisor takes the suite group with it.
    for my $sig (qw(INT TERM HUP)) {
      $SIG{$sig} = sub {
        kill $sig, -$pid; kill "CONT", -$pid;
        sleep 2; kill "KILL", -$pid; waitpid($pid, 0);
        exit 128 + { INT => POSIX::SIGINT(), TERM => POSIX::SIGTERM(), HUP => POSIX::SIGHUP() }->{$sig};
      };
    }
    close $w;
    my ($buf, $last, $quiet, $st, $done_at, $eof) = ("", "", 0, undef, undef, 0);
    my $rin = ""; vec($rin, fileno($r), 1) = 1;
    while (1) {
      # After EOF (the suite may have closed its output and still be running)
      # keep the clock: sleep instead of reading, so the stall bound applies.
      my $n = 0;
      if ($eof) { select(undef, undef, undef, 1) }
      else { $n = select(my $rout = $rin, undef, undef, 1) }
      if ($n > 0) {
        my $got = sysread($r, my $chunk, 65536);
        if (!$got) { $eof = 1; next }
        print $chunk; $buf .= $chunk; $quiet = 0;
        my @l = grep { /\S/ } split /\n/, $buf;
        $last = $l[-1] if @l;
        $buf = substr($buf, rindex($buf, "\n") + 1) if index($buf, "\n") >= 0;
      } else {
        $quiet++;
      }
      if (!defined $st && waitpid($pid, POSIX::WNOHANG()) == $pid) { $st = $?; $done_at = time }
      # The suite exited but something it started still holds the pipe: give
      # it 5 wall-clock seconds, however much it keeps printing.
      last if defined $st && ($eof || time - $done_at >= 5);
      if (!defined $st && $quiet >= $stall) {
        print STDERR "check_phase_4b_automation: STALL: no output for ${stall}s from: @ARGV\n";
        print STDERR "check_phase_4b_automation: last line: \"$last\"\n";
        print STDERR "check_phase_4b_automation: killing the suite process group\n";
        kill "TERM", -$pid; kill "CONT", -$pid;
        sleep 2; kill "KILL", -$pid; waitpid($pid, 0);
        exit 124;
      }
    }
    if (!defined $st) { waitpid($pid, 0); $st = $? }
    kill "KILL", -$pid;
    exit(($st & 127) ? 128 + ($st & 127) : $st >> 8);
  ' "$stall" "$@"
}

echo "check_phase_4b_automation: running $TEST"
p4b_self_test_supervise node --test "$REPO_ROOT/tests/test_phase_4b_escalation.cjs"
p4b_self_test_supervise bash "$REPO_ROOT/$TEST" --rate-limit-only
p4b_self_test_supervise bash "$REPO_ROOT/tests/test_coderabbit_wait_status_probe.sh" --status-refusal-only
p4b_self_test_supervise bash "$REPO_ROOT/tests/test_coderabbit_wait_status_probe.sh" --marker-led-heading-only
p4b_self_test_supervise bash "$REPO_ROOT/tests/test_coderabbit_wait_status_probe.sh" --status-active-only
p4b_self_test_supervise bash "$REPO_ROOT/tests/test_coderabbit_wait_status_probe.sh" --phase4b-quota-only
p4b_self_test_supervise "$REPO_ROOT/$TEST"
p4b_self_test_supervise bash "$REPO_ROOT/$TEST" --heartbeat-only
p4b_self_test_supervise bash "$REPO_ROOT/tests/test_phase_4b_immutable_input.sh"
p4b_self_test_supervise bash "$REPO_ROOT/tests/test_phase_4b_round_cap.sh"

echo "check_phase_4b_automation: PASS"
exit 0
