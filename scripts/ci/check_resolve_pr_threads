  {"id":"T1","isResolved":false,"isOutdated":false,
   "commentsFirst":{"nodes":[{"author":{"login":"github-advanced-security"},"path":"src/foo.ts","body":"## CodeQL / Some rule","createdAt":"2026-01-01T00:00:00Z"}]},
