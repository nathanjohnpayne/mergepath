AUTH_JOB_JQ=$(printf '%s\n' "$AUTH_JOB_IF" | sed \
  -e 's|github\.workflow_ref == format( '\''{0}/\.github/workflows/merge-queue-authorization\.yml@refs/heads/main'\'', github\.repository)|.runtime_workflow_ref == (.repository_full_name + "/.github/workflows/merge-queue-authorization.yml@refs/heads/main")|' \
  -e 's/github\.event\.repository\./.repository./g' \
  -e 's/github\.event\.pull_request\./.pull_request./g' \
  -e 's/github\.event\.action/.action/g' \
  -e 's/github\.workflow_sha/.runtime_workflow_sha/g' \
  -e 's/github\.workflow_ref/.runtime_workflow_ref/g' \
  -e 's/github\.ref/.runtime_ref/g' \
  -e 's/github\.sha/.runtime_sha/g' \
  -e 's/github\.repository/.repository_full_name/g' \
  -e "s/'main'/\"main\"/g" \
  -e "s#'refs/heads/main'#\"refs/heads/main\"#g" \
  -e "s/'enqueued'/\"enqueued\"/g" \
  -e "s/'auto_merge_enabled'/\"auto_merge_enabled\"/g" \
