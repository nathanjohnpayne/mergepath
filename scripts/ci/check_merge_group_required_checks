#!/usr/bin/env bash
# CI and adversarial regression contract for #1058's merge-queue
# authorization and trusted merge_group bridge. The live issue acceptance
# keeps this suite in the existing scripts/ci wrapper rather than adding a
# separate tests/ surface.

set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
WORKFLOW_TEMPLATE="$ROOT/.github/templates/required-workflows/mergepath-merge-queue-authorization.yml"
AUTH_WORKFLOW="$ROOT/.github/workflows/merge-queue-authorization.yml"
FINAL_AUDIT_WORKFLOW="$ROOT/.github/workflows/merge-queue-final-audit.yml"
DEPENDABOT_WORKFLOW="$ROOT/.github/workflows/dependabot-auto-merge.yml"
SUBJECT="$ROOT/scripts/workflow/merge-group-required-checks.sh"
ADMISSION="$ROOT/scripts/workflow/merge-queue-required-admission.sh"
RECORDER="$ROOT/scripts/workflow/record-merge-queue-authorization.sh"
FINAL_AUDITOR="$ROOT/scripts/workflow/record-merge-queue-final-audit.sh"
FINAL_HANDSHAKE="$ROOT/.github/templates/required-workflows/scripts/merge-queue-final-handshake.sh"
ARM_POLICY="$ROOT/scripts/workflow/merge-queue-arm-policy.sh"
MATERIALIZER="$ROOT/scripts/build/materialize-merge-queue-policy-source.sh"
POLICY="$ROOT/.github/review-policy.yml"
SYNC_MANIFEST="$ROOT/.mergepath-sync.yml"
ROLLOUT_LIB="$ROOT/scripts/lib/merge-queue-protection.sh"
AUTH_LIB="$ROOT/scripts/lib/merge-queue-authorization.sh"

if [ -e "$ROOT/tests/test_merge_group_required_checks.sh" ]; then
  echo "FAIL: #1058 acceptance keeps behavioral coverage in this existing CI wrapper, not a new tests/ file" >&2
  exit 1
fi

for file in "$WORKFLOW_TEMPLATE" "$AUTH_WORKFLOW" "$FINAL_AUDIT_WORKFLOW" \
  "$DEPENDABOT_WORKFLOW" "$POLICY" "$SYNC_MANIFEST" "$ROLLOUT_LIB" \
  "$AUTH_LIB"; do
  [ -f "$file" ] || {
    echo "FAIL: required merge-queue surface is missing: $file" >&2
    exit 1
  }
done
for file in "$SUBJECT" "$ADMISSION" "$RECORDER" "$FINAL_AUDITOR" \
  "$FINAL_HANDSHAKE" "$ARM_POLICY" "$MATERIALIZER"; do
  [ -x "$file" ] || {
    echo "FAIL: required merge-queue executable is missing: $file" >&2
    exit 1
  }
done

for file in "$POLICY" "$ROLLOUT_LIB"; do
  if grep -qF 'merge_queue_promotion_head' "$file"; then
    echo "FAIL: rollout predeclares only the promotion PR; its head comes from the later author action: $file" >&2
    exit 1
  fi
  grep -qF 'merge_queue_promotion_pr' "$file" || {
    echo "FAIL: rollout lost its predeclared promotion PR selector: $file" >&2
    exit 1
  }
done

for fragment in \
  'pull_request:' \
  'merge_group:' \
  'actions: read' \
  'checks: read' \
  'contents: read' \
  'contents: write' \
  'issues: read' \
  'pull-requests: read' \
  'security-events: read' \
  'statuses: read' \
  'repository: ${{ github.repository }}' \
  'ref: ${{ github.event.pull_request.base.sha }}' \
  'ref: ${{ github.event.merge_group.base_sha }}' \
  'persist-credentials: false' \
  'path: trusted-base' \
  'Merge group pre-audit policy check' \
  'Source-pinned final audit handshake' \
  'Merge group post-audit policy check' \
  'GH_TOKEN: ${{ github.token }}' \
  'PR_NUMBER: ${{ github.event.pull_request.number }}' \
  'EVENT_HEAD_SHA: ${{ github.event.pull_request.head.sha }}' \
  'EVENT_HEAD_REF: ${{ github.event.pull_request.head.ref }}' \
  'EVENT_HEAD_REPOSITORY: ${{ github.event.pull_request.head.repo.full_name }}' \
  'WORKFLOW_REPOSITORY: ${{ job.workflow_repository }}' \
  'WORKFLOW_FILE_PATH: ${{ job.workflow_file_path }}' \
  'WORKFLOW_REF: ${{ job.workflow_ref }}' \
  'WORKFLOW_SHA: ${{ job.workflow_sha }}' \
  'RUN_ID: ${{ github.run_id }}' \
  'RUN_ATTEMPT: ${{ github.run_attempt }}' \
  '--workflow-repository "$WORKFLOW_REPOSITORY"' \
  '--workflow-file-path "$WORKFLOW_FILE_PATH"' \
  '--workflow-ref "$WORKFLOW_REF"' \
  '--workflow-sha "$WORKFLOW_SHA"' \
  '--run-id "$RUN_ID"' \
  '--run-attempt "$RUN_ATTEMPT"' \
  '--pr "$PR_NUMBER"' \
  '--head-sha "$EVENT_HEAD_SHA"' \
  '--head-ref "$EVENT_HEAD_REF"' \
  '--head-repo "$EVENT_HEAD_REPOSITORY"' \
  'scripts/workflow/merge-queue-required-admission.sh' \
  'scripts/workflow/merge-group-required-checks.sh' \
  'scripts/workflow/merge-queue-final-handshake.sh' \
  '--phase pre-audit' \
  '--phase post-audit' \
  'git init "$SOURCE_DIR"' \
  'https://github.com/$SOURCE_REPOSITORY.git' \
  '--no-tags --depth=1 origin "$SOURCE_SHA"' \
  'Label Gate' \
  'Self-Review Required' \
  'CodeRabbit unresolved blocking findings' \
  'Codex P1 unresolved threads' \
  'Merge clearance gate'; do
  grep -qF -- "$fragment" "$WORKFLOW_TEMPLATE" || {
    echo "FAIL: required-workflow template lost required fragment: $fragment" >&2
    exit 1
  }
done

for forbidden in \
  '${{ secrets.' \
  'AUTHOR_MERGE_TOKEN' \
  'OP_PREFLIGHT_AUTHOR_PAT' \
  'write-all' \
  'pull_request_target:' \
  'types:' \
  'push:' \
  'schedule:' \
  'repository_dispatch:' \
  'workflow_dispatch:' \
  'cancel-in-progress:' \
  'ref: ${{ github.event.pull_request.head.sha }}' \
  'ref: ${{ github.event.merge_group.head_sha }}' \
  'ref: ${{ github.sha }}' \
  'uses: ./' \
  'gh pr merge' \
  'gh pr update-branch' \
  'gh api --method' \
  'gh api -X'; do
  if grep -qF -- "$forbidden" "$WORKFLOW_TEMPLATE"; then
    echo "FAIL: inert required-workflow template contains forbidden authority or candidate code: $forbidden" >&2
    exit 1
  fi
done
if [ "$(grep -cF '      contents: write' "$WORKFLOW_TEMPLATE")" -ne 1 ]; then
  echo "FAIL: only the source-pinned handshake job may receive Contents write for repository_dispatch" >&2
  exit 1
fi
if [ "$(grep -cF 'uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1' \
    "$WORKFLOW_TEMPLATE")" -ne 3 ] \
    || [ "$(grep -cF 'repository: ${{ github.repository }}' \
      "$WORKFLOW_TEMPLATE")" -ne 3 ] \
    || [ "$(grep -cF 'path: trusted-base' "$WORKFLOW_TEMPLATE")" -ne 3 ]; then
  echo "FAIL: admission, precheck, and postcheck need exactly three pinned trusted-base checkouts" >&2
  exit 1
fi
if [ "$(grep -cF -- '--phase pre-audit' "$WORKFLOW_TEMPLATE")" -ne 1 ] \
    || [ "$(grep -cF -- '--phase post-audit' "$WORKFLOW_TEMPLATE")" -ne 1 ] \
    || [ "$(grep -cF 'scripts/workflow/merge-queue-final-handshake.sh' \
      "$WORKFLOW_TEMPLATE")" -ne 1 ]; then
  echo "FAIL: required template must run one precheck, one source handshake, and one postcheck" >&2
  exit 1
fi
if grep -qF 'request_nonce' "$WORKFLOW_TEMPLATE"; then
  echo "FAIL: the private final-audit nonce must never enter workflow YAML or expressions" >&2
  exit 1
fi
handshake_write_permissions=$(awk '
  /^  handshake:$/ { in_handshake=1; next }
  /^  [a-zA-Z0-9_-]+:$/ { in_handshake=0 }
  in_handshake && /^      contents: write$/ { count++ }
  END { print count+0 }
' "$WORKFLOW_TEMPLATE")
if [ "$handshake_write_permissions" -ne 1 ]; then
  echo "FAIL: Contents write must be scoped only to the source-pinned handshake job" >&2
  exit 1
fi

if [ "$(grep -cF 'gh api --method POST' "$FINAL_HANDSHAKE")" -ne 1 ] \
    || grep -Eq 'gh (pr|issue) (create|edit|comment|merge|review)' \
      "$FINAL_HANDSHAKE" \
    || grep -Eq 'gh api (-X|--method)[[:space:]]+(PATCH|PUT|DELETE)' \
      "$FINAL_HANDSHAKE"; then
  echo "FAIL: source handshake must own exactly one dispatch write and no other mutation" >&2
  exit 1
fi
for fragment in \
  'git -C "$SOURCE_ROOT" rev-parse --show-toplevel' \
  'git -C "$SOURCE_ROOT" rev-parse HEAD' \
  'git -C "$SOURCE_ROOT" remote get-url origin' \
  'repos/$REPO/dispatches' \
  'mergepath-final-queue-audit' \
  'could not derive the singleton queue check timeout'; do
  grep -qF -- "$fragment" "$FINAL_HANDSHAKE" || {
    echo "FAIL: source handshake lost a source/dispatch contract: $fragment" >&2
    exit 1
  }
done

command -v ruby >/dev/null 2>&1 || {
  echo "FAIL: Ruby is required for parser-backed workflow event inspection" >&2
  exit 1
}
ruby -e 'require "yaml"' >/dev/null 2>&1 || {
  echo "FAIL: Ruby YAML parser is unavailable" >&2
  exit 1
}

ruby - "$SYNC_MANIFEST" <<'RUBY' || exit 1
require "yaml"

manifest = YAML.safe_load(
  File.binread(ARGV.fetch(0)),
  permitted_classes: [],
  permitted_symbols: [],
  aliases: false,
  filename: ARGV.fetch(0)
)
paths = manifest.fetch("paths")
abort "FAIL: sync manifest paths are malformed" unless paths.is_a?(Array)

expected = {
  ".github/workflows/merge-queue-final-audit.yml" => [
    "scripts/workflow/record-merge-queue-final-audit.sh",
    "scripts/lib/merge-queue-authorization.sh",
    "scripts/lib/merge-queue-protection.sh",
    "scripts/lib/blocking-labels.sh",
    "scripts/lib/gh-api-array.sh",
    "scripts/lib/review-policy-scalar.sh",
    "scripts/gh-as-author.sh"
  ],
  "scripts/workflow/record-merge-queue-final-audit.sh" => [
    "scripts/lib/merge-queue-authorization.sh",
    "scripts/lib/merge-queue-protection.sh",
    "scripts/lib/blocking-labels.sh",
    "scripts/lib/gh-api-array.sh",
    "scripts/lib/review-policy-scalar.sh",
    "scripts/gh-as-author.sh"
  ]
}
expected.each do |path, requires|
  entries = paths.select { |entry| entry.is_a?(Hash) && entry["path"] == path }
  abort "FAIL: sync manifest needs exactly one explicit #{path} entry" unless entries.length == 1
  entry = entries.fetch(0)
  abort "FAIL: #{path} must be canonical for every consumer" unless
    entry["type"] == "canonical" && entry["consumers"] == "all"
  abort "FAIL: #{path} propagation closure is incomplete" unless
    Array(entry["requires"]).sort == requires.sort
end

workflow_kit = paths.find do |entry|
  entry.is_a?(Hash) && entry["path"] == "scripts/workflow/"
end
abort "FAIL: workflow kit lost the target final-auditor author wrapper" unless
  workflow_kit && Array(workflow_kit["requires"]).include?("scripts/gh-as-author.sh")

source_only = [
  ".github/templates/required-workflows/mergepath-merge-queue-authorization.yml",
  ".github/templates/required-workflows/scripts/merge-queue-final-handshake.sh",
  "scripts/build/materialize-merge-queue-policy-source.sh"
]
source_only.each do |source_path|
  propagated = paths.any? do |entry|
    next false unless entry.is_a?(Hash) && entry["path"].is_a?(String)
    manifest_path = entry["path"]
    manifest_path == source_path ||
      (manifest_path.end_with?("/") && source_path.start_with?(manifest_path))
  end
  abort "FAIL: policy-source-only artifact is on the consumer manifest: #{source_path}" if propagated
end
RUBY

# find_merge_group_workflows DIRECTORY
#
# Prints every YAML workflow whose top-level `on` value subscribes to
# merge_group. Psych implements YAML 1.1 and therefore decodes an unquoted
# `on` mapping key as boolean true; normalize that one parser representation
# before inspecting scalar, sequence, and mapping event forms.
find_merge_group_workflows() {
  [ "$#" -eq 1 ] || return 2
  ruby - "$1" <<'RUBY'
require "yaml"

root = ARGV.fetch(0)
unless File.directory?(root)
  warn "workflow directory is unavailable: #{root}"
  exit 2
end

matches = []
errors = []
paths = Dir.glob(File.join(root, "**", "*")).select do |path|
  File.file?(path) && [".yml", ".yaml"].include?(File.extname(path).downcase)
end

paths.sort.each do |path|
  begin
    document = YAML.safe_load(
      File.binread(path),
      permitted_classes: [],
      permitted_symbols: [],
      aliases: false,
      filename: path
    )
    unless document.is_a?(Hash)
      errors << "#{path}: workflow document root is not a mapping"
      next
    end
    if document.key?("on") && document.key?(true)
      errors << "#{path}: workflow contains ambiguous on keys"
      next
    end
    events = if document.key?("on")
               document["on"]
             elsif document.key?(true)
               document[true]
             end
    subscribed = case events
                 when String
                   events == "merge_group"
                 when Array
                   events.any? { |event| event == "merge_group" }
                 when Hash
                   events.keys.any? { |event| event == "merge_group" }
                 else
                   false
                 end
    matches << path if subscribed
  rescue Psych::Exception, SystemCallError => error
    errors << "#{path}: #{error.message}"
  end
end

unless errors.empty?
  warn errors.join("\n")
  exit 2
end
puts matches
RUBY
}

if ! target_merge_group_workflows=$(find_merge_group_workflows \
    "$ROOT/.github/workflows"); then
  echo "FAIL: target workflow YAML could not be inspected completely" >&2
  exit 1
fi
if [ -n "$target_merge_group_workflows" ]; then
  echo "FAIL: target repository must not carry an ordinary merge_group workflow:" >&2
  printf '%s\n' "$target_merge_group_workflows" >&2
  exit 1
fi
if [ -e "$ROOT/.github/workflows/mergepath-merge-queue-authorization.yml" ]; then
  echo "FAIL: required workflow must remain an inert template, not a target workflow" >&2
  exit 1
fi

for fragment in \
  'git -C "$ROOT" rev-parse --verify "$EVENT_HEAD_SHA^{commit}"' \
  'git -C "$ROOT" diff --quiet --no-ext-diff' \
  '"$EVENT_BASE_SHA" "$EVENT_HEAD_SHA" -- .github/workflows' \
  'candidate changes a target workflow' \
  'could not compare immutable base and head workflow trees'; do
  grep -qF -- "$fragment" "$ADMISSION" || {
    echo "FAIL: admission lost immutable workflow-tree proof: $fragment" >&2
    exit 1
  }
done

for fragment in \
  'pull_request_target:' \
  'types: [auto_merge_enabled, enqueued]' \
  'cancel-in-progress: false' \
  'environment: merge-queue-policy' \
  'ref: ${{ github.event.pull_request.base.sha }}' \
  'persist-credentials: false' \
  'GH_TOKEN: ${{ secrets.AUTHOR_MERGE_TOKEN }}' \
  'OP_PREFLIGHT_AUTHOR_PAT: ${{ secrets.AUTHOR_MERGE_TOKEN }}' \
  'MERGEPATH_MERGE_QUEUE_POLICY_TOKEN: ${{ secrets.MERGE_QUEUE_POLICY_TOKEN }}' \
  'MERGEPATH_MERGE_QUEUE_SOURCE_TOKEN: ${{ secrets.MERGE_QUEUE_SOURCE_TOKEN }}' \
  'EVENT_ACTION: ${{ github.event.action }}' \
  'RUNTIME_REF: ${{ github.ref }}' \
  'RUNTIME_SHA: ${{ github.sha }}' \
  'RUNTIME_WORKFLOW_REF: ${{ github.workflow_ref }}' \
  'RUNTIME_WORKFLOW_SHA: ${{ github.workflow_sha }}' \
  '--event-action "$EVENT_ACTION"' \
  '--runtime-ref "$RUNTIME_REF"' \
  '--runtime-sha "$RUNTIME_SHA"' \
  '--runtime-workflow-ref "$RUNTIME_WORKFLOW_REF"' \
  '--runtime-workflow-sha "$RUNTIME_WORKFLOW_SHA"' \
  'scripts/workflow/record-merge-queue-authorization.sh'; do
  grep -qF -- "$fragment" "$AUTH_WORKFLOW" || {
    echo "FAIL: queue-authorization workflow lost required fragment: $fragment" >&2
    exit 1
  }
done

AUTH_JOB_IF=$(awk '
  /^    if: >-$/ { capture=1; next }
  capture && /^    [^ ]/ { exit }
  capture {
    sub(/^[[:space:]]+/, "")
    if (length > 0) {
      if (seen) printf " "
      printf "%s", $0
      seen=1
    }
  }
' "$AUTH_WORKFLOW")
EXPECTED_AUTH_JOB_IF="github.event.repository.default_branch == 'main' && github.event.pull_request.base.repo.full_name == github.repository && github.event.pull_request.base.ref == github.event.repository.default_branch && github.ref == 'refs/heads/main' && github.sha == github.event.pull_request.base.sha && github.workflow_sha == github.event.pull_request.base.sha && github.workflow_ref == format( '{0}/.github/workflows/merge-queue-authorization.yml@refs/heads/main', github.repository) && github.event.pull_request.head.repo.full_name == github.repository && (github.event.action == 'enqueued' || (github.event.action == 'auto_merge_enabled' && github.event.pull_request.auto_merge.enabled_by.login == github.event.pull_request.user.login))"
if [ "$AUTH_JOB_IF" != "$EXPECTED_AUTH_JOB_IF" ]; then
  echo "FAIL: marker-writer job gate is not the exact trusted event-envelope predicate" >&2
  exit 1
fi

auth_job_line=$(grep -n '^  record:$' "$AUTH_WORKFLOW" \
  | head -1 | cut -d: -f1 || true)
auth_if_line=$(grep -n '^    if: >-$' "$AUTH_WORKFLOW" \
  | head -1 | cut -d: -f1 || true)
auth_runner_line=$(grep -n '^    runs-on:' "$AUTH_WORKFLOW" \
  | head -1 | cut -d: -f1 || true)
auth_checkout_line=$(grep -n 'uses: actions/checkout@' "$AUTH_WORKFLOW" \
  | head -1 | cut -d: -f1 || true)
auth_secret_line=$(grep -nF '${{ secrets.AUTHOR_MERGE_TOKEN }}' \
  "$AUTH_WORKFLOW" | head -1 | cut -d: -f1 || true)
if [ -z "$auth_job_line" ] || [ -z "$auth_if_line" ] \
    || [ -z "$auth_runner_line" ] || [ -z "$auth_checkout_line" ] \
    || [ -z "$auth_secret_line" ] \
    || [ "$auth_job_line" -ge "$auth_if_line" ] \
    || [ "$auth_if_line" -ge "$auth_runner_line" ] \
    || [ "$auth_if_line" -ge "$auth_checkout_line" ] \
    || [ "$auth_if_line" -ge "$auth_secret_line" ]; then
  echo "FAIL: marker-writer authority gate must be job-level and precede runner, checkout, and secret" >&2
  exit 1
fi

for fragment in \
  'repository_dispatch:' \
  'types: [mergepath-final-queue-audit]' \
  'actions: read' \
  'contents: read' \
  'cancel-in-progress: false' \
  'environment: merge-queue-policy' \
  'github.actor == '\''github-actions[bot]'\''' \
  'github.event.repository.default_branch == '\''main'\''' \
  'github.ref == '\''refs/heads/main'\''' \
  'github.sha == github.event.client_payload.request.base_sha' \
  'github.workflow_sha == github.event.client_payload.request.base_sha' \
  '.github/workflows/merge-queue-final-audit.yml@refs/heads/main' \
  'ref: ${{ steps.authenticate.outputs.base_sha }}' \
  'persist-credentials: false' \
  'GH_TOKEN: ${{ secrets.AUTHOR_MERGE_TOKEN }}' \
  'OP_PREFLIGHT_AUTHOR_PAT: ${{ secrets.AUTHOR_MERGE_TOKEN }}' \
  'MERGEPATH_MERGE_QUEUE_POLICY_TOKEN: ${{ secrets.MERGE_QUEUE_POLICY_TOKEN }}' \
  'MERGEPATH_MERGE_QUEUE_SOURCE_TOKEN: ${{ secrets.MERGE_QUEUE_SOURCE_TOKEN }}' \
  '.client_payload.request.request_nonce' \
  'echo "::add-mask::$REQUEST_NONCE"' \
  'canonical_positive_integer()' \
  'canonical_positive_integer "$PR_NUMBER"' \
  'canonical_positive_integer "$REQUESTER_RUN_ID"' \
  'canonical_positive_integer "$REQUESTER_RUN_ATTEMPT"' \
  'scripts/workflow/record-merge-queue-final-audit.sh'; do
  grep -qF -- "$fragment" "$FINAL_AUDIT_WORKFLOW" || {
    echo "FAIL: final-audit workflow lost required fragment: $fragment" >&2
    exit 1
  }
done

FINAL_AUDIT_JOB_IF=$(awk '
  /^    if: >-$/ { capture=1; next }
  capture && /^    [^ ]/ { exit }
  capture {
    sub(/^[[:space:]]+/, "")
    if (length > 0) {
      if (seen) printf " "
      printf "%s", $0
      seen=1
    }
  }
' "$FINAL_AUDIT_WORKFLOW")
EXPECTED_FINAL_AUDIT_JOB_IF="github.actor == 'github-actions[bot]' && github.event.action == 'mergepath-final-queue-audit' && github.event.repository.full_name == github.repository && github.event.repository.default_branch == 'main' && github.event.client_payload.request.repository == github.repository && github.event.client_payload.request.base_ref == 'main' && github.ref == 'refs/heads/main' && github.sha == github.event.client_payload.request.base_sha && github.workflow_sha == github.event.client_payload.request.base_sha && github.workflow_ref == format( '{0}/.github/workflows/merge-queue-final-audit.yml@refs/heads/main', github.repository)"
if [ "$FINAL_AUDIT_JOB_IF" != "$EXPECTED_FINAL_AUDIT_JOB_IF" ]; then
  echo "FAIL: final-audit job gate is not the exact trusted dispatch/base predicate" >&2
  exit 1
fi

final_job_line=$(grep -n '^  audit:$' "$FINAL_AUDIT_WORKFLOW" \
  | head -1 | cut -d: -f1 || true)
final_if_line=$(grep -n '^    if: >-$' "$FINAL_AUDIT_WORKFLOW" \
  | head -1 | cut -d: -f1 || true)
final_runner_line=$(grep -n '^    runs-on:' "$FINAL_AUDIT_WORKFLOW" \
  | head -1 | cut -d: -f1 || true)
final_environment_line=$(grep -n '^    environment: merge-queue-policy$' \
  "$FINAL_AUDIT_WORKFLOW" | head -1 | cut -d: -f1 || true)
final_checkout_line=$(grep -n 'uses: actions/checkout@' "$FINAL_AUDIT_WORKFLOW" \
  | head -1 | cut -d: -f1 || true)
final_secret_line=$(grep -nF '${{ secrets.AUTHOR_MERGE_TOKEN }}' \
  "$FINAL_AUDIT_WORKFLOW" | head -1 | cut -d: -f1 || true)
final_auth_step_line=$(grep -n 'name: Authenticate the request before selecting executable code' \
  "$FINAL_AUDIT_WORKFLOW" | head -1 | cut -d: -f1 || true)
if [ -z "$final_job_line" ] || [ -z "$final_if_line" ] \
    || [ -z "$final_runner_line" ] || [ -z "$final_environment_line" ] \
    || [ -z "$final_auth_step_line" ] || [ -z "$final_checkout_line" ] \
    || [ -z "$final_secret_line" ] \
    || [ "$final_job_line" -ge "$final_if_line" ] \
    || [ "$final_if_line" -ge "$final_runner_line" ] \
    || [ "$final_if_line" -ge "$final_environment_line" ] \
    || [ "$final_auth_step_line" -ge "$final_checkout_line" ] \
    || [ "$final_checkout_line" -ge "$final_secret_line" ]; then
  echo "FAIL: final-audit authority gate/authentication must precede environment code and secrets" >&2
  exit 1
fi

final_secret_names=$(grep -o '\${{ secrets\.[A-Z0-9_]* }}' \
  "$FINAL_AUDIT_WORKFLOW" | sed -e 's/^\${{ secrets\.//' -e 's/ }}$//' \
  | sort -u | tr '\n' ' ')
if [ "$final_secret_names" != \
    'AUTHOR_MERGE_TOKEN MERGE_QUEUE_POLICY_TOKEN MERGE_QUEUE_SOURCE_TOKEN ' ]; then
  echo "FAIL: final-audit workflow must reference exactly the three environment-only credentials" >&2
  exit 1
fi
if grep -qF 'github.event.client_payload.request.request_nonce' \
    "$FINAL_AUDIT_WORKFLOW" \
    || grep -qF 'REQUEST_NONCE:' "$FINAL_AUDIT_WORKFLOW" \
    || [ "$(grep -cF 'echo "::add-mask::$REQUEST_NONCE"' \
      "$FINAL_AUDIT_WORKFLOW")" -ne 2 ]; then
  echo "FAIL: final-audit request nonce must be read in-process and masked before use" >&2
  exit 1
fi

for forbidden in \
  'pull_request:' \
  'pull_request_target:' \
  'merge_group:' \
  'workflow_dispatch:' \
  'push:' \
