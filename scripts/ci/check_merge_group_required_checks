# Recorder regressions: disabled/out-of-scope events perform no write, and an
# exact marker found only on page two makes retries idempotent.
run_recorder() {
  set +e
  PATH="$TMP/integration-bin:$PATH" STUB_DIR="$TMP" GH_TOKEN=test-token \
    MERGEPATH_MERGE_QUEUE_POLICY_TOKEN=policy-token \
    MERGEPATH_MERGE_QUEUE_SOURCE_TOKEN=source-token \
    MERGEPATH_MERGE_QUEUE_ATTESTATION_ATTEMPTS="$ATTESTATION_ATTEMPTS_INPUT" \
    MERGEPATH_MERGE_QUEUE_ATTESTATION_INTERVAL_SECONDS="$ATTESTATION_INTERVAL_INPUT" \
    MERGEPATH_REPO_ROOT="$FIXTURE_ROOT" \
    bash "$FIXTURE_ROOT/scripts/workflow/record-merge-queue-authorization.sh" \
      --repo "$REPO" --event-action "$RECORDER_EVENT_ACTION" \
      --pr 7 --head-sha "$HEAD_SHA" --head-repo "$REPO" \
      --base-sha "$BASE_SHA" --base-ref main --enabled-by "$AUTHOR" \
      --pr-author "$AUTHOR" --default-branch main \
      --runtime-ref refs/heads/main --runtime-sha "$BASE_SHA" \
      --runtime-workflow-ref \
        "$REPO/.github/workflows/merge-queue-authorization.yml@refs/heads/main" \
      --runtime-workflow-sha "$BASE_SHA" \
      > "$TMP/recorder.out" 2>&1
  RECORDER_RC=$?
  set -e
}

