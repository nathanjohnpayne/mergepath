#!/usr/bin/env bash
# scripts/ci/check_sync_labels — run the fleet label-sync regression suite.
#
# Wraps tests/test_sync_labels.sh, the hermetic suite for
# scripts/sync-labels.sh, the fleet canonical-label reconcile: dry run writes
# nothing, apply creates missing active labels and fixes drifted colours and
# descriptions, deprecated labels are corrected only where present, labels
# outside the canonical list are never touched, and unreadable or malformed
# input fails closed. Both the script and the suite are HUB-ONLY
# (deliberately not in .mergepath-sync.yml), so a consumer checkout SKIPs
# through the same marker check as check_wave_audit: wrapped test absent and
# scripts/sync-to-downstream.sh absent means a consumer checkout, so SKIP;
# test absent but the hub marker present means the hub lost the suite, a
# hard error; test present means run it regardless of the marker.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
TEST_SCRIPT="$REPO_ROOT/tests/test_sync_labels.sh"

if [ ! -f "$TEST_SCRIPT" ]; then
  if [ ! -f "$REPO_ROOT/scripts/sync-to-downstream.sh" ]; then
    echo "check_sync_labels: SKIP (consumer checkout: wrapped test + scripts/sync-to-downstream.sh both absent; hub-only sync-labels suite)"
    exit 0
  fi
  echo "check_sync_labels: ERROR (missing $TEST_SCRIPT)" >&2
  exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "check_sync_labels: ERROR (jq is required — the wrapped suite would self-skip with exit 0 and report a green check over zero assertions)" >&2
  exit 1
fi

bash "$TEST_SCRIPT"
