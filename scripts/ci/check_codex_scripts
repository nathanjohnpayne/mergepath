#!/usr/bin/env bash
# check_codex_scripts
#
# Verifies that the Phase 4a Codex helper scripts are present and
# executable. All are required for `CLAUDE.md` step 8 Phase 4a to
# be able to run, and the review-request/check pair is referenced by
# the gh-pr-guard.sh hook and REVIEW_POLICY.md § Phase 4a. Missing a
# script breaks the automated external-review flow and silently drops
# callers to the Phase 4b manual CLI fallback.
#
# codex-record-feedback.sh (#487) is the Phase 4a feedback-loop helper
# that records the validated 👍/👎 reaction Codex solicits on each
# finding; it is required here so the bidirectional loop travels intact
# to every consumer.
#
# Enforces the `rules/repo_rules.md` § CI Enforcement entry for
# these scripts. See issue #38 and Project #2 for the broader
# context.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

REQUIRED_SCRIPTS=(
  "scripts/codex-review-request.sh"
  "scripts/codex-review-check.sh"
  "scripts/codex-record-feedback.sh"
)

FAILED=0

for rel in "${REQUIRED_SCRIPTS[@]}"; do
  full="$REPO_ROOT/$rel"
  if [[ ! -f "$full" ]]; then
    echo "FAIL: Missing required Codex helper script: $rel"
    FAILED=1
    continue
  fi
  if [[ ! -x "$full" ]]; then
    echo "FAIL: Codex helper script is not executable: $rel"
    echo "      Fix with: chmod +x $rel"
    FAILED=1
  fi
done

if [[ $FAILED -eq 1 ]]; then
  echo "check_codex_scripts: FAIL"
  exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "check_codex_scripts: ERROR (jq is required — the wrapped suites would self-skip with exit 0 and report a green check over zero assertions)" >&2
  exit 1
fi

# #2990: the suites below run through this pool, so prove its fail-closed
# contract before trusting their counts. A checkout behind the wave that
# delivers the pool runs them serially (below) and has nothing to prove here;
# the test itself stays required.
if [ ! -f "$REPO_ROOT/tests/test_case_pool.sh" ]; then
  echo "check_codex_scripts: ERROR (missing tests/test_case_pool.sh)" >&2
  exit 1
fi
if [ -f "$REPO_ROOT/tests/lib/case-pool.sh" ]; then
  echo "check_codex_scripts: running case-pool tests (#2990)"
  "$REPO_ROOT/tests/test_case_pool.sh"
fi

# Every suite below is one pool case (#2990): they share no state, so the pool
# runs them side by side and replays their output in this order. A failing or
# missing suite adds to FAIL. The long codex-review-request suites start first.
# The entry-decision, --trigger-only and ledger suites run in
# check_codex_review_request, pinned to another lint-fast shard: together the
# suites are CPU-bound past one leg's budget (#2990).
PASS=0
FAIL=0
# shellcheck disable=SC2329 # invoked through the SUITES entries
run_suite() { # <label> <rel> [<rel>...]
  local label=$1 rel
  shift
  echo "check_codex_scripts: running $label"
  for rel in "$@"; do
    if [ ! -f "$REPO_ROOT/$rel" ]; then
      echo "check_codex_scripts: ERROR (missing $rel)" >&2
      FAIL=$((FAIL + 1))
      return 0
    fi
    case "$rel" in
      *.py) python3 "$REPO_ROOT/$rel" ;;
      *) "$REPO_ROOT/$rel" ;;
    esac || { echo "check_codex_scripts: FAIL ($rel)" >&2; FAIL=$((FAIL + 1)); return 0; }
  done
}

# #1219: the gate (a) suite's #1215 publisher probe reads .github/workflows
# relative to the CWD, so a checkout carrying none of the five publisher
# workflows -- a freshly bootstrapped repo, a consumer behind the wave that
# delivered them, or any invocation not rooted at the repo root -- takes its
# skip branch. That branch increments a SKIP counter that was never
# initialized, so `set -u` aborted the suite mid-run: it reported failure and
# every assertion after the skip silently stopped running. Re-run it from a
# workflow-less CWD so the skip branch stays exercised rather than only the hub
# shape.
G1219_DIR="$(mktemp -d "${TMPDIR:-/tmp}/check-codex-scripts-1219.XXXXXX")"
# This file registers no other EXIT trap, so this one cannot replace an
# existing handler -- a second `trap ... EXIT` REPLACES rather than extends.
trap 'rm -rf "$G1219_DIR"' EXIT
# shellcheck disable=SC2329 # invoked through the SUITES entries
run_g1219() {
  echo "check_codex_scripts: re-running gate (a) suite in the no-publisher shape (#1219)"
  if ! ( cd "$G1219_DIR" && "$REPO_ROOT/tests/test_codex_review_check_required_checks.sh" ) \
       >"$G1219_DIR/suite.log" 2>&1; then
    echo "FAIL: gate (a) suite does not survive the no-publisher shape (#1219)" >&2
    tail -20 "$G1219_DIR/suite.log" >&2
    FAIL=$((FAIL + 1))
  fi
}

SUITES=(
  "--first run_suite 'codex-review-request ack tests' tests/test_codex_review_request_ack.sh"
  "--first run_suite 'blocked request evidence tests (#1276)' tests/test_codex_request_evidence.sh"
  "run_suite 'codex-review-request verdict-comment clearance tests (#609)' tests/test_codex_verdict_anchor_resolution.py tests/test_codex_review_request_verdict.sh"
  "run_suite 'codex-review-request write-token / keyring-fallback tests (#737)' tests/test_codex_review_request_token_fallback.sh"
  "run_suite 'codex-review-check gate (c) resolution tests' tests/test_codex_review_check_resolution.sh"
  "run_suite 'late Codex findings detector tests (#2881)' tests/test_late_codex_findings.sh"
  "run_suite 'codex-review-check verdict-comment clearance tests (#600)' tests/test_codex_review_check_verdict.sh"
  "run_suite 'codex-review-check gate (a) required-check scoping tests (#655)' tests/test_codex_review_check_required_checks.sh"
  "run_g1219"
  "run_suite 'branch-requirement resolver tests (#1064)' tests/test_branch_requirements.sh"
  "run_suite '#465 fail-closed structural guards' tests/test_465_fail_closed.sh"
  "run_suite '#655 repo-lint-local observation structural guards' tests/test_655_repo_lint_local_observed.sh"
  "run_suite 'codex-record-feedback tests' tests/test_codex_record_feedback.sh"
  "run_suite 'Codex usage-limit / not-connected marker detection tests (#722)' tests/test_codex_usage_limit_marker.sh"
)
# A checkout behind the wave that delivers the pool runs the same suites one
# after another: the skew costs time, never a suite.
if [ -f "$REPO_ROOT/tests/lib/case-pool.sh" ]; then
  # shellcheck source=tests/lib/case-pool.sh
  source "$REPO_ROOT/tests/lib/case-pool.sh"
  for suite in "${SUITES[@]}"; do
    eval "case_pool_add $suite"
  done
  case_pool_wait
else
  for suite in "${SUITES[@]}"; do
    eval "${suite#--first }"
  done
fi
if [ "$FAIL" -ne 0 ]; then
  echo "check_codex_scripts: FAIL ($FAIL suite(s))"
  exit 1
fi

echo "check_codex_scripts: PASS"
exit 0
