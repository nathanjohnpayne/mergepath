{
  "version": 1,
  "full_triggers": [
    ".github/workflows/repo_lint.yml",
    "scripts/ci/repo-lint-scope.sh",
    "scripts/ci/repo-lint-dependencies.json",
    "scripts/ci/check_repo_lint_consumer_safety",
    "scripts/ci/check_consumer_residue_safety",
    "tests/test_repo_lint_consumer_safety.sh",
    "tests/test_consumer_residue_safety.sh",
    "tests/test_repo_lint_optimization.sh",
    ".mergepath-sync.yml",
    ".repo-template.yml",
    "AGENTS.md",
    "REVIEW_POLICY.md",
    "ai_agent_tooling_standard.md",
    "specs/*",
    "rules/*",
    "docs/agents/*",
    "docs/architecture/*"
  ],
  "wrappers": {
    "check_no_token_in_output": [
      "scripts/ci/token_output_gate.py"
    ],
    "check_doc_ownership": [
      "scripts/lib/ci-check-modes.sh",
      "tests/test_check_doc_ownership.sh"
    ],
    "check_gh_as_author": [
      ".claude/settings.json",
      ".codex/hooks.json",
      ".github/workflows/agent-review.yml",
      ".github/workflows/pr-audit.yml",
      "scripts/hooks/gh-pr-guard.sh",
      "scripts/lib/pr-body-contract.mjs",
      "scripts/lib/pr-body-contract.sh",
      "scripts/lib/pr-body-contract.source.mjs",
      "scripts/lib/pr-body-contract.bundle/*",
      "tests/test_pr_body_contract_parity.sh"
    ],
    "check_auto_clear_workflow": [
      ".github/workflows/agent-review.yml",
      ".github/workflows/auto-clear-blocking-labels.yml",
      "scripts/lib/ci-check-modes.sh",
      "scripts/lib/blocking-labels.sh",
      "scripts/lib/gh-command-classifier.sh",
      "scripts/lib/gh-retry-helpers.sh",
      "scripts/lib/review-policy-scalar.sh",
      "scripts/workflow/approval-merge-continuation.sh",
      "scripts/workflow/report-approval-continuation-failures.sh",
      "tests/test_approval_merge_continuation.sh"
    ],
    "check_codex_scripts": [
      "scripts/lib/codex-request-evidence.sh",
      "tests/test_codex_request_evidence.sh"
    ],
    "check_coderabbit_wait": [
      "scripts/lib/ci-check-modes.sh",
      "scripts/coderabbit-wait.sh",
      "tests/test_coderabbit_wait_*.sh",
      "tests/test_coderabbit_automerge_rate_limit_gate.sh"
    ],
    "check_merge_clearance_gate": [
      "scripts/lib/ci-check-modes.sh",
      "scripts/lib/blocking-labels.sh",
      "scripts/merge-clearance-gate.sh",
      "tests/test_merge_clearance_gate.sh",
      "tests/test_465_fail_closed.sh"
    ],
    "check_required_check_publisher": [
      ".github/workflows/required-check-publisher.yml",
      "scripts/lib/ci-check-modes.sh",
      "tests/test_required_check_publisher_dedup.sh"
    ],
    "check_phase_4b_automation": [
      "scripts/lib/ci-check-modes.sh",
      "scripts/phase-4b-review.sh",
      "scripts/phase-4b/*",
      "scripts/lib/codex-failure-markers.sh",
      "scripts/lib/gh-api-array.sh",
      "tests/test_phase_4b_automation.sh"
    ],
    "check_phase_4b_accounting": [
      "scripts/lib/ci-check-modes.sh",
      "scripts/phase-4b-review.sh",
      "scripts/phase-4b/*",
      "scripts/phase-4b/accounting.sh",
      "scripts/phase-4b/accounting.schema.json",
      "scripts/phase-4b/prices.json",
      "tests/test_phase_4b_accounting.sh"
    ],
    "check_self_approval_detector": [
      ".github/workflows/agent-review.yml",
      "scripts/merge-clearance-gate.sh",
      "scripts/self-approval-detector.cjs",
      "scripts/render-self-approval-bootstrap.cjs",
      "scripts/workflow/approval-independence-check.sh",
      "scripts/workflow/approval-merge-continuation.sh",
      "scripts/lib/gh-api-array.sh",
      "scripts/lib/gh-command-classifier.sh",
      "scripts/lib/reviewers-helpers.sh",
      "scripts/lib/review-policy-scalar.sh",
      "scripts/lib/blocking-labels.sh",
      "tests/test_self_approval_detector.sh",
      "tests/test_approval_independence_check.sh",
      "tests/test_approval_merge_continuation.sh",
      "tests/test_merge_clearance_gate.sh"
    ],
    "check_pr_review_policy_nudge": [
      "scripts/pr-review-policy-nudge.sh",
      "tests/test_pr_review_policy_nudge.sh",
      "scripts/lib/ci-check-modes.sh",
      ".github/workflows/pr-review-policy.yml",
      "tests/test_label_gate_live_labels.sh"
    ]
  }
}
