#!/usr/bin/env bash
# scripts/ci/check_gh_as_author — CI entry point for #241 tests.
#
# Runs the unit tests for scripts/gh-as-author.sh AND for the
# identity-check addition to scripts/hooks/gh-pr-guard.sh. Both test
# files are under tests/; this wrapper runs them concurrently through
# tests/lib/case-pool.sh (#2990) and fails if any one fails. Hard-fails
# (exit 1, not skip) when either test script is missing, so an
# accidental delete/rename can't silently disable this check.
#
# Mirrors the pattern used by scripts/ci/check_sync_overrides.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

TESTS=(
  "tests/test_gh_as_author.sh"
  # The cross-consumer identity contract (#1121). Belongs with the wrapper and
  # guard suites because it tests the property NEITHER of them can: that every
  # consumer resolves Authoring-Agent to the SAME answer. Without a CI
  # entrypoint the guarantee regresses silently the moment someone reintroduces
  # a local regex, which is exactly how the divergence arose.
  "tests/test_pr_body_contract_parity.sh"
  "tests/test_gh_as_reviewer.sh"
  # The REST transport both wrappers take on a cloud surface, where every
  # `gh pr` / `gh issue` subcommand is GraphQL and the proxy refuses it
  # (#1057 item A, #1542): the closed argv grammar, each verb's REST calls,
  # and the byline readback that is the only call-time enforcement on Codex.
  "tests/test_gh_rest_transport.sh"
  "tests/test_gh_wrapper_parallel.sh"
  "tests/test_gh_pr_guard.sh"
  "tests/test_check_no_bare_gh_writes.sh"
  # Fail-closed helper guards at the identity-check / gh-as-author /
  # gh-as-reviewer call sites (#284), including that codex-review-request's
  # '@codex review' trigger is written through gh-as-author (#405). It had no
  # CI entrypoint, so it went red on main unnoticed after #1085 reshaped the
  # trigger write.
  "tests/test_identity_check_fail_closed.sh"
  # The checker every wrapper above runs before a write: its user-held
  # write-identity contract (#1057) and the bounded CI-app mode for thread
  # resolution, which must accept exactly one configured app and widen no
  # other mode (#2726). Propagated since #284 but never run in CI until then.
  "tests/test_identity_check.sh"
)

if ! command -v jq >/dev/null 2>&1; then
  echo "check_gh_as_author: ERROR (jq is required — the wrapped suites would self-skip with exit 0 and report a green check over zero assertions)" >&2
  exit 1
fi

# Each suite is one case: a failing or missing suite adds to FAIL, which is
# what the pool counts (#2990). The suites share no state, so the pool runs
# them side by side and replays their output in this order.
PASS=0
FAIL=0
# shellcheck disable=SC2329 # both runners are invoked through the SUITES entries
run_python_suite() { # <label> <rel>
  if ! python3 "$REPO_ROOT/$2"; then
    echo "check_gh_as_author: FAIL ($1)" >&2
    FAIL=$((FAIL + 1))
  fi
}
# shellcheck disable=SC2329
run_bash_suite() { # <rel>
  local full="$REPO_ROOT/$1"
  if [ ! -f "$full" ]; then
    echo "check_gh_as_author: ERROR (missing $1)" >&2
    FAIL=$((FAIL + 1))
    return 0
  fi
  echo "check_gh_as_author: running $1"
  if ! bash "$full"; then
    echo "check_gh_as_author: FAIL ($1)" >&2
    FAIL=$((FAIL + 1))
  fi
}
SUITES=(
  "run_python_suite 'owner admin override' tests/test_owner_admin_override.py"
  "run_python_suite 'comment trigger guard' tests/test_gh_comment_trigger_guard.py"
)
for rel in "${TESTS[@]}"; do
  SUITES+=("run_bash_suite $rel")
done
# A checkout behind the wave that delivers the pool runs the same suites one
# after another: the skew costs time, never a suite.
if [ -f "$REPO_ROOT/tests/lib/case-pool.sh" ]; then
  # shellcheck source=tests/lib/case-pool.sh
  source "$REPO_ROOT/tests/lib/case-pool.sh"
  for suite in "${SUITES[@]}"; do
    eval "case_pool_add $suite"
  done
  case_pool_wait
else
  for suite in "${SUITES[@]}"; do
    eval "$suite"
  done
fi
FAILED=0
[ "$FAIL" -eq 0 ] || FAILED=1

if [ "$FAILED" -ne 0 ]; then
  echo "check_gh_as_author: FAIL"
  exit 1
fi

echo "check_gh_as_author: PASS"
exit 0
