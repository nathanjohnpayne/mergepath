#!/usr/bin/env bash
# scripts/ci/check_external_review_helpers — run the external-review helper
# regression suite (#715, #716, #718; wired in #763).
#
# Wraps tests/test_external_review_gh_stderr.sh, the hermetic suite for
# scripts/workflow/external_review_fingerprint.sh and
# scripts/workflow/external_review_carryforward.sh: stdout/stderr separation on
# every gh call (#715/#716) and the affirmative current-head short circuit
# (#718).
#
# That suite was previously UNWIRED and had never run in CI — a real coverage
# gap, since these helpers gate whether external review is required at all.
# This wrapper closes it.
#
# jq is REQUIRED, not optional (CodeRabbit, #764): the wrapped suite skips
# itself with exit 0 when jq is absent, which this wrapper would otherwise
# report as a pass — a green check over zero executed assertions. Fail loudly
# instead; every CI runner in the fleet has jq.
#
# The suite is HUB-ONLY (deliberately not in .mergepath-sync.yml) even though
# the helpers it exercises are propagated under the scripts/workflow/ kit
# entry: it stubs `gh` wholesale and asserts mergepath's own review-policy
# semantics, which a consumer's repo_lint.yml does not wire. A consumer
# checkout therefore SKIPs, using the same marker disambiguation
# check_wave_audit / check_bootstrap_board_and_summary use (#624): wrapped test
# absent + scripts/sync-to-downstream.sh absent → consumer checkout → SKIP;
# test absent but the hub marker present → the hub lost the suite → hard error;
# test present → run it regardless of the marker.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
SUITES="
tests/test_external_review_gh_stderr.sh
tests/test_external_review_rename_protection.sh
tests/test_resolve_base_policy.sh
"

missing=""
for suite in $SUITES; do
  [ -f "$REPO_ROOT/$suite" ] || missing="$missing $suite"
done

if [ -n "$missing" ]; then
  if [ ! -f "$REPO_ROOT/scripts/sync-to-downstream.sh" ]; then
    echo "check_external_review_helpers: SKIP (consumer checkout: wrapped tests + scripts/sync-to-downstream.sh both absent; hub-only external-review suites)"
    exit 0
  fi
  echo "check_external_review_helpers: ERROR (missing:$missing)" >&2
  exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "check_external_review_helpers: ERROR (jq is required — the wrapped suite would self-skip with exit 0 and report a green check over zero assertions)" >&2
  exit 1
fi

for suite in $SUITES; do
  echo "── $suite"
  bash "$REPO_ROOT/$suite"
done
